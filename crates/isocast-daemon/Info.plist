<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Embedded in the isocastd binary (see build.rs) and used as the
     Info.plist of the development app bundle (scripts/sign-dev.sh), so macOS
     knows what it is and why it records: privacy permissions belong to
     Isocast itself, whichever terminal or agent starts it. -->
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>dev.isocast.isocastd</string>
	<key>CFBundleName</key>
	<string>Isocast</string>
	<key>CFBundleDisplayName</key>
	<string>Isocast</string>
	<key>CFBundleExecutable</key>
	<string>isocastd</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>LSBackgroundOnly</key>
	<true/>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<!-- Template fallback; Cargo and every packaging path stamp a build version. -->
	<key>CFBundleVersion</key><string>1</string>
	<key>NSSystemExtensionUsageDescription</key>
	<string>Isocast makes your selected picture available as a virtual camera in other apps.</string>
	<key>NSCameraUsageDescription</key>
	<string>Isocast records your cameras, capture cards and iPhone to files.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Isocast records your microphones to files.</string>
	<key>NSScreenCaptureUsageDescription</key>
	<string>Isocast captures the displays and windows you choose for your scenes.</string>
	<key>NSAudioCaptureUsageDescription</key>
	<string>Isocast captures the system or application audio you choose for your scenes.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Isocast streams to servers on your local network, such as an RTMP server on another computer.</string>
	<key>CFBundleIconFile</key>
	<string>Isocast</string>
	<key>CFBundleIconName</key>
	<string>Isocast</string>
</dict>
</plist>
