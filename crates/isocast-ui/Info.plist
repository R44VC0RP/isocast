<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>dev.isocast.app</string>
	<key>CFBundleName</key>
	<string>Isocast</string>
	<key>CFBundleDisplayName</key>
	<string>Isocast</string>
	<key>CFBundleExecutable</key>
	<string>isocast-ui</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.0.1</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>CFBundleIconFile</key>
	<string>Isocast</string>
	<key>CFBundleIconName</key>
	<string>Isocast</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.video</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSSupportsAutomaticGraphicsSwitching</key>
	<true/>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Isocast streams to servers on your local network, such as an RTMP server on another computer.</string>
	<!-- Remote engines: the engine advertises and the app browses this
	     DNS-SD type (docs/remote-engines.md, decision 11). -->
	<key>NSBonjourServices</key>
	<array>
		<string>_isocast._tcp</string>
	</array>
	<!-- Project files (#88): Isocast owns .isoprj (dev.isocast.project, a
	     JSON document), so the Finder opens them in Isocast. The icon is
	     the system's document page with the app icon as its badge. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Isocast Project</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>dev.isocast.project</string>
			</array>
		</dict>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>dev.isocast.project</string>
			<key>UTTypeDescription</key>
			<string>Isocast Project</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
			</array>
			<key>UTTypeIcons</key>
			<dict>
				<key>UTTypeIconBadgeName</key>
				<string>Isocast</string>
				<key>UTTypeIconText</key>
				<string>isoprj</string>
			</dict>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>isoprj</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>NSHumanReadableCopyright</key>
	<string>Isocast contributors. MIT OR Apache-2.0.</string>
</dict>
</plist>
