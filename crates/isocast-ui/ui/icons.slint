        if name == "tone" { return root.tone; }
        if name == "trash" { return root.trash; }
        if name == "undo" { return root.undo; }
        if name == "unlock" { return root.unlock; }
        if name == "wand" { return root.wand; }
        if name == "warning" { return root.warning; }
        if name == "window" { return root.window; }
        if name == "x" { return root.x; }
        return "";
    }
}

// An icon: `path` from `Icons`, `size` 12, 14, 16 or 20px.
export component Icon inherits Path {
    in property <string> path;
    in property <color> color: Theme.text-2;
    in property <length> size: Theme.icon;
    width: root.size;
    height: root.size;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: root.path;
    stroke: root.color;
    stroke-width: 1.5px;
    stroke-line-cap: round;
    stroke-line-join: round;
    fill: transparent;
    accessible-role: none;
}

// The brand mark ("Equal"), as in the app icon (bundle/Isocast.icon) on
// its 1024-unit canvas: a copper record dot and two round-capped bars,
// bone where they cross the dot and verdigris beyond it; `size` square,
// centred on the mark.
export component BrandMark inherits Rectangle {
    in property <length> size: 24px;
    width: root.size;
    height: root.size;
    accessible-role: none;

    Path {
        width: 100%;
        height: 100%;
        viewbox-x: 140;
        viewbox-y: 142;
        viewbox-width: 740;
        viewbox-height: 740;
        commands: "M200 512a200 200 0 1 0 400 0a200 200 0 1 0 -400 0";
        fill: Theme.copper;
    }
    Path {
        width: 100%;
        height: 100%;
        viewbox-x: 140;
        viewbox-y: 142;
        viewbox-width: 740;
        viewbox-height: 740;
        commands: "M332 426H580.57A200 200 0 0 1 598.79 490H332A32 32 0 0 1 332 426ZM332 534H598.79A200 200 0 0 1 580.57 598H332A32 32 0 0 1 332 534Z";
        fill: Theme.bone;
    }
    Path {
        width: 100%;
        height: 100%;
        viewbox-x: 140;
        viewbox-y: 142;
        viewbox-width: 740;
        viewbox-height: 740;
        commands: "M580.57 426H788A32 32 0 0 1 788 490H598.79A200 200 0 0 0 580.57 426ZM598.79 534H788A32 32 0 0 1 788 598H580.57A200 200 0 0 0 598.79 534Z";
        fill: Theme.verdigris;
    }
}
