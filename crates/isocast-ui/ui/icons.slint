// A path drawn as an SVG draws it: its box (`box-width` × `box-height`
// units) scaled evenly into the element and centred, the stroke straddling
// the outline. Slint fits a Path's viewbox into the element less the
// stroke (i-slint-core's `fitted_path_events`), so a stroked drawing came
// out smaller than Paper's (a 16px icon by 1.5px, ~10%); this widens the
// viewbox by the stroke's share to undo that. Set `width`, `height`,
// `commands` and the stroke as on a Path.
export component SvgPath inherits Path {
    in property <float> box-width: 24;
    in property <float> box-height: 24;
    // Units to px, and the stroke in px (as plain numbers).
    property <float> k: max(0.0001, min(self.width / 1px / root.box-width, self.height / 1px / root.box-height));
    property <float> s: self.stroke-width / 1px;
    viewbox-x: root.box-width / 2 - (self.width / 1px - root.s) / (2 * root.k);
    viewbox-y: root.box-height / 2 - (self.height / 1px - root.s) / (2 * root.k);
    viewbox-width: max(0.0001, (self.width / 1px - root.s) / root.k);
    viewbox-height: max(0.0001, (self.height / 1px - root.s) / root.k);
}

// An icon: `path` from `Icons`, `size` 12, 14, 16 or 20px.
export component Icon inherits SvgPath {
    in property <string> path;
    in property <color> color: Theme.text-2;
    in property <length> size: Theme.icon;
    width: root.size;
    height: root.size;
    commands: root.path;
    stroke: root.color;
    // Paper's 2.25 units (some icons there use 2 or 2.5: set it).
    stroke-width: root.size * 2.25 / 24;
    stroke-line-cap: round;
    stroke-line-join: round;
    fill: transparent;
    accessible-role: none;
}

// The brand mark ("Equal"), as in the app icon (bundle/Isocast.icon) on
// its 1024-unit canvas: a copper record dot and two round-capped bars,
// bone where they cross the dot and verdigris beyond it; `size` square,
// centred on the mark.
export component BrandMark inherits Rectangle {
    in property <length> size: 24px;
    width: root.size;
    height: root.size;
    accessible-role: none;

    Path {
        width: 100%;
        height: 100%;
        viewbox-x: 140;
        viewbox-y: 142;
        viewbox-width: 740;
        viewbox-height: 740;
        commands: "M200 512a200 200 0 1 0 400 0a200 200 0 1 0 -400 0";
        fill: Theme.copper;
    }
    Path {
        width: 100%;
        height: 100%;
        viewbox-x: 140;
        viewbox-y: 142;
        viewbox-width: 740;
        viewbox-height: 740;
        commands: "M332 426H580.57A200 200 0 0 1 598.79 490H332A32 32 0 0 1 332 426ZM332 534H598.79A200 200 0 0 1 580.57 598H332A32 32 0 0 1 332 534Z";
        fill: Theme.brand-bone;
    }
    Path {
        width: 100%;
        height: 100%;
        viewbox-x: 140;
        viewbox-y: 142;
        viewbox-width: 740;
        viewbox-height: 740;
        commands: "M580.57 426H788A32 32 0 0 1 788 490H598.79A200 200 0 0 0 580.57 426ZM598.79 534H788A32 32 0 0 1 788 598H580.57A200 200 0 0 0 598.79 534Z";
        fill: Theme.verdigris;
    }
}
