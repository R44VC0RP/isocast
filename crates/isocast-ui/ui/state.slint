// What the whole window shares: the connection, the open dialog, Studio
// Mode, the selection, and the per-viewer layout (dock sizes, what's
// shown). The app (src/app.rs) keeps it; every area reads it, and changes
// it through these callbacks so the app hears about it.
//
// Each area has a global of its own for its data (areas/*/state.slint);
// put things here only when more than one area needs them.

// An extra canvas (#120), for the canvas monitor's switcher.
export struct ExtraCanvas {
    id: string,
    label: string,
    width: int,
    height: int,
}

// mismatch and identity-changed: a remote engine (R2) that can't be
// controlled until it's updated or paired again.
export enum ConnectionState { connecting, connected, disconnected, failed, mismatch, identity-changed }

// Set once by App on both native and offscreen paths. Mac defaults preserve
// the existing kit/gallery too; these are labels, never key-binding values.
// `windows` is the app's machine (menus, shortcuts); `engine-windows` the
// engine's (docs/remote-engines.md decision 22: its Keychain or Credential
// Manager, Finder or Explorer, permissions, "this Mac" or "this PC"), the
// same as `windows` unless the window controls another computer's engine.
export global PlatformText {
    in property <bool> windows;
    in property <bool> engine-windows;
    // The engine runs Linux (`engine-windows` is set too): its own
    // permission words (portal, /dev/video*, PipeWire).
    in property <bool> engine-linux;
    // The engine machine's nouns, from Rust (`platform_text::Words`).
    in property <string> machine: "Mac";
    in property <string> credential-store: "Keychain";
    in property <string> file-manager: "Finder";
    out property <string> primary: root.windows ? "Ctrl+" : "⌘";
    out property <string> shift-primary: root.windows ? "Ctrl+Shift+" : "⇧⌘";
    out property <string> primary-key: root.windows ? "Ctrl" : "⌘";
}

export global Ui {
    // ---- The engine
    in property <ConnectionState> connection: ConnectionState.connecting;
    // Why it isn't connected (failed, disconnected).
    in property <string> connection-error;
    // A window on another computer's engine (R2): its name ("exon-desk"),
    // and under a version mismatch both versions, a line each. Empty and
    // false for this machine's own engine.
    in property <bool> engine-remote;
    in property <string> engine-name;
    in property <string> engine-versions;
    // The live setup has been read at least once.
    in property <bool> loaded;
    // The live setup exists (no setup: the Welcome screen).
    in property <bool> has-setup;
    in property <string> setup-name;
    in property <int> canvas-width: 1920;
    in property <int> canvas-height: 1080;
    in property <int> canvas-fps: 30;
    // The extra canvases (#86, #120): the setup has one, the chosen one
    // (its id, name and size; its monitor shown beside the others, View →
    // Canvas Monitor), the editor edits it (the canvas-* above are then
    // its), and every extra canvas, for the monitor's switcher.
    in property <bool> has-extra;
    in property <string> extra-id;
    in property <string> extra-label: "Vertical";
    in property <int> extra-width: 1080;
    in property <int> extra-height: 1920;
    in property <[ExtraCanvas]> extra-canvases;
    in-out property <bool> show-extra: true;
    // The extra canvas chosen for the monitor (its id; kept with the
    // window's layout).
    in-out property <string> extra-choice;
    in property <bool> editing-extra;
    // Which of two candidate layouts the canvas column uses (snapshots
    // choose between them, `--state vertical-layout:wide|compact`; not
    // saved): "wide" (up to 30% of the stage, as tall as the edited
    // monitor) or "compact" (up to 20%, at most 60% of its height).
    in-out property <string> extra-layout: "compact";
    // Streaming (the program's LIVE badge and its green ring; recording
    // alone keeps PGM and the 1px ring).
    in property <bool> live;

    // ---- Scenes: on air, in preview (Studio Mode), and the one whose
    // items are edited (the preview's in Studio Mode, else the one on air).
    in property <string> on-air-scene;
    in property <string> preview-scene;
    in property <string> editing-scene;
    in-out property <bool> studio;
    // The studio window maximized or full screen (Windows' Window menu
    // says Restore and Exit Full Screen then).
    in property <bool> window-maximized;
    in property <bool> window-fullscreen;

    // ---- The selected scene item (in `editing-scene`), by its key path
    // ("" for none). Areas select through `select`.
    in property <string> selected-item;
    // The selected item's source id ("" for a nested scene or none), its
    // name and kind label: for the source toolbar, Properties, Filters.
    in property <string> selected-source;
    in property <string> selected-name;
    in property <string> selected-kind;
    // Its icon, by name (`Icons.named`).
    in property <string> selected-icon;
    // What the engine says it is: "1920×1080 · 30p · Stereo" (the control
    // bar's line after the name; "" until it runs).
    in property <string> selected-meta;
    // With nothing selected: the scene being edited and how many items it
    // has ("Main · 4 sources").
    in property <string> scene-meta;

    // ---- One dialog at a time: its kind ("" for none) and what it is for
    // (a source id, a settings tab…). Kinds: create-source (arg: source
    // kind), properties, filters, rename (arg: source id), transform,
    // advanced-audio, transition (arg: transition kind), settings (arg:
    // tab), about. Areas show theirs with `if Ui.dialog == "…"`.
    in-out property <string> dialog;
    in-out property <string> dialog-arg;
    // The first run is showing over the window.
    in-out property <bool> onboarding;

    // ---- The layout (per viewer; the app keeps it between runs)
    // The source toolbar's parts of the control bar (the selected source
    // and its quick setting, Properties and Filters).
    in-out property <bool> show-source-toolbar: true;
    in-out property <bool> show-status-bar: true;
    // The dock row (the control bar's bottom pane toggle).
    in-out property <bool> show-docks: true;
    in-out property <bool> show-scenes: true;
    in-out property <bool> show-sources: true;
    in-out property <bool> show-mixer: true;
    in-out property <bool> show-transitions: true;
    in-out property <bool> show-controls: true;
    in-out property <bool> docks-locked;
    in-out property <bool> preview-locked;
    // "window" (as large as fits) or "canvas" (one canvas pixel to a
    // screen pixel).
    in-out property <string> preview-scale: "window";
    // Canvas snapping (Settings → General): edges and centres snap within
    // `snap-distance` screen points; ⌘ while dragging places freely.
    in-out property <bool> snap-enabled: true;
    in-out property <float> snap-distance: 8;
    // The preview's frame rate (Settings → General): "canvas" (the
    // canvas's, at most 60) or "30" (saves power; the canvas's while
    // working on it).
    in-out property <string> preview-rate: "canvas";
    // The dock row's height; 0 for the default (a third of the window,
    // 224 to 320px).
    in-out property <length> docks-height: 0px;
    // Widths of the docks with one (the mixer takes what's left).
    in-out property <length> scenes-width: 210px;
    in-out property <length> sources-width: 250px;
    in-out property <length> transitions-width: 200px;
    in-out property <length> controls-width: 200px;

    // ---- To the app
    // A menu command, from the menu bar or the keyboard (the ids are the
    // web app's: settings, studio_mode, new_scene, add_source, undo, redo,
    // transform_edit, rotate_cw, order_up, filters, properties,
    // lock_preview, advanced_audio, source_toolbar, reset_ui, dock_scenes…).
    callback menu(string);
    // Select an item of the scene being edited ("" for none).
    callback select(string);
    // Open a dialog (kind, arg) or close the open one.
    callback open-dialog(string, string);
    callback close-dialog();
    // Studio Mode on or off.
    callback set-studio(bool);
    // The layout changed (keep it).
    callback layout-changed();
    // Leave the app.
    callback quit();
}
