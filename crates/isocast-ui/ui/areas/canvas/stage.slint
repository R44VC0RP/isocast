// The preview area at the top of the window (Paper "C. Console", Main
// window and Studio Mode boards): Final Cut's viewer. Above the picture
// the viewer line: the canvas's format on the left, the scene's name in
// the middle, the zoom ("Fit 51% ⌄") and View menus on the right; under
// it the canvas letterboxed on the stage, 8px clear of the window's sides
// and the control bar. In Studio Mode it splits into Preview (left,
// edited) and Program (right), each with its own viewer line (a PREVIEW
// or PROGRAM tag and the scene's name), and the studio column (area C)
// between them, as in OBS.

import { Theme } from "../../theme.slint";
import { Ui } from "../../state.slint";
import { Menus, Tag, TagTone, TextMenuButton } from "../../kit.slint";
import { CanvasArea } from "state.slint";
import { Monitor } from "monitor.slint";
import { StudioColumn } from "../controls/studio.slint";

// The canvas's format: "1920×1080 · 30p".
global Format {
    out property <string> canvas: Ui.canvas-width + "×" + Ui.canvas-height + " · " + Ui.canvas-fps + "p";
}

// A viewer line's small text (11px `text-3`).
component LineText inherits Text {
    color: Theme.text-3;
    font-size: Theme.fs-xs;
    letter-spacing: Theme.tracking-xs;
    vertical-alignment: center;
    accessible-role: none;
}

// The main viewer line (Paper: 28px on the stage, 14px in): the format,
// the scene centred on the window, the zoom and View menus. Before there
// is a setup: "No format", "No scene" and "Fit", faded (Paper's Welcome
// board).
component ViewerLine inherits Rectangle {
    // The picture's scale, in screen pixels per canvas pixel.
    in property <float> zoom;

    height: Theme.statusbar;
    accessible-role: groupbox;
    accessible-label: "Viewer";

    if !Ui.has-setup: HorizontalLayout {
        padding-left: Theme.pane-x;
        padding-right: Theme.pane-x;
        // Equal sides (Paper's flex-basis 0), so the middle is centred.
        LineText {
            horizontal-stretch: 1;
            min-width: 0px;
            preferred-width: 0px;
            text: "No format";
            color: Theme.text-disabled;
        }
        Text {
            text: "No scene";
            color: Theme.text-3;
            font-size: Theme.fs-sm;
            font-weight: Theme.weight-medium;
            letter-spacing: Theme.tracking-sm;
            vertical-alignment: center;
            accessible-role: none;
        }
        LineText {
            horizontal-stretch: 1;
            min-width: 0px;
            preferred-width: 0px;
            text: "Fit";
            color: Theme.text-disabled;
            horizontal-alignment: right;
        }
    }

    if Ui.has-setup: LineText {
        x: Theme.pane-x;
        y: (parent.height - self.height) / 2;
        height: Theme.lh-xs;
        width: min(Theme.viewer-side, max(0px, (parent.width - name.width) / 2 - Theme.pane-x - Theme.space-2));
        text: Format.canvas + " · Rec. 709";
        overflow: elide;
        accessible-role: AccessibleRole.text;
        accessible-label: "Canvas";
        accessible-value: self.text;
    }
    name := Text {
        visible: Ui.has-setup;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(self.preferred-width, parent.width / 3);
        height: Theme.lh-sm;
        text: CanvasArea.program-name;
        color: Theme.text;
        font-size: Theme.fs-sm;
        font-weight: Theme.weight-semibold;
        letter-spacing: Theme.tracking-sm;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: AccessibleRole.text;
        accessible-label: "Scene";
        accessible-value: self.text;
    }
    if Ui.has-setup: HorizontalLayout {
        x: parent.width - Theme.pane-x - self.width;
        width: self.preferred-width;
        spacing: Theme.line-gap;
        VerticalLayout {
            alignment: center;
            scale := TextMenuButton {
                text: Ui.preview-scale == "canvas" ? "Canvas" : "Fit";
                value: round(root.zoom * 100) + "%";
                menu-open: Menus.open && Menus.owner == "viewer:scale";
                clicked => { Menus.request("viewer:scale", self.absolute-position.x, self.absolute-position.y, self.width, self.height); }
            }
        }
        VerticalLayout {
            alignment: center;
            TextMenuButton {
                text: "View";
                menu-open: Menus.open && Menus.owner == "viewer:view";
                clicked => { Menus.request("viewer:view", self.absolute-position.x, self.absolute-position.y, self.width, self.height); }
            }
        }
    }
}

// A Studio Mode monitor's viewer line (Paper: 28px, 2px in): its tag
// (PREVIEW yellow, PROGRAM green) and the scene's name, and on the right
// what it shows at (the zoom, or the format).
component MonitorHead inherits Rectangle {
    in property <string> tag;
    in property <TagTone> tone;
    in property <string> name;
    // On the right: a word and a Martian Mono value ("Fit" "41%"), or a
    // word alone (the format).
    in property <string> info;
    in property <string> info-value;

    height: Theme.statusbar;
    accessible-role: groupbox;
    accessible-label: root.tag + " " + root.name;

    HorizontalLayout {
        padding-left: 2px;
        padding-right: 2px;
        spacing: Theme.space-2;
        Tag {
            text: root.tag;
            tone: root.tone;
        }
        Text {
            horizontal-stretch: 1;
            text: root.name;
            color: Theme.text;
            font-size: Theme.fs-sm;
            font-weight: Theme.weight-medium;
            letter-spacing: Theme.tracking-sm;
            vertical-alignment: center;
            overflow: elide;
        }
        HorizontalLayout {
            spacing: Theme.space-1;
            LineText {
                text: root.info;
            }
            if root.info-value != "": LineText {
                text: root.info-value;
                font-family: Theme.font-mono;
                font-weight: Theme.weight-light;
            }
        }
    }
}

export component Stage inherits Rectangle {
    // The edited monitor (the only one, or Studio Mode's preview), in
    // window coordinates (see Monitor).
    out property <length> area-x: editor.area-x;
    out property <length> area-y: editor.area-y;
    out property <length> area-width: editor.area-width;
    out property <length> area-height: editor.area-height;
    out property <length> picture-left: editor.picture-left;
    out property <length> picture-top: editor.picture-top;
    out property <length> picture-right: editor.picture-right;
    out property <length> picture-width: editor.picture-width;
    out property <length> picture-height: editor.picture-height;
    out property <int> picture-pixel-width: editor.picture-pixel-width;
    out property <int> picture-pixel-height: editor.picture-pixel-height;
    out property <float> scale: editor.scale;
    out property <bool> dragging: editor.dragging;
    out property <length> box-left: editor.box-left;
    out property <length> box-top: editor.box-top;
    out property <length> box-width: editor.box-width;
    out property <length> box-height: editor.box-height;
    // Studio Mode's program picture.
    out property <length> program-x: program.picture-left;
    out property <length> program-y: program.picture-top;
    out property <length> program-width: Ui.studio ? program.picture-width : 0;
    out property <length> program-height: Ui.studio ? program.picture-height : 0;
    out property <int> program-pixel-width: program.picture-pixel-width;
    out property <int> program-pixel-height: program.picture-pixel-height;
    // The whole stage (the native layers' area).
    out property <length> stage-x: root.absolute-position.x;
    out property <length> stage-y: root.absolute-position.y;
    out property <length> stage-width: root.width;
    out property <length> stage-height: root.height;

    property <length> pad: Theme.space-2;
    property <length> column: Theme.studio-column;
    // A viewer line (Paper: 28px, the status bar's height).
    property <length> head: Theme.statusbar;
    property <bool> actual: Ui.preview-scale == "canvas";
    property <float> aspect: max(1, Ui.canvas-width) / max(1, Ui.canvas-height);
    // Studio Mode: each side's picture, as large as fits (or one canvas
    // pixel to a screen pixel).
    property <length> side: max(0px, (root.width - 2 * root.pad - root.column - 2 * root.pad) / 2);
    property <length> pic-w: root.actual ? max(1, Ui.canvas-width) * 1phx : min(root.side, max(0px, root.height - 2 * root.pad - root.head) * root.aspect);
    property <length> pic-h: root.pic-w / root.aspect;
    property <length> slot-y: (root.height - root.head - root.pic-h) / 2;

    // Under native pictures the layers paint the stage (src/layers.rs).
    background: CanvasArea.native-picture ? transparent : Theme.surface-stage;
    clip: true;

    // A right click anywhere on the stage off the items: the preview's
    // menu (Preview Scaling, Add, Paste; area A builds it).
    TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.up && event.button == PointerEventButton.right {
                Menus.request("canvas", self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, 0, 0);
            }
        }
    }

    // The main viewer line: a layer of its own (its words and chevrons
    // would otherwise be drawn again for every meter step).
    // Kept made and hidden in Studio Mode: a cached layer made again can
    // show the old one's picture (see app.slint, cache-docks).
    ViewerLine {
        cache-rendering-hint: true;
        visible: !Ui.studio;
        y: 0;
        width: root.width;
        zoom: editor.scale * 1px / 1phx;
    }

    // The edited monitor: under the viewer line, 8px clear of the sides
    // and the control bar (its 1px ring inside that), or Studio Mode's
    // left side.
    editor := Monitor {
        x: Ui.studio ? root.pad + (root.side - root.pic-w) : root.pad;
        y: Ui.studio ? root.slot-y + root.head : root.head;
        width: Ui.studio ? root.pic-w : max(0px, root.width - 2 * root.pad);
        height: Ui.studio ? root.pic-h : max(0px, root.height - root.head - root.pad);
        pad: Ui.studio ? 0 : 1px;
        actual-size: root.actual;
        editor: true;
        picture: CanvasArea.picture;
        program-live: !Ui.studio && Ui.live;
        empty-text: CanvasArea.empty-text;
        waiting: CanvasArea.waiting;
        error-text: CanvasArea.picture-error;
    }

    program := Monitor {
        visible: Ui.studio;
        x: root.width - root.pad - root.side;
        y: root.slot-y + root.head;
        width: Ui.studio ? root.pic-w : 0;
        height: Ui.studio ? root.pic-h : 0;
        actual-size: root.actual;
        editor: false;
        picture: CanvasArea.program-picture;
        program-live: Ui.live;
        empty-text: CanvasArea.program-empty-text;
        waiting: CanvasArea.program-waiting;
    }

    if Ui.studio: MonitorHead {
        // Not cached: made again with Studio Mode (see app.slint, cache-docks).
        x: editor.x;
        y: root.slot-y;
        width: root.pic-w;
        tag: "PREVIEW";
        tone: TagTone.preview;
        name: CanvasArea.preview-name;
        info: Ui.preview-scale == "canvas" ? "Canvas" : "Fit";
        info-value: round(editor.scale * 100 * 1px / 1phx) + "%";
    }
    if Ui.studio: MonitorHead {
        // Not cached: made again with Studio Mode (see app.slint, cache-docks).
        x: program.x;
        y: root.slot-y;
        width: root.pic-w;
        tag: "PROGRAM";
        tone: TagTone.program;
        name: CanvasArea.program-name;
        info: Format.canvas;
    }
    if Ui.studio: StudioColumn {
        // Not cached: made again with Studio Mode (see app.slint, cache-docks).
        x: root.pad + root.side + root.pad;
        y: root.slot-y;
        width: root.column;
        height: root.head + root.pic-h;
        head: root.head;
    }
}
