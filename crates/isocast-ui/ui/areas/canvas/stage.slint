// The preview area at the top of the window (Paper "C. Console", Main
// window and Studio Mode boards): Final Cut's viewer. Above the picture
// the viewer line: the canvas's format on the left, the scene's name in
// the middle, the zoom ("Fit 51% ⌄") and View menus on the right; under
// it the canvas letterboxed on the stage, 8px clear of the window's sides
// and the control bar. In Studio Mode it splits into Preview (left,
// edited) and Program (right), each with its own viewer line (a PREVIEW
// or PROGRAM tag and the scene's name), and the studio column (area C)
// between them, as in OBS. An extra canvas (#86, #120) adds its program in
// a column of its own at the stage's right (its name as a tag, its scene
// and a menu over it); with several, the menu switches which one the
// column shows. Editing an extra canvas puts it in the monitors instead,
// and that column goes.

import { Theme } from "../../theme.slint";
import { Ui } from "../../state.slint";
import { Menus, Tag, TagTone, TextMenuButton, Tip } from "../../kit.slint";
import { CanvasArea } from "state.slint";
import { Monitor } from "monitor.slint";
import { StudioColumn } from "../controls/studio.slint";

// The canvas's format: "1920×1080 · 30p" ("Shorts · 1080×1920 · 30p"
// while editing an extra canvas).
global Format {
    out property <string> canvas: (Ui.editing-extra ? Ui.extra-label + " · " : "") + Ui.canvas-width + "×" + Ui.canvas-height + " · " + Ui.canvas-fps + "p";
    out property <string> extra: Ui.extra-width + "×" + Ui.extra-height;
}

// A viewer line's small text (11px `text-3`).
component LineText inherits Text {
    color: Theme.text-3;
    font-size: Theme.fs-xs;
    letter-spacing: Theme.tracking-xs;
    vertical-alignment: center;
    accessible-role: none;
}

// The main viewer line (Paper: 28px on the stage, 14px in): the format,
// the scene centred on the window, the zoom and View menus. Before there
// is a setup: "No format", "No scene" and "Fit", faded (Paper's Welcome
// board).
component ViewerLine inherits Rectangle {
    // The picture's scale, in screen pixels per canvas pixel.
    in property <float> zoom;

    height: Theme.statusbar;
    accessible-role: groupbox;
    accessible-label: "Viewer";

    if !Ui.has-setup: HorizontalLayout {
        padding-left: Theme.pane-x;
        padding-right: Theme.pane-x;
        // Equal sides (Paper's flex-basis 0), so the middle is centred.
        LineText {
            horizontal-stretch: 1;
            min-width: 0px;
            preferred-width: 0px;
            text: "No format";
            color: Theme.text-disabled;
        }
        Text {
            text: "No scene";
            color: Theme.text-3;
            font-size: Theme.fs-sm;
            font-weight: Theme.weight-medium;
            letter-spacing: Theme.tracking-sm;
            vertical-alignment: center;
            accessible-role: none;
        }
        LineText {
            horizontal-stretch: 1;
            min-width: 0px;
            preferred-width: 0px;
            text: "Fit";
            color: Theme.text-disabled;
            horizontal-alignment: right;
        }
    }

    if Ui.has-setup: LineText {
        x: Theme.pane-x;
        y: (parent.height - self.height) / 2;
        height: Theme.lh-xs;
        width: min(Theme.viewer-side, max(0px, (parent.width - name.width) / 2 - Theme.pane-x - Theme.space-2));
        text: Format.canvas + " · Rec. 709";
        overflow: elide;
        accessible-role: AccessibleRole.text;
        accessible-label: "Canvas";
        accessible-value: self.text;
    }
    name := Text {
        visible: Ui.has-setup;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(self.preferred-width, parent.width / 3);
        height: Theme.lh-sm;
        text: CanvasArea.program-name;
        color: Theme.text;
        font-size: Theme.fs-sm;
        font-weight: Theme.weight-semibold;
        letter-spacing: Theme.tracking-sm;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: AccessibleRole.text;
        accessible-label: "Scene";
        accessible-value: self.text;
    }
    if Ui.has-setup: HorizontalLayout {
        x: parent.width - Theme.pane-x - self.width;
        width: self.preferred-width;
        spacing: Theme.line-gap;
        VerticalLayout {
            alignment: center;
            scale := TextMenuButton {
                text: Ui.preview-scale == "canvas" ? "Canvas" : "Fit";
                value: round(root.zoom * 100) + "%";
                menu-open: Menus.open && Menus.owner == "viewer:scale";
                clicked => { Menus.request("viewer:scale", self.absolute-position.x, self.absolute-position.y, self.width, self.height); }
            }
        }
        VerticalLayout {
            alignment: center;
            TextMenuButton {
                text: "View";
                menu-open: Menus.open && Menus.owner == "viewer:view";
                clicked => { Menus.request("viewer:view", self.absolute-position.x, self.absolute-position.y, self.width, self.height); }
            }
        }
    }
}

// A Studio Mode monitor's viewer line (Paper: 28px, 2px in): its tag
// (PREVIEW green, PROGRAM red: the tally, #95) and the scene's name, and on the right
// what it shows at (the zoom, or the format).
component MonitorHead inherits Rectangle {
    in property <string> tag;
    in property <TagTone> tone;
    in property <string> name;
    // On the right: a word and a Martian Mono value ("Fit" "41%"), or a
    // word alone (the format).
    in property <string> info;
    in property <string> info-value;

    height: Theme.statusbar;
    accessible-role: groupbox;
    accessible-label: root.tag + " " + root.name;

    HorizontalLayout {
        padding-left: 2px;
        padding-right: 2px;
        spacing: Theme.space-2;
        Tag {
            text: root.tag;
            tone: root.tone;
        }
        Text {
            horizontal-stretch: 1;
            text: root.name;
            color: Theme.text;
            font-size: Theme.fs-sm;
            font-weight: Theme.weight-medium;
            letter-spacing: Theme.tracking-sm;
            vertical-alignment: center;
            overflow: elide;
        }
        HorizontalLayout {
            spacing: Theme.space-1;
            LineText {
                text: root.info;
            }
            if root.info-value != "": LineText {
                text: root.info-value;
                font-family: Theme.font-mono;
                font-weight: Theme.weight-light;
            }
        }
    }
}

// The canvas monitor's line (#86, #120): its tag (the canvas's name, red
// while it streams), its scene, and its menu (the canvases to show when
// there are several, then show, edit, record, stream, projector,
// settings).
// It is as wide as the picture, so in a narrow one the size makes way
// first (the menu keeps its chevron, and says the size to screen
// readers), then the scene's name (#108); nothing runs past its edge.
// What it drops is in its tooltip and accessible label (#112).
component CanvasHead inherits Rectangle {
    height: Theme.statusbar;
    clip: true;
    accessible-role: groupbox;
    accessible-label: Ui.extra-label + " canvas " + Format.extra + ", " + CanvasArea.extra-name;

    property <string> tag-word: Ui.extra-label.to-uppercase();
    // What the size and the name would take (measured off the layout, so
    // choosing what shows can't loop through it).
    size-words := Text {
        visible: false;
        text: Format.extra;
        font-size: Theme.fs-xs;
        letter-spacing: Theme.tracking-xs;
    }
    long-tag := Tag {
        visible: false;
        text: root.tag-word + " · REC";
    }
    // Recording, a narrow head's tag says just "REC".
    property <bool> long-tag-fits: long-tag.preferred-width + 4px <= root.width;
    property <length> fixed: 4px + tag.preferred-width + 2 * Theme.space-2 + Theme.space-1 + 10px;
    property <bool> show-size: root.fixed + size-words.preferred-width + Theme.space-1 + min(name.preferred-width, 48px) <= root.width;
    property <bool> show-name: root.fixed + 24px <= root.width;
    // Without room for even the chevron, its menu is on a right-click on
    // the picture and in View › Canvases.
    property <bool> show-menu: root.fixed <= root.width;

    // The name (and the menu) it had to drop, on hover (#112).
    if !root.show-name || !root.show-menu || name.preferred-width > name.width + 0.5px: Tooltip {
        Tip {
            text: Ui.extra-label + ": " + CanvasArea.extra-name + " · " + Format.extra + (root.show-menu ? "" : ". Right-click the picture for its menu");
        }
    }

    HorizontalLayout {
        padding-left: 2px;
        padding-right: 2px;
        spacing: Theme.space-2;
        tag := Tag {
            text: CanvasArea.extra-record ? (root.long-tag-fits ? root.tag-word + " · REC" : "REC") : root.tag-word;
            tone: CanvasArea.extra-live ? TagTone.program : TagTone.neutral;
        }
        name := Text {
            horizontal-stretch: 1;
            min-width: 0px;
            opacity: root.show-name ? 1 : 0;
            text: CanvasArea.extra-name;
            color: Theme.text;
            font-size: Theme.fs-sm;
            font-weight: Theme.weight-medium;
            letter-spacing: Theme.tracking-sm;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.show-menu: VerticalLayout {
            alignment: center;
            TextMenuButton {
                text: root.show-size ? Format.extra : "";
                label: Ui.extra-label + " canvas " + Format.extra + (Ui.extra-canvases.length > 1 ? ", switch canvas" : "");
                menu-open: Menus.open && Menus.owner == "viewer:extra";
                clicked => { Menus.request("viewer:extra", self.absolute-position.x, self.absolute-position.y, self.width, self.height); }
            }
        }
    }
}

export component Stage inherits Rectangle {
    // The edited monitor (the only one, or Studio Mode's preview), in
    // window coordinates (see Monitor).
    out property <length> area-x: editor.area-x;
    out property <length> area-y: editor.area-y;
    out property <length> area-width: editor.area-width;
    out property <length> area-height: editor.area-height;
    out property <length> picture-left: editor.picture-left;
    out property <length> picture-top: editor.picture-top;
    out property <length> picture-right: editor.picture-right;
    out property <length> picture-width: editor.picture-width;
    out property <length> picture-height: editor.picture-height;
    out property <int> picture-pixel-width: editor.picture-pixel-width;
    out property <int> picture-pixel-height: editor.picture-pixel-height;
    out property <float> scale: editor.scale;
    out property <bool> dragging: editor.dragging;
    out property <length> box-left: editor.box-left;
    out property <length> box-top: editor.box-top;
    out property <length> box-width: editor.box-width;
    out property <length> box-height: editor.box-height;
    // Studio Mode's program picture.
    out property <length> program-x: program.picture-left;
    out property <length> program-y: program.picture-top;
    out property <length> program-width: Ui.studio ? program.picture-width : 0;
    out property <length> program-height: Ui.studio ? program.picture-height : 0;
    out property <int> program-pixel-width: program.picture-pixel-width;
    out property <int> program-pixel-height: program.picture-pixel-height;
    // The chosen extra canvas's program picture (#86, #120; zero size
    // when hidden).
    out property <length> extra-x: extra.picture-left;
    out property <length> extra-y: extra.picture-top;
    out property <length> extra-width: root.v-shown ? extra.picture-width : 0;
    out property <length> extra-height: root.v-shown ? extra.picture-height : 0;
    out property <int> extra-pixel-width: extra.picture-pixel-width;
    out property <int> extra-pixel-height: extra.picture-pixel-height;
    // The whole stage (the native layers' area).
    out property <length> stage-x: root.absolute-position.x;
    out property <length> stage-y: root.absolute-position.y;
    out property <length> stage-width: root.width;
    out property <length> stage-height: root.height;

    property <length> pad: Theme.space-2;
    property <length> column: Theme.studio-column;
    // A viewer line (Paper: 28px, the status bar's height).
    property <length> head: Theme.statusbar;
    property <bool> actual: Ui.preview-scale == "canvas";
    property <float> aspect: max(1, Ui.canvas-width) / max(1, Ui.canvas-height);
    // The canvas column (#86, #120): its picture as tall as the stage allows,
    // at most 30% of the stage's width; the rest is the main stage's.
    property <bool> v-shown: Ui.has-setup && Ui.has-extra && Ui.show-extra && !Ui.editing-extra;
    property <float> v-aspect: max(1, Ui.extra-width) / max(1, Ui.extra-height);
    property <bool> v-compact: Ui.extra-layout == "compact";
    property <length> v-pic-w: min(root.width * (root.v-compact ? 0.2 : 0.3), max(0px, root.height - root.pad - root.head) * (root.v-compact ? 0.6 : 1) * root.v-aspect);
    property <length> v-pic-h: root.v-pic-w / root.v-aspect;
    property <length> v-column: root.v-shown ? root.v-pic-w + root.pad : 0px;
    property <length> main-w: max(0px, root.width - root.v-column);
    // Studio Mode: each side's picture, as large as fits (or one canvas
    // pixel to a screen pixel).
    property <length> side: max(0px, (root.main-w - 2 * root.pad - root.column - 2 * root.pad) / 2);
    property <length> pic-w: root.actual ? max(1, Ui.canvas-width) * 1phx : min(root.side, max(0px, root.height - 2 * root.pad - root.head) * root.aspect);
    property <length> pic-h: root.pic-w / root.aspect;
    property <length> slot-y: (root.height - root.head - root.pic-h) / 2;

    // Under native pictures the layers paint the stage (src/layers.rs).
    background: CanvasArea.native-picture ? transparent : Theme.surface-stage;
    clip: true;

    // A right click anywhere on the stage off the items: the preview's
    // menu (Preview Scaling, Add, Paste; area A builds it).
    TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.up && event.button == PointerEventButton.right {
                Menus.request("canvas", self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, 0, 0);
            }
        }
    }

    // The main viewer line: a layer of its own (its words and chevrons
    // would otherwise be drawn again for every meter step).
    // Kept made and hidden in Studio Mode: a cached layer made again can
    // show the old one's picture (see app.slint, cache-docks).
    ViewerLine {
        cache-rendering-hint: true;
        visible: !Ui.studio;
        y: 0;
        width: root.main-w;
        zoom: editor.scale * 1px / 1phx;
    }

    // The edited monitor: under the viewer line, 8px clear of the sides
    // and the control bar (its 1px ring inside that), or Studio Mode's
    // left side.
    editor := Monitor {
        x: Ui.studio ? root.pad + (root.side - root.pic-w) : root.pad;
        y: Ui.studio ? root.slot-y + root.head : root.head;
        width: Ui.studio ? root.pic-w : max(0px, root.main-w - 2 * root.pad);
        height: Ui.studio ? root.pic-h : max(0px, root.height - root.head - root.pad);
        pad: Ui.studio ? 0 : 1px;
        actual-size: root.actual;
        editor: true;
        picture: CanvasArea.picture;
        program-live: !Ui.studio && (Ui.editing-extra ? CanvasArea.extra-live : Ui.live);
        empty-text: CanvasArea.empty-text;
        waiting: CanvasArea.waiting;
        error-text: CanvasArea.picture-error;
    }

    program := Monitor {
        visible: Ui.studio;
        x: root.main-w - root.pad - root.side;
        y: root.slot-y + root.head;
        width: Ui.studio ? root.pic-w : 0;
        height: Ui.studio ? root.pic-h : 0;
        actual-size: root.actual;
        editor: false;
        picture: CanvasArea.program-picture;
        program-live: Ui.editing-extra ? CanvasArea.extra-live : Ui.live;
        empty-text: CanvasArea.program-empty-text;
        waiting: CanvasArea.program-waiting;
        error-text: CanvasArea.program-error;
    }

    if Ui.studio: MonitorHead {
        // Not cached: made again with Studio Mode (see app.slint, cache-docks).
        x: editor.x;
        y: root.slot-y;
        width: root.pic-w;
        tag: "PREVIEW";
        tone: TagTone.preview;
        name: CanvasArea.preview-name;
        info: Ui.preview-scale == "canvas" ? "Canvas" : "Fit";
        info-value: round(editor.scale * 100 * 1px / 1phx) + "%";
    }
    if Ui.studio: MonitorHead {
        // Not cached: made again with Studio Mode (see app.slint, cache-docks).
        x: program.x;
        y: root.slot-y;
        width: root.pic-w;
        tag: "PROGRAM";
        tone: TagTone.program;
        name: CanvasArea.program-name;
        info: Format.canvas;
    }
    // The chosen extra canvas's program: kept made and hidden (as Studio
    // Mode's program is), its line over it; as tall as the edited monitor
    // when the stage's height limits it, else centred.
    property <length> v-head-y: max(0px, (root.height - root.pad - root.head - root.v-pic-h) / 2);
    extra := Monitor {
        visible: root.v-shown;
        x: root.main-w;
        y: root.v-head-y + root.head;
        width: root.v-shown ? root.v-pic-w : 0;
        height: root.v-shown ? root.v-pic-h : 0;
        canvas-width: max(1, Ui.extra-width);
        canvas-height: max(1, Ui.extra-height);
        label: Ui.extra-label;
        editor: false;
        picture: CanvasArea.extra-picture;
        program-live: CanvasArea.extra-live;
        empty-text: CanvasArea.extra-empty-text;
        waiting: CanvasArea.extra-waiting;
        error-text: CanvasArea.extra-error;
    }
    // Right-click on the canvas picture: its menu, with Open Projector
    // (#96). Draws nothing.
    if root.v-shown: TouchArea {
        x: extra.x;
        y: extra.y;
        width: extra.width;
        height: extra.height;
        pointer-event(event) => {
            if event.kind == PointerEventKind.up && event.button == PointerEventButton.right {
                Menus.request("extra-monitor", self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, 0, 0);
            }
        }
    }
    if root.v-shown: CanvasHead {
        x: root.main-w;
        y: root.v-head-y;
        width: root.v-pic-w;
    }

    if Ui.studio: StudioColumn {
        // Not cached: made again with Studio Mode (see app.slint, cache-docks).
        x: root.pad + root.side + root.pad;
        y: root.slot-y;
        width: root.column;
        height: root.head + root.pic-h;
        head: root.head;
    }
}
