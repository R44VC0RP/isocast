// The editor (C.3, #70): a viewer showing the angle the edited video has
// at the playhead, over the timeline with every ISO track (ClipBar in its
// editor form). It fills the editor window, never the studio, so it is
// always plain which one you are in.
//
// Round 2 (#87): the viewer shows a clip's crop as the edited video will
// (the crop scaled to fit), and in crop mode (C, or the Crop button) the
// whole picture with the crop's box: drag inside it to move it, its edges
// and corners to size it, the shapes above to keep one.

import { Theme } from "../../theme.slint";
import { Icons, Icon } from "../../icons.slint";
import { CreateArea } from "state.slint";
import { ClipBar, PillGroup, PillItem, PillDivider } from "clip-bar.slint";

// One handle of the crop box: a 12px square at its corners, a 20x6 bar at
// its edges. It reports its drag in fractions of the picture, from where
// it was pressed in window coordinates (the box moves under the pointer).
component CropHandle inherits Rectangle {
    // "move" or the edges it holds ("l", "tr", …).
    in property <string> edge;
    in property <length> pic-w;
    in property <length> pic-h;
    in property <MouseCursor> cursor;
    property <length> press-x;
    property <length> press-y;
    ta := TouchArea {
        mouse-cursor: root.cursor;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.press-x = self.absolute-position.x + self.mouse-x;
                root.press-y = self.absolute-position.y + self.mouse-y;
                CreateArea.crop-press(root.edge);
            } else if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) || event.kind == PointerEventKind.cancel {
                CreateArea.crop-release();
            }
        }
        moved => {
            if self.pressed {
                CreateArea.crop-drag(
                    (self.absolute-position.x + self.mouse-x - root.press-x) / root.pic-w,
                    (self.absolute-position.y + self.mouse-y - root.press-y) / root.pic-h);
            }
        }
    }
    @children
}

// The crop box over the whole picture: the picture outside it dimmed, its
// outline and thirds, and its handles.
export component CropBox inherits Rectangle {
    in property <length> pic-w;
    in property <length> pic-h;
    property <length> bx: CreateArea.crop-x * root.pic-w;
    property <length> by: CreateArea.crop-y * root.pic-h;
    property <length> bw: CreateArea.crop-w * root.pic-w;
    property <length> bh: CreateArea.crop-h * root.pic-h;
    accessible-role: groupbox;
    accessible-label: "Crop";
    // Outside the crop: dimmed.
    Rectangle { x: 0; y: 0; width: root.pic-w; height: root.by; background: #000000a8; }
    Rectangle { x: 0; y: root.by + root.bh; width: root.pic-w; height: root.pic-h - root.by - root.bh; background: #000000a8; }
    Rectangle { x: 0; y: root.by; width: root.bx; height: root.bh; background: #000000a8; }
    Rectangle { x: root.bx + root.bw; y: root.by; width: root.pic-w - root.bx - root.bw; height: root.bh; background: #000000a8; }
    // Moving it: anywhere inside.
    CropHandle {
        x: root.bx;
        y: root.by;
        width: root.bw;
        height: root.bh;
        edge: "move";
        pic-w: root.pic-w;
        pic-h: root.pic-h;
        cursor: MouseCursor.move;
        // The thirds.
        for i in 2: Rectangle {
            x: (i + 1) * parent.width / 3;
            width: 1px;
            background: #ffffff40;
        }
        for i in 2: Rectangle {
            y: (i + 1) * parent.height / 3;
            height: 1px;
            background: #ffffff40;
        }
        // The outline.
        Rectangle {
            border-width: 1px;
            border-color: Theme.bone;
        }
    }
    // The edges, then the corners over them.
    for h in [
        { edge: "l", cx: 0, cy: 0.5, w: 6px, h: 20px },
        { edge: "r", cx: 1, cy: 0.5, w: 6px, h: 20px },
        { edge: "t", cx: 0.5, cy: 0, w: 20px, h: 6px },
        { edge: "b", cx: 0.5, cy: 1, w: 20px, h: 6px },
        { edge: "tl", cx: 0, cy: 0, w: 12px, h: 12px },
        { edge: "tr", cx: 1, cy: 0, w: 12px, h: 12px },
        { edge: "bl", cx: 0, cy: 1, w: 12px, h: 12px },
        { edge: "br", cx: 1, cy: 1, w: 12px, h: 12px },
    ]: CropHandle {
        // 8px of room around the visible handle to grab.
        x: root.bx + h.cx * root.bw - h.w / 2 - 8px;
        y: root.by + h.cy * root.bh - h.h / 2 - 8px;
        width: h.w + 16px;
        height: h.h + 16px;
        edge: h.edge;
        pic-w: root.pic-w;
        pic-h: root.pic-h;
        cursor: h.edge == "l" || h.edge == "r" ? MouseCursor.ew-resize
            : h.edge == "t" || h.edge == "b" ? MouseCursor.ns-resize
            : h.edge == "tl" || h.edge == "br" ? MouseCursor.nwse-resize : MouseCursor.nesw-resize;
        accessible-role: none;
        Rectangle {
            x: 8px;
            y: 8px;
            width: h.w;
            height: h.h;
            border-radius: 2px;
            background: Theme.bone;
            border-width: 1px;
            border-color: #00000080;
        }
    }
}

// What the viewer shows and when ("Program · 00:02.50"): a type of its
// own so the motion harness can tell it moves with the playhead.
component ShownAt inherits Text { }

export component EditorView inherits Rectangle {
    background: Theme.surface-stage;

    // Zoom the timeline (⌘+ ⌘−, = −), or fit it (⇧Z).
    public function zoom-by(steps: float) {
        bar.zoom-by(steps);
    }
    public function zoom-fit() {
        bar.zoom-fit();
    }

    // ---- The viewer
    viewer := Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height - bar.height - 1px;
        background: Theme.surface-chrome;

        // The line over the picture: EDITOR, the timeline, what is shown;
        // in crop mode, the crop's shapes.
        Rectangle {
            y: 0;
            height: 32px;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        height: 18px;
                        width: badge.preferred-width + 14px;
                        border-radius: 4px;
                        background: Theme.accent-soft;
                        badge := Text {
                            text: CreateArea.crop-mode ? "CROP" : "EDITOR";
                            color: Theme.accent;
                            font-size: Theme.fs-micro;
                            font-weight: Theme.weight-semibold;
                            letter-spacing: 0.6px;
                        }
                    }
                }
                Text {
                    text: CreateArea.has-timeline ? CreateArea.timeline-name : "No timeline";
                    color: Theme.text;
                    font-size: Theme.fs-sm;
                    font-weight: Theme.weight-semibold;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }
                Text {
                    text: CreateArea.has-timeline && !CreateArea.crop-mode ? CreateArea.summary : "";
                    color: Theme.text-3;
                    font-size: Theme.fs-xs;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                // Crop mode: the shapes, Reset and Done.
                if CreateArea.crop-mode: VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    PillGroup {
                        for p in ["free", "16:9", "9:16", "1:1", "4:5"]: PillItem {
                            text: p == "free" ? "Free" : p;
                            tint: CreateArea.crop-preset == p ? Theme.accent-text : Theme.text-2;
                            tooltip: p == "free" ? "Drag the crop to any shape" : "Crop to the largest " + p + " that fits";
                            clicked => { CreateArea.crop-preset-chosen(p); }
                        }
                        PillDivider { }
                        PillItem {
                            icon: Icons.reset;
                            text: "Reset";
                            enabled: CreateArea.has-crop;
                            tooltip: "Show the whole picture again";
                            clicked => { CreateArea.crop-clear(); }
                        }
                        PillDivider { }
                        PillItem {
                            text: "Done";
                            tint: Theme.accent-text;
                            tooltip: "Stop cropping (C or Esc)";
                            clicked => { CreateArea.crop-mode = false; }
                        }
                    }
                }
                ShownAt {
                    text: CreateArea.preview-label;
                    color: Theme.text-2;
                    font-family: Theme.font-mono;
                    font-size: Theme.fs-micro;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }
                if CreateArea.shuttle != 0: Text {
                    text: (CreateArea.shuttle < 0 ? "◀ " : "▶ ") + abs(CreateArea.shuttle) + "×";
                    color: Theme.accent;
                    font-family: Theme.font-mono;
                    font-size: Theme.fs-micro;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }
            }
        }

        // The picture, 16:9 (the program's shape), as large as fits.
        property <length> room-w: self.width - 32px;
        property <length> room-h: self.height - 32px - 12px;
        property <length> pic-w: min(self.room-w, self.room-h * 16 / 9);
        frame := Rectangle {
            x: (parent.width - self.width) / 2;
            y: 32px + (parent.room-h - self.height) / 2;
            width: parent.pic-w;
            height: self.width * 9 / 16;
            background: #000000;
            // The source picture's own shape inside the frame.
            property <float> aspect: CreateArea.crop-aspect > 0 ? CreateArea.crop-aspect : 16 / 9;
            property <length> img-w: min(self.width, self.height * self.aspect);
            property <length> img-h: self.img-w / self.aspect;
            // The crop as the edited video shows it: fitted to the frame.
            property <float> crop-shape: self.aspect * CreateArea.crop-w / max(0.0001, CreateArea.crop-h);
            property <length> out-w: min(self.width, self.height * self.crop-shape);
            if CreateArea.has-preview && (CreateArea.crop-mode || !CreateArea.has-crop): Image {
                x: (parent.width - parent.img-w) / 2;
                y: (parent.height - parent.img-h) / 2;
                width: parent.img-w;
                height: parent.img-h;
                source: CreateArea.preview;
                image-fit: fill;
            }
            if CreateArea.has-preview && !CreateArea.crop-mode && CreateArea.has-crop: Image {
                x: (parent.width - parent.out-w) / 2;
                y: (parent.height - self.height) / 2;
                width: parent.out-w;
                height: self.width / parent.crop-shape;
                source: CreateArea.preview;
                source-clip-x: CreateArea.crop-x * self.source.width;
                source-clip-y: CreateArea.crop-y * self.source.height;
                source-clip-width: CreateArea.crop-w * self.source.width;
                source-clip-height: CreateArea.crop-h * self.source.height;
                image-fit: fill;
            }
            if CreateArea.preview-offline && !CreateArea.has-preview: Text {
                text: "Offline";
                color: Theme.text-3;
                font-size: Theme.fs-sm;
                font-weight: Theme.weight-medium;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            if CreateArea.crop-mode && CreateArea.has-preview: CropBox {
                x: (parent.width - parent.img-w) / 2;
                y: (parent.height - parent.img-h) / 2;
                width: parent.img-w;
                height: parent.img-h;
                pic-w: parent.img-w;
                pic-h: parent.img-h;
            }
        }
    }
    Rectangle {
        y: viewer.height;
        height: 1px;
        background: Theme.line;
    }

    // ---- The timeline
    bar := ClipBar {
        editor: true;
        side-preview: false;
        x: 0;
        y: root.height - self.height;
        width: root.width;
        height: min(max(160px, self.wanted-height), root.height * 0.6);
    }
}
