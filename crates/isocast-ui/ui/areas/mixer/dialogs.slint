// Area B's dialogs: Advanced Audio Properties ("advanced-audio"), as in
// OBS, drawn as a Console sheet: one grouped row per audio source (its
// name, then its volume, mute, mono, balance, sync offset and monitoring, and
// where it is recorded: Isocast's tracks, the program mix and the ISO
// files) under a line of column names. Put on the window by app.slint.

import { Theme } from "../../theme.slint";
import { Icons } from "../../icons.slint";
import { Ui } from "../../state.slint";
import {
    Checkbox, Dialog, Dropdown, GroupHint, GroupRow, NumberField, RowGroup, RowPlace, ScrollArea, Slider, Tip,
    Viewport,
} from "../../kit.slint";
import { AudioRow, MixerArea } from "state.slint";

// The table's columns (the web app's: name ≥ 80, then 104 44 44 170 108
// 200 136, 12px apart), from the sheet's width (1116, at most the window's
// less 40; less its edge and 20px sides) and a grouped row's insets (12px
// before the name, 12px after it, 4px at the end). In a narrow window the
// name gives way first (to 80), then Balance and Audio Monitoring.
global Columns {
    out property <length> dialog: 1116px;
    out property <length> gap: 12px;
    property <length> table: min(root.dialog, Viewport.width - 40px) - 2px - 2 * Theme.sheet-pad;
    property <length> fixed: 104px + 44px + 44px + 170px + 108px + 200px + 136px + 6 * 12px;
    property <length> insets: Theme.space-3 + 12px + Theme.space-1;
    property <length> deficit: max(0px, 80px + root.fixed + root.insets - root.table);
    out property <length> name-w: max(80px, root.table - root.fixed - root.insets);
    out property <length> balance-w: 170px - root.deficit * 0.4;
    out property <length> monitor-w: 200px - root.deficit * 0.6;
}

component Columned inherits HorizontalLayout {
    spacing: Columns.gap;
}

component Centred inherits VerticalLayout {
    alignment: center;
}

// A column's tooltip (a `Tooltip` straight in a dialog's tree trips the
// Slint 1.18 compiler; inside a component it's fine).
component HeadTip inherits Rectangle {
    in property <string> tooltip;
    Tooltip {
        Tip { text: root.tooltip; }
    }
}

// A column's name: 11px semibold `text-3` (the sidebar's headings).
component Head inherits Text {
    color: Theme.text-3;
    font-size: Theme.fs-xs;
    letter-spacing: Theme.tracking-xs;
    font-weight: Theme.weight-semibold;
    vertical-alignment: center;
    overflow: elide;
}

component AudioTableRow inherits GroupRow {
    in property <AudioRow> audio;

    label: root.audio.name;

    Columned {
        Centred {
            width: 104px;
            NumberField {
                small: true;
                label: "Volume of " + root.audio.name;
                value: root.audio.gain-db;
                minimum: -100;
                maximum: 30;
                step: 0.1;
                unit: "dB";
                submits: false;
                changed(db) => { MixerArea.set-gain(root.audio.id, db); }
            }
        }
        HorizontalLayout {
            width: 44px;
            alignment: center;
            Checkbox {
                label: "Mute " + root.audio.name;
                checked: root.audio.muted;
                toggled(on) => { MixerArea.set-muted(root.audio.id, on); }
            }
        }
        HorizontalLayout {
            width: 44px;
            alignment: center;
            Checkbox {
                label: "Mono " + root.audio.name;
                tooltip: "Downmix to mono in the program and monitoring; ISO files keep it as captured";
                checked: root.audio.mono;
                toggled(on) => { MixerArea.set-mono(root.audio.id, on); }
            }
        }
        HorizontalLayout {
            width: Columns.balance-w;
            spacing: Theme.space-2;
            Centred {
                horizontal-stretch: 1;
                Slider {
                    thin: true;
                    label: "Balance of " + root.audio.name;
                    value-text: root.audio.balance-text;
                    minimum: -1;
                    maximum: 1;
                    step: 0.01;
                    origin: 0;
                    value: root.audio.balance;
                    moved(b) => { MixerArea.balance-moved(root.audio.id, b); }
                    changed(b) => { MixerArea.balance-changed(root.audio.id, b); }
                }
            }
            Text {
                width: 30px;
                text: root.audio.balance-text;
                color: Theme.text;
                font-family: Theme.font-mono;
                font-weight: Theme.weight-light;
                font-size: Theme.fs-xs;
                letter-spacing: Theme.tracking-mono;
                horizontal-alignment: right;
                vertical-alignment: center;
                accessible-role: none;
            }
        }
        Centred {
            width: 108px;
            NumberField {
                small: true;
                label: "Sync offset of " + root.audio.name;
                value: root.audio.offset-ms;
                minimum: -5000;
                maximum: 5000;
                step: 1;
                unit: "ms";
                submits: false;
                changed(ms) => { MixerArea.set-offset(root.audio.id, ms); }
            }
        }
        Centred {
            width: Columns.monitor-w;
            Dropdown {
                on-control: true;
                label: "Audio monitoring of " + root.audio.name;
                options: MixerArea.monitoring;
                value: root.audio.monitor;
                selected(value) => { MixerArea.set-monitor(root.audio.id, value); }
            }
        }
        HorizontalLayout {
            width: 136px;
            spacing: Theme.space-3;
            Checkbox {
                text: "Program";
                small: true;
                label: "Record " + root.audio.name + " in the program mix";
                checked: root.audio.program;
                toggled(on) => { MixerArea.set-program(root.audio.id, on); }
            }
            Checkbox {
                text: "ISO";
                small: true;
                faint: !MixerArea.iso-enabled;
                tooltip: MixerArea.iso-enabled ? "Recorded with every ISO file" : "ISO recording is off (Settings → Output)";
                checked: root.audio.iso;
                toggled(on) => { MixerArea.set-iso(root.audio.id, on); }
            }
        }
    }
}

export component MixerDialogs inherits Rectangle {
    if Ui.dialog == "advanced-audio": Dialog {
        title: "Advanced Audio Properties";
        subtitle: "Each audio source’s volume, mono, balance, sync and monitoring, and the files it is recorded in.";
        icon: Icons.sheet-sliders;
        dialog-width: Columns.dialog;
        ok-text: "Close";
        cancel-text: "";
        accepted => { Ui.close-dialog(); }
        cancelled => { Ui.close-dialog(); }

        VerticalLayout {
            padding-left: Theme.sheet-pad;
            padding-right: Theme.sheet-pad;
            spacing: 0;

            // The columns' names, over the rows' controls.
            HorizontalLayout {
                height: 24px;
                padding-left: Theme.space-3;
                padding-right: Theme.space-1;
                spacing: 12px;
                Head {
                    width: Columns.name-w;
                    text: "Name";
                }
                Columned {
                    Head {
                        width: 104px;
                        text: "Volume";
                    }
                    Head {
                        width: 44px;
                        text: "Mute";
                        horizontal-alignment: center;
                    }
                    Head {
                        width: 44px;
                        text: "Mono";
                        horizontal-alignment: center;
                    }
                    Head {
                        width: Columns.balance-w;
                        text: "Balance";
                    }
                    Head {
                        width: 108px;
                        text: "Sync Offset";
                    }
                    Head {
                        width: Columns.monitor-w;
                        text: "Audio Monitoring";
                    }
                    Rectangle {
                        width: 136px;
                        Head {
                            x: 0;
                            width: parent.width;
                            height: parent.height;
                            text: "Tracks";
                        }
                        HeadTip {
                            tooltip: "Where it is recorded: the program mix (Program), and attached to every ISO file (ISO)";
                        }
                    }
                }
            }
            if MixerArea.rows.length == 0: GroupHint {
                text: "No audio sources.";
            }
            ScrollArea {
                min-height: 0;
                preferred-height: self.content-height;
                vertical-stretch: 1;
                RowGroup {
                    for row[i] in MixerArea.rows: AudioTableRow {
                        audio: row;
                        place: MixerArea.rows.length == 1 ? RowPlace.only : i == 0 ? RowPlace.first : i == MixerArea.rows.length - 1 ? RowPlace.last : RowPlace.middle;
                    }
                }
            }
        }
    }
}
