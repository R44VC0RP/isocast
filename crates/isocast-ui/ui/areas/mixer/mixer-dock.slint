// The Audio Mixer dock (docs/design.md 3.16), as in OBS: a strip per audio
// source with its name and volume on top, a meter (−60 to 0 dBFS, green,
// amber and red zones, peak hold), and under it the fader, mute and a
// menu; the dock's toolbar has Advanced Audio Properties and a menu. A
// right-click on a strip opens its menu, elsewhere in the dock the dock's.

import { Theme } from "../../theme.slint";
import { Icon, Icons } from "../../icons.slint";
import { Ui } from "../../state.slint";
import { Dock, DockToolbar, Dot, IconButton, ListEmpty, Menus, Meter, ScrollArea, Slider, Tip } from "../../kit.slint";
import { Level, MixerArea, Strip } from "state.slint";

// A strip's parts, top to bottom: 8px, the 20px head, 4px, the 22px
// meter, 4px, the 24px controls, 4px.
global StripSize {
    out property <length> body: 86px;
    // Strips after the first: 2px apart, then a soft line.
    out property <length> gap: 3px;
}

// A small flag in the strip's head with a tooltip (a `Tooltip` can't be a
// layout's direct child).
component Flag inherits Rectangle {
    in property <string> tooltip;
    if root.tooltip != "": Tooltip {
        Tip { text: root.tooltip; }
    }
}

component MixerStrip inherits Rectangle {
    in property <Strip> strip;
    in property <Level> level;
    in property <bool> first;
    function open-menu() {
        Menus.request("mixer:strip:" + root.strip.id, more.absolute-position.x, more.absolute-position.y, more.width, more.height);
    }

    height: StripSize.body + (root.first ? 0 : StripSize.gap);
    accessible-role: groupbox;
    accessible-label: root.strip.name;

    // Right-click (or ⌃-click) anywhere on the strip: its menu.
    TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.up && (event.button == PointerEventButton.right || (event.button == PointerEventButton.left && event.modifiers.control)) {
                Menus.request("mixer:strip:" + root.strip.id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, 0, 0);
            }
        }
    }

    if !root.first: Rectangle {
        y: StripSize.gap - 1px;
        height: 1px;
        background: Theme.line-soft;
    }

    VerticalLayout {
        y: root.first ? 0 : StripSize.gap;
        height: StripSize.body;
        padding-top: Theme.space-2;
        padding-bottom: Theme.space-1;
        padding-left: Theme.pane-x;
        padding-right: Theme.pane-x;
        spacing: Theme.space-1;

        HorizontalLayout {
            height: 20px;
            spacing: Theme.space-2;
            Text {
                horizontal-stretch: 1;
                text: root.strip.name;
                color: root.strip.muted ? Theme.text-3 : Theme.text;
                font-size: Theme.fs;
                letter-spacing: Theme.tracking;
                vertical-alignment: center;
                overflow: elide;
                accessible-role: none;
            }
            // The source's state: failed (why, on hover), or opening.
            if root.strip.failed: Flag {
                width: Theme.icon;
                tooltip: root.strip.error != "" ? root.strip.error : "This source couldn’t start.";
                accessible-role: image;
                accessible-label: "Failed: " + self.tooltip;
                Icon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    path: Icons.warning;
                    size: Theme.icon-sm;
                    color: Theme.danger-text;
                }
            }
            if root.strip.opening && !root.strip.failed: Flag {
                width: Theme.icon;
                tooltip: "Starting…";
                Dot {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    pulse: true;
                }
            }
            if root.strip.monitored: Flag {
                width: Theme.icon-sm;
                tooltip: root.strip.monitor-only ? "Monitored only (not in the output)" : "Monitored";
                accessible-role: image;
                accessible-label: self.tooltip;
                Icon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    path: Icons.headphones;
                    size: Theme.icon-sm;
                    color: Theme.accent-text;
                }
            }
            if root.strip.not-in-mix: Flag {
                width: not-in-mix.preferred-width;
                tooltip: "Not in the program mix (⋮ → Include in Program Mix)";
                not-in-mix := Text {
                    height: parent.height;
                    text: "not in mix";
                    color: Theme.text-3;
                    font-size: Theme.fs-xs;
                    letter-spacing: Theme.tracking-xs;
                    vertical-alignment: center;
                }
            }
            Text {
                text: root.strip.gain-text;
                color: root.strip.muted ? Theme.text-3 : Theme.text-2;
                font-size: Theme.fs-sm;
                letter-spacing: Theme.tracking-sm;
                vertical-alignment: center;
                accessible-role: none;
            }
        }

        Meter {
            rms: root.level.rms;
            peak: root.level.peak;
            hold: root.level.hold;
            muted: root.strip.muted;
            label: root.strip.name + " level";
        }

        HorizontalLayout {
            height: Theme.control-h-sm;
            spacing: 2px;
            HorizontalLayout {
                horizontal-stretch: 1;
                padding-right: Theme.space-2;
                VerticalLayout {
                    alignment: center;
                    Slider {
                        label: "Volume of " + root.strip.name;
                        value-text: root.strip.gain-text;
                        tooltip: "Volume: drag; double-click for 0 dB";
                        minimum: -60;
                        maximum: 0;
                        step: 0.1;
                        value: max(-60, min(0, root.strip.gain-db));
                        moved(db) => { MixerArea.gain-moved(root.strip.id, db); }
                        changed(db) => { MixerArea.gain-changed(root.strip.id, db); }
                        double-clicked => { MixerArea.gain-reset(root.strip.id); }
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                IconButton {
                    small: true;
                    icon: root.strip.muted ? Icons.muted : Icons.speaker;
                    label: root.strip.muted ? "Unmute" : "Mute";
                    danger: root.strip.muted;
                    clicked => { MixerArea.toggle-mute(root.strip.id); }
                }
            }
            VerticalLayout {
                alignment: center;
                more := IconButton {
                    small: true;
                    icon: Icons.more-vertical;
                    label: "More";
                    menu-open: Menus.open && Menus.owner == "mixer:strip:" + root.strip.id;
                    clicked => { root.open-menu(); }
                }
            }
        }
    }
}

export component MixerDock inherits Dock {
    title: "Audio Mixer";

    // A snapshot state opens strip `menu-index`'s ⋮ menu, anchored where
    // its ⋮ button is (strips are all one height).
    property <int> menu-serial: MixerArea.menu-serial;
    changed menu-serial => {
        Menus.request(
            "mixer:strip:" + MixerArea.menu-for,
            scroll.absolute-position.x + scroll.width - scroll.gutter-width - Theme.pane-x - Theme.control-h-sm,
            scroll.absolute-position.y - scroll.scroll-y + MixerArea.menu-index * (StripSize.body + StripSize.gap) + 58px,
            Theme.control-h-sm,
            Theme.control-h-sm);
    }

    scroll := ScrollArea {
        gutter: MixerArea.strips.length * (StripSize.body + StripSize.gap) > self.height + 0.5px;
        vertical-stretch: 1;
        accessible-role: list;
        accessible-label: "Audio Mixer";
        for strip[i] in MixerArea.strips: MixerStrip {
            strip: strip;
            level: MixerArea.levels[i];
            first: i == 0;
        }
        if Ui.has-setup && MixerArea.source-count == 0: ListEmpty {
            text: "No audio sources. Add an Audio Input Capture (a microphone) with + under Sources.";
        }
        if MixerArea.source-count > 0 && MixerArea.strips.length == 0: ListEmpty {
            text: "Every audio source is hidden. Right-click → Unhide All.";
        }
        // The rest of the dock: a right-click there opens the dock's menu.
        Rectangle {
            height: max(0px, scroll.visible-height - (MixerArea.strips.length > 0 ? MixerArea.strips.length * (StripSize.body + StripSize.gap) - StripSize.gap : 48px));
            TouchArea {
                pointer-event(event) => {
                    if event.kind == PointerEventKind.up && (event.button == PointerEventButton.right || (event.button == PointerEventButton.left && event.modifiers.control)) {
                        Menus.request("mixer:dock", self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, 0, 0);
                    }
                }
            }
        }
    }

    DockToolbar {
        IconButton {
            small: true;
            icon: Icons.settings;
            label: "Advanced Audio Properties";
            enabled: MixerArea.source-count > 0;
            clicked => { Ui.menu("advanced_audio"); }
        }
        IconButton {
            small: true;
            icon: Icons.more-vertical;
            label: "Mixer menu";
            menu-open: Menus.open && Menus.owner == "mixer:dock";
            clicked => {
                Menus.request("mixer:dock", self.absolute-position.x, self.absolute-position.y, self.width, self.height);
            }
        }
    }
}
