// Edit Transform (⌘E; the web app's transform.js), as in OBS, drawn as a
// Console sheet of grouped rows (Paper's Settings sheet): the selected
// item's position, rotation, flip, size, scale and alignment; its
// bounding box; its crop; and Isocast's item style (opacity, corners,
// border, shadow, background) under Appearance. Reset at the bottom left,
// Close at the right. It follows the selection and changes show at once.

import { Theme } from "../../theme.slint";
import { Icons } from "../../icons.slint";
import { Ui } from "../../state.slint";
import {
    Button, Callout, CalloutKind, Checkbox, ColorField, ControlSize, Dialog, Dropdown, GroupHeading,
    GroupRow, IconButton, NumberField, RowGroup, RowPlace, Slider,
} from "../../kit.slint";
import { SourcesArea } from "state.slint";

// A control in the middle of its row.
component Centred inherits VerticalLayout {
    alignment: center;
}

// A number of the transform: scrubbing sends live changes.
component TransformNumber inherits NumberField {
    in property <string> field;
    width: Theme.field-xs;
    small: true;
    scrubbing(v) => { SourcesArea.transform-number(root.field, v, true); }
    changed(v) => { SourcesArea.transform-number(root.field, v, false); }
}

// A row's ✕ (no border, no shadow…).
component RemoveButton inherits Centred {
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked();
    IconButton {
        compact: true;
        icon: Icons.x;
        icon-size: Theme.icon-xs;
        label: root.label;
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// "Add a border" and its kind, on a grey row.
component AddButton inherits Centred {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();
    Button {
        text: root.text;
        icon: Icons.plus;
        icon-size: 10px;
        icon-gap: 6px;
        inset-end: Theme.space-3;
        size: ControlSize.small;
        on-control: true;
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component TransformDialog inherits Dialog {
    property <bool> locked: SourcesArea.transform-locked;
    property <bool> live: !root.locked;

    title: SourcesArea.transform-item ? SourcesArea.transform-name : "Edit Transform";
    accessible-name: SourcesArea.transform-title;
    subtitle: SourcesArea.transform-item ? "Where it sits in the scene, its size and crop, and how it looks." : "Select a source to change its transform.";
    icon: Icons.move;
    dialog-width: 560px;
    ok-text: "Close";
    cancel-text: "";
    extra-text: SourcesArea.transform-item ? "Reset" : "";
    extra-enabled: !root.locked;
    accepted => { Ui.close-dialog(); }
    cancelled => { Ui.close-dialog(); }
    extra => { SourcesArea.transform-action("reset"); }

    if SourcesArea.transform-item: VerticalLayout {
        padding-left: Theme.sheet-pad;
        padding-right: Theme.sheet-pad;
        spacing: 10px;

        if root.locked: Callout {
            kind: CalloutKind.info;
            message: "This source is locked. Unlock it in the Sources list to move it.";
        }

        // Its place and size.
        VerticalLayout {
            spacing: 0;
            GroupHeading {
                title: "Position and Size";
            }
            RowGroup {
                GroupRow {
                    label: "Position";
                    place: RowPlace.first;
                    enabled: root.live;
                    Centred {
                        TransformNumber {
                            field: "x";
                            prefix: "X";
                            label: "X";
                            value: SourcesArea.transform-x;
                            enabled: root.live;
                        }
                    }
                    Centred {
                        TransformNumber {
                            field: "y";
                            prefix: "Y";
                            label: "Y";
                            value: SourcesArea.transform-y;
                            enabled: root.live;
                        }
                    }
                }
                GroupRow {
                    label: "Rotation";
                    enabled: root.live;
                    Centred {
                        TransformNumber {
                            field: "rotate";
                            label: "Rotation";
                            unit: "°";
                            step: 0.1;
                            minimum: -360;
                            maximum: 360;
                            value: SourcesArea.transform-rotate;
                            enabled: root.live;
                        }
                    }
                }
                GroupRow {
                    label: "Flip";
                    enabled: root.live;
                    Centred {
                        Checkbox {
                            text: "Horizontal";
                            small: true;
                            tooltip: "Mirror it left to right";
                            checked <=> SourcesArea.transform-flip-horizontal;
                            enabled: root.live;
                            toggled => { SourcesArea.transform-action("flip-horizontal"); }
                        }
                    }
                    Centred {
                        Checkbox {
                            text: "Vertical";
                            small: true;
                            tooltip: "Mirror it top to bottom";
                            checked <=> SourcesArea.transform-flip-vertical;
                            enabled: root.live;
                            toggled => { SourcesArea.transform-action("flip-vertical"); }
                        }
                    }
                }
                GroupRow {
                    label: "Size";
                    enabled: root.live;
                    Centred {
                        TransformNumber {
                            field: "w";
                            prefix: "W";
                            label: "Width";
                            minimum: 1;
                            value: SourcesArea.transform-w;
                            enabled: root.live;
                        }
                    }
                    Centred {
                        TransformNumber {
                            field: "h";
                            prefix: "H";
                            label: "Height";
                            minimum: 1;
                            value: SourcesArea.transform-h;
                            enabled: root.live;
                        }
                    }
                }
                GroupRow {
                    label: "Scale";
                    enabled: root.live;
                    Centred {
                        TransformNumber {
                            field: "scale";
                            label: "Scale";
                            unit: "%";
                            step: 0.1;
                            minimum: 1;
                            maximum: 1000;
                            value: SourcesArea.transform-scale;
                            enabled: root.live;
                        }
                    }
                }
                GroupRow {
                    label: "Positional Alignment";
                    place: RowPlace.last;
                    enabled: root.live;
                    Centred {
                        Dropdown {
                            width: Theme.field-choice;
                            on-control: true;
                            options: SourcesArea.align-options;
                            value: SourcesArea.transform-anchor;
                            label: "Positional Alignment";
                            tooltip: "Which point of the source the position is measured to";
                            enabled: root.live;
                            selected(v) => { SourcesArea.transform-choose("anchor", v); }
                        }
                    }
                }
            }
        }

        // The box it fits in.
        VerticalLayout {
            spacing: 0;
            GroupHeading {
                title: "Bounding Box";
            }
            RowGroup {
                GroupRow {
                    label: "Bounding Box Type";
                    place: RowPlace.first;
                    enabled: root.live;
                    Centred {
                        Dropdown {
                            width: Theme.field-choice;
                            on-control: true;
                            options: SourcesArea.fit-options;
                            value: SourcesArea.transform-fit;
                            label: "Bounding Box Type";
                            enabled: root.live;
                            selected(v) => { SourcesArea.transform-choose("fit", v); }
                        }
                    }
                }
                GroupRow {
                    label: "Alignment in Bounding Box";
                    place: RowPlace.last;
                    enabled: root.live && SourcesArea.transform-fit != "stretch";
                    Centred {
                        Dropdown {
                            width: Theme.field-choice;
                            on-control: true;
                            options: SourcesArea.align-options;
                            value: SourcesArea.transform-align;
                            label: "Alignment in Bounding Box";
                            enabled: root.live && SourcesArea.transform-fit != "stretch";
                            selected(v) => { SourcesArea.transform-choose("align", v); }
                        }
                    }
                }
            }
        }

        // What it leaves out, in source pixels.
        VerticalLayout {
            spacing: 0;
            GroupHeading {
                title: "Crop";
            }
            RowGroup {
                GroupRow {
                    label: "Left and Right";
                    place: RowPlace.first;
                    enabled: root.live;
                    Centred {
                        TransformNumber {
                            field: "crop-left";
                            prefix: "L";
                            label: "Crop left";
                            unit: "px";
                            minimum: 0;
                            value: SourcesArea.crop-left;
                            enabled: root.live;
                        }
                    }
                    Centred {
                        TransformNumber {
                            field: "crop-right";
                            prefix: "R";
                            label: "Crop right";
                            unit: "px";
                            minimum: 0;
                            value: SourcesArea.crop-right;
                            enabled: root.live;
                        }
                    }
                }
                GroupRow {
                    label: "Top and Bottom";
                    place: RowPlace.last;
                    enabled: root.live;
                    Centred {
                        TransformNumber {
                            field: "crop-top";
                            prefix: "T";
                            label: "Crop top";
                            unit: "px";
                            minimum: 0;
                            value: SourcesArea.crop-top;
                            enabled: root.live;
                        }
                    }
                    Centred {
                        TransformNumber {
                            field: "crop-bottom";
                            prefix: "B";
                            label: "Crop bottom";
                            unit: "px";
                            minimum: 0;
                            value: SourcesArea.crop-bottom;
                            enabled: root.live;
                        }
                    }
                }
            }
        }

        // Isocast's item style.
        VerticalLayout {
            spacing: 0;
            GroupHeading {
                title: "Appearance";
            }
            RowGroup {
                GroupRow {
                    label: "Opacity";
                    place: RowPlace.first;
                    trailing-pad: 10px;
                    enabled: root.live;
                    Centred {
                        Slider {
                            width: 120px;
                            thin: true;
                            value: SourcesArea.transform-opacity;
                            minimum: 0;
                            maximum: 1;
                            label: "Opacity";
                            value-text: round(SourcesArea.transform-opacity * 100) + "%";
                            enabled: root.live;
                            moved(v) => { SourcesArea.transform-number("opacity", v, true); }
                            changed(v) => { SourcesArea.transform-number("opacity", v, false); }
                        }
                    }
                    // Paper's inspector: the value 12px after, 48px wide, in
                    // yellow Martian Mono.
                    Rectangle {
                        width: Theme.space-1;
                    }
                    Text {
                        width: 48px;
                        text: round(SourcesArea.transform-opacity * 100) + "%";
                        color: Theme.accent-text;
                        font-family: Theme.font-mono;
                        font-weight: Theme.weight-light;
                        font-size: Theme.fs-xs;
                        letter-spacing: Theme.tracking-mono;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        accessible-role: none;
                    }
                }
                GroupRow {
                    label: "Corner Radius";
                    enabled: root.live;
                    Centred {
                        TransformNumber {
                            field: "radius";
                            label: "Corner Radius";
                            unit: "px";
                            minimum: 0;
                            maximum: 2000;
                            value: SourcesArea.transform-radius;
                            enabled: root.live;
                        }
                    }
                }
                GroupRow {
                    label: "Border";
                    enabled: root.live;
                    if SourcesArea.has-border: Centred {
                        TransformNumber {
                            field: "border-width";
                            label: "Border width";
                            unit: "px";
                            minimum: 0;
                            maximum: 200;
                            value: SourcesArea.border-width;
                            enabled: root.live;
                        }
                    }
                    if SourcesArea.has-border: Centred {
                        ColorField {
                            width: Theme.field-s;
                            small: true;
                            value: SourcesArea.border-color;
                            swatch: SourcesArea.border-swatch;
                            label: "Border color";
                            enabled: root.live;
                            changed(text) => { SourcesArea.transform-color("border-color", text); }
                            pick => { SourcesArea.transform-pick-color("border-color", SourcesArea.border-color); }
                        }
                    }
                    if SourcesArea.has-border: RemoveButton {
                        enabled: root.live;
                        label: "No border";
                        clicked => { SourcesArea.transform-action("remove-border"); }
                    }
                    if !SourcesArea.has-border: AddButton {
                        enabled: root.live;
                        text: "Add a border";
                        clicked => { SourcesArea.transform-action("add-border"); }
                    }
                }
                GroupRow {
                    label: "Shadow";
                    enabled: root.live;
                    if SourcesArea.has-shadow: Centred {
                        TransformNumber {
                            field: "shadow-blur";
                            prefix: "Blur";
                            label: "Shadow blur";
                            unit: "px";
                            minimum: 0;
                            maximum: 500;
                            value: SourcesArea.shadow-blur;
                            enabled: root.live;
                        }
                    }
                    if SourcesArea.has-shadow: Centred {
                        ColorField {
                            width: Theme.field-s;
                            small: true;
                            value: SourcesArea.shadow-color;
                            swatch: SourcesArea.shadow-swatch;
                            label: "Shadow color";
                            enabled: root.live;
                            changed(text) => { SourcesArea.transform-color("shadow-color", text); }
                            pick => { SourcesArea.transform-pick-color("shadow-color", SourcesArea.shadow-color); }
                        }
                    }
                    if SourcesArea.has-shadow: RemoveButton {
                        enabled: root.live;
                        label: "No shadow";
                        clicked => { SourcesArea.transform-action("remove-shadow"); }
                    }
                    if !SourcesArea.has-shadow: AddButton {
                        enabled: root.live;
                        text: "Add a shadow";
                        clicked => { SourcesArea.transform-action("add-shadow"); }
                    }
                }
                GroupRow {
                    label: "Background";
                    place: RowPlace.last;
                    enabled: root.live;
                    if SourcesArea.has-background: Centred {
                        ColorField {
                            width: Theme.field-s;
                            small: true;
                            value: SourcesArea.background-color;
                            swatch: SourcesArea.background-swatch;
                            label: "Background color";
                            enabled: root.live;
                            changed(text) => { SourcesArea.transform-color("background-color", text); }
                            pick => { SourcesArea.transform-pick-color("background-color", SourcesArea.background-color); }
                        }
                    }
                    if SourcesArea.has-background: RemoveButton {
                        enabled: root.live;
                        label: "No background";
                        clicked => { SourcesArea.transform-action("remove-background"); }
                    }
                    if !SourcesArea.has-background: AddButton {
                        enabled: root.live;
                        text: "Add a background";
                        clicked => { SourcesArea.transform-action("add-background"); }
                    }
                }
            }
        }
    }
}
