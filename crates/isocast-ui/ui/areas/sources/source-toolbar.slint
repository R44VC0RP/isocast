// The source toolbar's part of the control bar (Paper "C. Console", Main
// window board; the web app's source-toolbar.js): on the left of the bar,
// the selected source's kind icon in yellow, its name and what the engine
// says it is ("1920×1080 · 30p · Stereo"), then the one setting people
// change most for its kind, as OBS's source toolbar has it (a display, a
// device, an app, the text, the colour; a file's or page's Browse or
// Refresh). With nothing selected: a dashed frame, "No source selected"
// and the scene being edited. Properties and Filters are the control
// bar's capsule (area C places both).

import { Theme } from "../../theme.slint";
import { Icon, Icons } from "../../icons.slint";
import { Ui } from "../../state.slint";
import { Button, ColorField, ControlSize, Dropdown, TextField, Tip } from "../../kit.slint";
import { SourcesArea } from "state.slint";

// A line of the slot: Mona Sans at a size, `text-3` unless told.
component Words inherits Text {
    color: Theme.text-3;
    font-size: Theme.fs-xs;
    letter-spacing: Theme.tracking-for(self.font-size);
    vertical-alignment: center;
    overflow: elide;
}

export component SelectedSource inherits Rectangle {
    // `SourcesArea.open-quick` changing opens the quick setting's list.
    property <int> open-quick: SourcesArea.open-quick;
    changed open-quick => {
        if SourcesArea.quick-kind == "choice" {
            quick.show-list();
        }
    }

    property <bool> selected: Ui.selected-item != "";
    property <string> kind: root.selected && SourcesArea.quick-label != "" ? SourcesArea.quick-kind : "";
    // What follows the name: the engine's word on the source, else its
    // kind; then a file's or page's name ("clip.mp4"), as OBS's source
    // toolbar shows it (the whole path in the tooltip and for screen
    // readers).
    property <string> file: root.kind == "path" ? SourcesArea.quick-text : "";
    property <string> meta: (Ui.selected-meta != "" ? Ui.selected-meta : Ui.selected-kind) + (root.file != "" ? " · " + root.file : "");

    min-width: 0px;
    accessible-role: groupbox;
    accessible-label: "Selected source";

    HorizontalLayout {
        spacing: Theme.bar-gap;
        alignment: start;

        VerticalLayout {
            alignment: center;
            Icon {
                path: root.selected ? Icons.named(Ui.selected-icon) : Icons.scene-none;
                color: root.selected ? Theme.accent-text : Theme.text-3;
                stroke-line-cap: root.selected ? LineCap.round : LineCap.butt;
            }
        }
        // The name and its line (Paper aligns them on their baselines: the
        // smaller line sits 1px lower).
        // The line after the name gives way first, then the name elides
        // (never wider than the slot, so it can't run under the readout
        // beside it, #108). With nothing selected, a slot too narrow for
        // "No source selected" (a window about 1000px wide) says "No
        // source", and only the dashed frame shows in the narrowest
        // (900px while recording). A name is whole in a tooltip when
        // shortened.
        name := Words {
            min-width: 0px;
            max-width: self.preferred-width;
            horizontal-stretch: 0;
            text: root.selected ? Ui.selected-name : root.width < 96px ? "" : root.width < 160px ? "No source" : "No source selected";
            color: root.selected ? Theme.text : Theme.text-3;
            font-size: Theme.fs;
            font-weight: root.selected ? Theme.weight-semibold : Theme.weight-medium;
            accessible-role: AccessibleRole.text;
            accessible-label: root.selected ? self.text : "No source selected";
            if root.selected && name.preferred-width > name.width + 0.5px: Tooltip {
                Tip { text: Ui.selected-name; }
            }
        }
        Rectangle {
            min-width: 0px;
            preferred-width: meta-text.preferred-width;
            max-width: meta-text.preferred-width;
            horizontal-stretch: 1;
            meta-text := Words {
                // Gone rather than a lone "…" when there's no room.
                visible: parent.width >= 32px;
                y: 1px;
                width: parent.width;
                height: parent.height;
                text: root.selected ? root.meta : Ui.scene-meta;
                accessible-role: AccessibleRole.text;
                accessible-label: self.text;
                accessible-description: root.kind == "path" ? SourcesArea.quick-tooltip : "";
            }
            // A file's or page's whole path.
            if root.kind == "path" && SourcesArea.quick-tooltip != "": Tooltip {
                Tip {
                    text: SourcesArea.quick-tooltip;
                }
            }
        }

        // A dropdown: a display, a device, an app.
        VerticalLayout {
            alignment: center;
            visible: root.kind == "choice";
            quick := Dropdown {
                preferred-width: root.kind == "choice" ? 200px : 0px;
                min-width: root.kind == "choice" ? 80px : 0px;
                max-width: root.kind == "choice" ? 200px : 0px;
                small: true;
                label: SourcesArea.quick-label;
                options: SourcesArea.quick-options;
                value: SourcesArea.quick-value;
                placeholder: "Choose…";
                selected(value) => { SourcesArea.quick-choose(value); }
            }
        }
        // A text source's words.
        if root.kind == "text": VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            min-width: 80px;
            max-width: 240px;
            TextField {
                small: true;
                text: SourcesArea.quick-text;
                label: SourcesArea.quick-label;
                committed(text) => { SourcesArea.quick-text-changed(text); }
            }
        }
        // A colour source's colour.
        if root.kind == "color": VerticalLayout {
            alignment: center;
            ColorField {
                width: 128px;
                height: Theme.control-h-sm;
                value: SourcesArea.quick-text;
                swatch: SourcesArea.quick-swatch;
                label: SourcesArea.quick-label;
                changed(text) => { SourcesArea.quick-text-changed(text); }
                pick => { SourcesArea.quick-pick-color(); }
            }
        }
        // A file's Browse, a page's Refresh.
        if root.kind != "" && SourcesArea.quick-button != "": VerticalLayout {
            alignment: center;
            Button {
                text: SourcesArea.quick-button;
                size: ControlSize.small;
                tooltip: SourcesArea.quick-button-tooltip;
                clicked => { SourcesArea.quick-button-clicked(); }
            }
        }
    }
}
