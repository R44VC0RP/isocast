// The Sources dock (Paper "C. Console", Main window board; the web app's
// sources.js): the items of the scene being edited, the front one at the
// top, as in OBS, groups' children under them (their chevron folds them).
// Each 30px pill row has the source's kind icon and name, its state, then
// a 40px ISO lane (the grey ISO badge while it records its own file; on
// hover a faint one to turn that on), eye (visible) and lock. A click
// selects (the canvas shows the box), double-click opens Properties, F2
// renames, a drag restacks; the toolbar's capsules add (a menu of kinds),
// remove and open Properties, and move the item; right-click opens the
// item's menu (away from the items: Add and Paste). Hovering a row
// outlines its item on the canvas.

import { Theme } from "../../theme.slint";
import { Icon, Icons } from "../../icons.slint";
import { Ui } from "../../state.slint";
import {
    Badge, Capsule, CapsuleButton, CapsuleDivider, Dock, DockToolbar, Dot, DropLine, FocusRing,
    IconButton, List, ListRow, Menus, TextField, Tip,
} from "../../kit.slint";
import { CanvasArea } from "../canvas/state.slint";
import { SourcesArea } from "state.slint";

// A row's ISO lane (Paper: 40px, the badge at its end): the grey ISO
// badge while the source records its own file; while the row is hovered
// (or the lane has keyboard focus) a faint one to turn that on. A click
// turns it on or off.
component IsoToggle inherits Rectangle {
    in property <bool> on;
    in property <bool> row-hovered;
    // A narrow dock: the lane is only as wide as its badge, and takes no
    // room while it shows nothing (ISO off, the row neither hovered nor
    // focused), so the name keeps it.
    in property <bool> collapsible;
    callback clicked();
    // A right-click or Control-click on the badge: its menu (recording the
    // file and its audio tracks), at the pointer.
    callback menu(length, length);

    forward-focus: fs;
    property <bool> keyboard;
    property <bool> lit: root.on || root.row-hovered || fs.has-focus;

    width: !root.collapsible ? Theme.lane : root.lit ? badge.preferred-width : 0px;
    accessible-role: button;
    accessible-label: root.on ? "Records its own ISO file; click to stop" : "Record its own ISO file";
    accessible-checkable: true;
    accessible-checked: root.on;
    accessible-action-default => { root.clicked(); }

    badge := Badge {
        x: parent.width - self.width;
        // Its own width (out of a layout an element takes its parent's).
        width: self.preferred-width;
        y: (parent.height - self.height) / 2;
        visible: root.lit;
        text: "ISO";
        opacity: root.on ? 1 : ta.has-hover ? 0.7 : Theme.disabled-opacity;
    }
    ta := TouchArea {
        property <bool> menu-press;
        x: badge.x;
        width: badge.width;
        clicked => {
            if !self.menu-press {
                root.clicked();
            }
        }
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                self.menu-press = event.button == PointerEventButton.left && event.modifiers.meta;
            }
            if event.kind == PointerEventKind.up && (event.button == PointerEventButton.right || (event.button == PointerEventButton.left && event.modifiers.meta)) {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
    fs := FocusScope {
        focus-on-click: false;
        focus-gained(reason) => { root.keyboard = reason == FocusReason.tab-navigation; }
        focus-lost => { root.keyboard = false; }
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" {
                root.clicked();
                return accept;
            }
            reject
        }
    }
    FocusRing {
        x: badge.x;
        y: badge.y;
        width: badge.width;
        height: badge.height;
        radius: badge.height / 2;
        shown: fs.has-focus && root.keyboard;
    }
    Tooltip {
        Tip { text: root.on ? "Records its own ISO file; click to stop" : "Record its own ISO file"; }
    }
}

export component SourcesDock inherits Dock {
    // Under this, rows without ISO give the lane's 40px to their names.
    property <bool> narrow: root.width < Theme.narrow-dock;
    property <int> current: -1;
    property <int> drag-from: -1;
    property <int> drop-at: -1;

    title: "Sources";

    list := List {
        label: "Sources";
        count: SourcesArea.items.length;
        empty-text: Ui.editing-scene == "" ? "No scene selected" : "No sources in this scene";
        empty-icon: Ui.editing-scene == "" ? Icons.empty-sources : Icons.empty-scene;
        current: root.current;
        navigate(index) => { Ui.select(SourcesArea.items[index].path); }
        unhandled-key(event) => {
            if event.text == Key.F2 && root.current >= 0 {
                SourcesArea.renaming-item = SourcesArea.items[root.current].path;
                return true;
            }
            if (event.text == Key.Backspace || event.text == Key.Delete) && root.current >= 0 {
                Ui.menu("remove");
                return true;
            }
            false
        }
        background-clicked => { Ui.select(""); }
        background-menu(x, y) => { Menus.request("sources:list", x, y, 0, 0); }

        for item[i] in SourcesArea.items: Rectangle {
            property <bool> chosen: item.path == Ui.selected-item;
            changed chosen => {
                if self.chosen {
                    root.current = i;
                } else if root.current == i {
                    root.current = -1;
                }
            }
            init => {
                if self.chosen {
                    root.current = i;
                }
            }
            // A hovered row outlines its item on the canvas, as the
            // canvas's own hover does.
            property <bool> hovered: row.has-hover;
            changed hovered => {
                if self.hovered {
                    CanvasArea.hover-item = item.path;
                } else if CanvasArea.hover-item == item.path {
                    CanvasArea.hover-item = "";
                }
            }
            height: Theme.row;

            row := ListRow {
                text: item.name;
                trailing-pad: Theme.space-1;
                icon: Icons.named(item.icon);
                selected: parent.chosen || item.marked;
                dim: !item.visible;
                depth: item.depth;
                description: item.state == "failed" || item.state == "waiting for permission" ? item.error : item.visible ? "" : "Hidden";
                index: i;
                count: SourcesArea.items.length;
                focus-shown: list.keyboard-focus && parent.chosen;
                draggable: SourcesArea.renaming-item == "";
                dragging: root.drag-from == i;
                clicked => {
                    list.focus-list();
                    if self.press-command || self.press-shift {
                        SourcesArea.mark-item(item.path, self.press-shift);
                    } else {
                        Ui.select(item.path);
                    }
                }
                double-clicked => {
                    if item.source != "" {
                        Ui.open-dialog("properties", item.source);
                    }
                }
                context-menu(x, y) => {
                    list.focus-list();
                    if !item.marked {
                        Ui.select(item.path);
                    }
                    Menus.request("sources:item:" + item.path, x, y, 0, 0);
                }
                drag-moved(y) => {
                    root.drag-from = i;
                    root.drop-at = max(0, min(SourcesArea.items.length, floor((i * Theme.row + y + Theme.row / 2) / Theme.row)));
                }
                drag-ended => {
                    if root.drop-at >= 0 && root.drop-at != root.drag-from && root.drop-at != root.drag-from + 1 {
                        SourcesArea.move-item(root.drag-from, root.drop-at);
                    }
                    root.drag-from = -1;
                    root.drop-at = -1;
                }

                if item.state == "failed" || item.state == "waiting for permission": Rectangle {
                    width: Theme.control-h-sm;
                    Icon {
                        path: Icons.warning;
                        size: Theme.icon-sm;
                        color: Theme.danger-text;
                    }
                    // Waiting for a permission: the warning opens the
                    // permissions step (area H) that allows it.
                    if item.state == "waiting for permission": TouchArea {
                        mouse-cursor: pointer;
                        clicked => { Ui.menu("permissions"); }
                    }
                    Tooltip {
                        Tip {
                            text: item.state == "waiting for permission" ? item.error + " Click to allow it." : item.error;
                        }
                    }
                }
                if item.state == "opening": Rectangle {
                    width: Theme.control-h-sm;
                    Dot {
                        width: 6px;
                        height: 6px;
                        pulse: true;
                    }
                    Tooltip {
                        Tip {
                            text: "Starting…";
                        }
                    }
                }
                if item.can-iso: IsoToggle {
                    on: item.iso;
                    row-hovered: row.has-hover;
                    collapsible: root.narrow;
                    clicked => { SourcesArea.toggle-iso(item.path); }
                    menu(x, y) => {
                        list.focus-list();
                        Menus.request("sources:iso:" + item.path, x, y, 0, 0);
                    }
                }
                if !item.can-iso: Rectangle {
                    width: root.narrow ? 0px : Theme.lane;
                }
                IconButton {
                    compact: true;
                    icon: item.visible ? Icons.eye : Icons.eye-off;
                    icon-size: Theme.icon-row;
                    rest-color: item.path == Ui.selected-item ? Theme.text-2 : Theme.text-3;
                    label: item.visible ? "Hide" : "Show";
                    toggle: true;
                    clicked => { SourcesArea.toggle-visible(item.path); }
                }
                // A narrow dock shows the lock only on locked rows (the
                // item's menu has Lock), so names keep the room.
                if !root.narrow || item.locked: IconButton {
                    compact: true;
                    icon: item.locked ? Icons.lock : Icons.unlock;
                    icon-size: Theme.icon-row;
                    rest-color: item.path == Ui.selected-item ? Theme.text-2 : Theme.text-3;
                    label: item.locked ? "Unlock" : "Lock";
                    on: item.locked;
                    on-color: Theme.text;
                    toggle: true;
                    clicked => { SourcesArea.toggle-locked(item.path); }
                }
            }

            // A group's chevron folds it away.
            if item.group: TouchArea {
                x: Theme.pane-x + item.depth * 16px;
                width: Theme.icon;
                mouse-cursor: pointer;
                clicked => { SourcesArea.toggle-group(item.path); }
                Tooltip {
                    Tip {
                        text: item.expanded ? "Fold it away" : "Show what’s in it";
                    }
                }
            }
            // A missing source says so; a name cut short (a narrow dock,
            // the ISO badge beside it) shows whole on hover.
            if item.missing || (row.elided && root.drag-from < 0 && SourcesArea.renaming-item != item.path): Tooltip {
                Tip {
                    text: item.missing ? "No source “" + item.name + "” in the setup" : item.name;
                }
            }

            if root.drop-at == i: DropLine {
                y: -1px;
            }
            if root.drop-at == SourcesArea.items.length && i == SourcesArea.items.length - 1: DropLine {
                y: parent.height - 1px;
            }

            if SourcesArea.renaming-item == item.path: TextField {
                x: Theme.pane-x + item.depth * 16px + Theme.icon + Theme.space-2 - 5px;
                y: (parent.height - self.height) / 2;
                width: parent.width - self.x - Theme.space-1;
                small: true;
                font-size: Theme.fs;
                text: item.name;
                label: "Name";
                submits: false;
                auto-focus: true;
                accepted(name) => {
                    SourcesArea.renaming-item = "";
                    SourcesArea.rename-item(item.path, name);
                }
                committed(name) => {
                    if SourcesArea.renaming-item == item.path {
                        SourcesArea.renaming-item = "";
                        SourcesArea.rename-item(item.path, name);
                    }
                }
                cancelled => { SourcesArea.renaming-item = ""; }
            }
        }
    }

    DockToolbar {
        alignment: space-between;
        Capsule {
            add := CapsuleButton {
                icon: Icons.plus;
                label: "Add a source";
                enabled: Ui.editing-scene != "";
                menu-open: Menus.open && Menus.owner == "sources:add";
                property <int> serial: SourcesArea.add-menu-serial;
                changed serial => {
                    if self.enabled {
                        self.clicked();
                    }
                }
                clicked => {
                    Menus.request("sources:add", self.absolute-position.x, self.absolute-position.y, self.width, self.height);
                }
            }
            CapsuleDivider { }
            CapsuleButton {
                icon: Icons.minus;
                label: "Remove the selected source";
                enabled: Ui.selected-item != "";
                clicked => { Ui.menu("remove"); }
            }
            CapsuleDivider { }
            CapsuleButton {
                icon: Icons.settings;
                label: "Properties of the selected source";
                enabled: Ui.selected-source != "";
                clicked => { Ui.menu("properties"); }
            }
        }
        Capsule {
            CapsuleButton {
                icon: Icons.chevron-up;
                label: "Move up";
                enabled: Ui.selected-item != "";
                clicked => { Ui.menu("order_up"); }
            }
            CapsuleDivider { }
            CapsuleButton {
                icon: Icons.chevron-down;
                label: "Move down";
                enabled: Ui.selected-item != "";
                clicked => { Ui.menu("order_down"); }
            }
        }
    }
}
