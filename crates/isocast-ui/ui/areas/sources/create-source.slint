// Create/Select Source (the web app's add-source.js), OBS's way, as a
// Console sheet (the kit gallery's sample): the kind's glyph, "Create/
// Select Source" and the kind and scene under it; a new source with a
// name, or one already in the setup (for a nested scene, a scene) from an
// inset list, and whether it starts visible. Audio sources play in every
// scene, so they are only made new. Rename (the mixer's and the menus')
// is here too: it is the same small shape, a sheet with one field.

import { Theme } from "../../theme.slint";
import { Icons } from "../../icons.slint";
import { Ui } from "../../state.slint";
import { Checkbox, Dialog, GroupHint, ListRow, PickList, Radio, TextField } from "../../kit.slint";
import { SourcesArea } from "state.slint";
import { KindGlyph } from "properties.slint";

// A sheet's body: 20px at the sides, controls 8px apart.
component SheetBody inherits VerticalLayout {
    padding-left: Theme.sheet-pad;
    padding-right: Theme.sheet-pad;
    spacing: Theme.space-2;
    alignment: start;
}

// What belongs to a choice above it: 24px in (past the radio's circle).
component Under inherits HorizontalLayout {
    padding-left: Theme.space-6;
}

export component CreateSourceDialog inherits Dialog {
    property <bool> fresh: SourcesArea.create-mode == "new";

    title: "Create/Select Source";
    subtitle: SourcesArea.create-heading;
    icon: KindGlyph.glyph(SourcesArea.create-icon);
    icon-accent: KindGlyph.accent(SourcesArea.create-icon);
    dialog-width: 440px;
    ok-enabled: root.fresh ? SourcesArea.create-name != "" && !SourcesArea.create-taken : SourcesArea.create-pick != "";
    accepted => { SourcesArea.create-accept(); }
    cancelled => { Ui.close-dialog(); }

    SheetBody {
        if !SourcesArea.create-is-scene: Radio {
            text: "Create new";
            checked: root.fresh;
            clicked => {
                SourcesArea.create-mode = "new";
                SourcesArea.create-changed();
            }
            step(by) => {
                if by > 0 && SourcesArea.create-existing.length > 0 {
                    SourcesArea.create-mode = "existing";
                    SourcesArea.create-changed();
                }
            }
        }
        if !SourcesArea.create-is-scene: Under {
            opacity: root.fresh ? 1 : Theme.disabled-opacity;
            TextField {
                text: SourcesArea.create-name;
                label: "Name";
                invalid: root.fresh && SourcesArea.create-taken;
                auto-focus: true;
                edited(text) => {
                    SourcesArea.create-name = text;
                    SourcesArea.create-mode = "new";
                    SourcesArea.create-changed();
                }
            }
        }
        if !SourcesArea.create-is-scene && root.fresh && SourcesArea.create-taken: Under {
            Text {
                text: "A source is already called that.";
                color: Theme.danger-text;
                font-size: Theme.fs-xs;
                letter-spacing: Theme.tracking-xs;
            }
        }
        if !SourcesArea.create-audio-only: Radio {
            text: "Add Existing";
            checked: !root.fresh;
            enabled: SourcesArea.create-existing.length > 0;
            clicked => {
                SourcesArea.create-mode = "existing";
                SourcesArea.create-changed();
            }
            step(by) => {
                if by < 0 && !SourcesArea.create-is-scene {
                    SourcesArea.create-mode = "new";
                    SourcesArea.create-changed();
                }
            }
        }
        if !SourcesArea.create-audio-only: Under {
            PickList {
                label: "Existing";
                enabled: !root.fresh || SourcesArea.create-is-scene;
                if SourcesArea.create-existing.length == 0: HorizontalLayout {
                    padding-left: Theme.list-inset + Theme.space-2;
                    Text {
                        height: Theme.row;
                        text: SourcesArea.create-empty;
                        color: Theme.text-3;
                        font-size: Theme.fs-sm;
                        letter-spacing: Theme.tracking-sm;
                        vertical-alignment: center;
                    }
                }
                for pick[i] in SourcesArea.create-existing: ListRow {
                    text: pick.label;
                    icon: Icons.named(SourcesArea.create-icon);
                    selected: pick.id == SourcesArea.create-pick;
                    index: i;
                    count: SourcesArea.create-existing.length;
                    clicked => {
                        SourcesArea.create-mode = "existing";
                        SourcesArea.create-pick = pick.id;
                        SourcesArea.create-changed();
                    }
                    double-clicked => {
                        SourcesArea.create-mode = "existing";
                        SourcesArea.create-pick = pick.id;
                        SourcesArea.create-accept();
                    }
                }
            }
        }
        if !SourcesArea.create-audio-only: Checkbox {
            text: "Make source visible";
            checked: SourcesArea.create-visible;
            toggled(on) => { SourcesArea.create-visible = on; }
        }
        if SourcesArea.create-audio-only: GroupHint {
            text: "Audio sources play in every scene; it goes in the Audio Mixer and the program mix.";
        }
    }
}

export component RenameDialog inherits Dialog {
    title: "Rename";
    subtitle: SourcesArea.rename-heading;
    icon: KindGlyph.glyph(SourcesArea.rename-icon);
    icon-accent: KindGlyph.accent(SourcesArea.rename-icon);
    dialog-width: 400px;
    ok-enabled: SourcesArea.rename-name != "";
    accepted => { SourcesArea.rename-accept(); }
    cancelled => { Ui.close-dialog(); }

    SheetBody {
        // Made after the dialog takes focus, so the field keeps it.
        if true: TextField {
            text: SourcesArea.rename-name;
            label: "Name";
            auto-focus: true;
            edited(text) => { SourcesArea.rename-name = text; }
        }
    }
}
