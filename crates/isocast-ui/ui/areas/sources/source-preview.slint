// A live picture of the source a sheet is about (Properties, Filters): the
// kit's PreviewWell (Paper's Properties sheet) with the source's format,
// name and picture, 20px in from the sheet's sides and 16px above what
// follows; or a note where there is no picture. The picture is the
// daemon's shared frames of that source (src/areas/sources/preview.rs).

import { Theme } from "../../theme.slint";
import { PreviewWell } from "../../kit.slint";
import { SourcesArea } from "state.slint";

export component SourcePreview inherits VerticalLayout {
    // The room for the picture under the viewer line (Paper: 288px).
    in property <length> area-height: 288px;
    in property <string> name;

    padding-left: Theme.sheet-pad;
    padding-right: Theme.sheet-pad;
    padding-bottom: Theme.space-4;

    PreviewWell {
        area-height: root.area-height;
        format: SourcesArea.preview-format;
        name: root.name;
        picture: SourcesArea.preview;
        picture-shown: SourcesArea.preview-shown;
        aspect: SourcesArea.preview-aspect;
        note: SourcesArea.preview-note;
    }
}
