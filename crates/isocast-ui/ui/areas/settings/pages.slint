        }
        GroupRow {
            label: "Balance Law";
            place: RowPlace.last;
            Centred {
                Dropdown {
                    width: Theme.field-l;
                    on-control: true;
                    options: SettingsArea.pan-laws;
                    value <=> SettingsArea.pan-law;
                    label: "Balance Law";
                    selected(value) => { SettingsArea.set-text("pan_law", value); }
                }
            }
            Rectangle {
                width: Theme.icon-button-xs;
            }
        }
    }
}

