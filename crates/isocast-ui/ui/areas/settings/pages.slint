    // destinations).
    SetGroup {
        title: "Canvases";
        hint: SettingsArea.canvas-rows.length == 0
            ? "More canvases go out beside the main one, each its own shape: 9:16 for Shorts, Reels and TikTok, 1:1 or 4:5 for feeds. Each records and streams on its own (Stream › Streams of)."
            : "Each canvas shows the main scene laid out for its shape (letterboxed until you edit its layout), or scenes of its own, and records and streams on its own: Stream › Streams of." + (SettingsArea.recording ? " Follow Main Scenes stays as it is while recording, so change it after you stop." : "");
        for row[i] in SettingsArea.canvas-rows: VerticalLayout {
            spacing: 1px;
            GroupRow {
                label: row.label;
                place: i == 0 ? RowPlace.first : RowPlace.middle;
                clickable: true;
                lead-icon: row.value == SettingsArea.edit-canvas ? Icons.chevron-down : Icons.chevron-right;
                expandable: true;
                expanded: row.value == SettingsArea.edit-canvas;
                description: row.detail;
                trailing-pad: Theme.space-3;
                clicked => { SettingsArea.set-text("canvas_pick", row.value == SettingsArea.edit-canvas ? "" : row.value); }
                Text {
                    text: row.detail;
                    color: Theme.text-3;
                    font-size: Theme.fs-sm;
                    letter-spacing: Theme.tracking-sm;
                    vertical-alignment: center;
                    accessible-role: none;
                }
            }
            if row.value == SettingsArea.edit-canvas: GroupRow {
                label: "Resolution";
                indent: Theme.space-4;
                Centred {
                    NumberField {
                        width: Theme.field-xs;
                        small: true;
                        prefix: "W";
                        value: SettingsArea.vertical-width;
                        minimum: 16;
                        maximum: 8192;
                        step: 2;
                        label: "Canvas width";
                        changed(value) => { SettingsArea.set-number("vertical_width", value); }
                    }
                }
                Centred {
                    NumberField {
                        width: Theme.field-xs;
                        small: true;
                        prefix: "H";
                        value: SettingsArea.vertical-height;
                        minimum: 16;
                        maximum: 8192;
                        step: 2;
                        label: "Canvas height";
                        changed(value) => { SettingsArea.set-number("vertical_height", value); }
                    }
                }
            }
            if row.value == SettingsArea.edit-canvas: GroupRow {
                label: "Frame Rate";
                indent: Theme.space-4;
                Centred {
                    Dropdown {
                        width: Theme.field-s;
                        on-control: true;
                        options: SettingsArea.canvas-fps-options;
                        value <=> SettingsArea.canvas-fps;
                        label: "Frame Rate";
                        selected(value) => { SettingsArea.set-text("canvas_fps", value); }
                    }
                }
            }
            if row.value == SettingsArea.edit-canvas: SwitchRow {
                label: "Follow Main Scenes";
                indent: Theme.space-4;
                enabled: !SettingsArea.recording;
                description: SettingsArea.recording ? "Changes once the recording stops" : "";
                on <=> SettingsArea.vertical-follow;
                toggled(on) => { SettingsArea.set-flag("vertical_follow", on); }
            }
            if row.value == SettingsArea.edit-canvas: SwitchRow {
                label: "Record This Canvas";
                indent: Theme.space-4;
                on <=> SettingsArea.vertical-record;
                toggled(on) => { SettingsArea.set-flag("vertical_record", on); }
            }
            if row.value == SettingsArea.edit-canvas: GroupRow {
                label: "Remove This Canvas";
                indent: Theme.space-4;
                Centred {
                    Button {
                        text: "Remove";
                        size: ControlSize.small;
                        on-control: true;
                        enabled: !SettingsArea.recording;
                        clicked => { SettingsArea.set-text("canvas_remove", row.value); }
                    }
                }
            }
        }
        GroupRow {
            label: "Add a Canvas";
            place: SettingsArea.canvas-rows.length == 0 ? RowPlace.only : RowPlace.last;
            lead-icon: Icons.plus;
            Centred {
                Dropdown {
                    width: Theme.field-m;
                    on-control: true;
                    show-detail: true;
                    options: SettingsArea.canvas-presets;
                    value: "";
                    placeholder: "Choose a shape…";
                    label: "Add a canvas";
                    selected(value) => { SettingsArea.set-text("canvas_add", value); }
                }
            }
        }
    }
}

// ---------- Hotkeys ----------

// A binding's chord: its keycaps (or "Record Shortcut"), a field you click
// to type a new one (Escape cancels), and ✕ to clear it.
component ChordField inherits Rectangle {
    in property <BindingRow> binding;
    in property <bool> enabled: true;
    property <bool> keyboard;
    width: Theme.field-m;
    height: Theme.control-h-sm;
    border-radius: Theme.r-compact;
    background: root.binding.recording ? Theme.control-active : hit.has-hover && root.enabled ? Theme.control-hover : Theme.control-active;
    border-width: root.binding.recording ? 1px : 0px;
    border-color: Theme.accent;
    accessible-role: button;
    accessible-label: root.binding.label + ": " + (root.binding.recording ? "type the new shortcut, Escape to cancel" : root.binding.chord != "" ? root.binding.chord : "no shortcut");
    accessible-description: root.binding.error != "" ? root.binding.error : root.binding.warning;
    accessible-action-default => { SettingsArea.record-binding(root.binding.key); }

    hit := TouchArea {
        enabled: root.enabled;
        clicked => {
            keys.focus();
            SettingsArea.record-binding(root.binding.key);
        }
    }
    keys := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        focus-gained(reason) => { root.keyboard = reason == FocusReason.tab-navigation; }
        focus-lost => {
            root.keyboard = false;
            if root.binding.recording {
                SettingsArea.cancel-binding();
            }
        }
        key-pressed(event) => {
            if !root.binding.recording && (event.text == " " || event.text == "\n") {
                SettingsArea.record-binding(root.binding.key);
                return accept;
            }
            reject
        }
    }
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: Theme.space-1;
        alignment: start;
        if root.binding.recording: Text {
            text: "Type a shortcut… (Esc cancels)";
            color: Theme.accent-text;
            font-size: Theme.fs-xs;
            letter-spacing: Theme.tracking-xs;
            vertical-alignment: center;
            overflow: elide;
        }
        if !root.binding.recording && root.binding.chord == "": Text {
            text: "Record Shortcut";
            color: Theme.text-3;
            font-size: Theme.fs-xs;
            letter-spacing: Theme.tracking-xs;
            vertical-alignment: center;
        }
        if !root.binding.recording: ShortcutKeys {
            keys: root.binding.caps;
            alignment: start;
        }
    }
    FocusRing {
        radius: Theme.r-compact;
        shown: keys.has-focus && root.keyboard;
    }
}

export component HotkeysPage inherits SetPage {
    GroupHint {
        text: SettingsArea.bindings-note != "" ? SettingsArea.bindings-note : PlatformText.engine-windows ? "Click a shortcut and type the keys. Windows or another app may reserve a shortcut; unavailable bindings are reported below. Changes apply at once to this profile." : "Click a shortcut and type the keys: they work everywhere (or, when macOS keeps a key for itself, while Isocast is in front). Changes apply at once to this profile.";
    }
    for warning in SettingsArea.bindings-warnings: Callout {
        kind: CalloutKind.info;
        message: warning;
    }
    for group in SettingsArea.bindings: SetGroup {
        title: group.title;
        for row[i] in group.rows: GroupRow {
            label: row.label;
            place: Rows.place(i, group.rows.length);
            tall: row.error != "" || row.warning != "";
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                HorizontalLayout {
                    spacing: Theme.space-1;
                    alignment: end;
                    ChordField {
                        binding: row;
                        enabled: !SettingsArea.bindings-busy;
                    }
                    VerticalLayout {
                        alignment: center;
                        IconButton {
                            compact: true;
                            icon: Icons.x;
                            label: "Clear the shortcut for " + row.label;
                            enabled: row.chord != "" && !SettingsArea.bindings-busy;
                            clicked => { SettingsArea.clear-binding(row.key); }
                        }
                    }
                }
                if row.error != "" || row.warning != "": Text {
                    width: Theme.field-m + Theme.control-h-sm + Theme.space-1;
                    text: row.error != "" ? row.error : row.warning;
                    color: row.error != "" ? Theme.danger-text : Theme.warning;
                    font-size: Theme.fs-xs;
                    letter-spacing: Theme.tracking-xs;
                    line-height-factor: Theme.leading-xs;
                    wrap: word-wrap;
                }
            }
        }
    }
    for group in SettingsArea.hotkeys: SetGroup {
        title: group.title;
        for row[i] in group.rows: GroupRow {
            label: row.what;
            place: Rows.place(i, group.rows.length);
            ShortcutKeys {
                keys: row.keys;
            }
        }
    }
}

// ---------- Advanced ----------

export component AdvancedPage inherits SetPage {
    SetGroup {
        title: "Automatically Reconnect";
        hint: SettingsArea.has-stream ? "When the connection drops, Isocast tries again after the delay, up to the maximum." : "Set up streaming (Stream) to change how it reconnects.";
        if SettingsArea.has-stream: SwitchRow {
            label: "Enable";
            place: RowPlace.first;
            on <=> SettingsArea.reconnect-on;
            toggled(on) => { SettingsArea.set-flag("reconnect", on); }
        }
        if SettingsArea.has-stream: GroupRow {
            label: "Retry Delay";
            enabled: SettingsArea.reconnect-on;
            Centred {
                Stepper {
                    value: SettingsArea.reconnect-delay;
                    minimum: 1;
                    maximum: 600;
                    unit: "s";
                    enabled: SettingsArea.reconnect-on;
                    label: "Retry Delay";
                    changed(value) => { SettingsArea.set-number("reconnect_delay", value); }
                }
            }
        }
        if SettingsArea.has-stream: GroupRow {
            label: "Maximum Retries";
            place: RowPlace.last;
            enabled: SettingsArea.reconnect-on;
            Centred {
                Stepper {
                    value: SettingsArea.reconnect-retries;
                    minimum: 1;
                    maximum: 1000;
                    enabled: SettingsArea.reconnect-on;
                    label: "Maximum Retries";
                    changed(value) => { SettingsArea.set-number("reconnect_retries", value); }
                }
            }
        }
    }
    // Automatic quality (the setup's `governor`, T.2): what Isocast may
    // lower for a while when this Mac can't keep up, and what it must
    // keep (pins). Never the program recording, a file's size or codec,
    // and ISO files only when the user allows ISO frame thinning.
    SetGroup {
        title: "Automatic Quality";
        hint: (SettingsArea.governor-now != "" ? "Now: " + SettingsArea.governor-now + "\n" : "")
            + "When this " + PlatformText.machine + " can't keep up, Isocast lowers the preview's refresh and the vertical frame rate, and the stream's bitrate when the upload falls behind, and puts them back once it can. It never lowers the program recording; ISO files stay at their requested frame rate unless you opt in below. "
            + "Allowing ISO frame thinning lets it also skip ISO pictures; skipped pictures are gone from those files for good. "
            + "What you keep is never lowered automatically, but the encoders' own overload protection can still drop frames, ISO first, to protect the program recording.";
        SwitchRow {
            label: "Adjust Automatically";
            place: RowPlace.first;
            on <=> SettingsArea.governor-on;
            toggled(on) => { SettingsArea.set-flag("governor", on); }
        }
        SwitchRow {
            label: "Keep Preview Refresh";
            enabled: SettingsArea.governor-on;
            on <=> SettingsArea.pin-preview;
            toggled(on) => { SettingsArea.set-flag("pin:preview.fps", on); }
        }
        if SettingsArea.vertical-on: SwitchRow {
            label: "Keep Vertical Frame Rate";
            enabled: SettingsArea.governor-on;
            on <=> SettingsArea.pin-vertical;
            toggled(on) => { SettingsArea.set-flag("pin:vertical.fps", on); }
        }
        if SettingsArea.has-stream: SwitchRow {
            label: "Keep Stream Bitrate";
            enabled: SettingsArea.governor-on;
            on <=> SettingsArea.pin-stream;
            toggled(on) => { SettingsArea.set-flag("pin:stream.video_bitrate_kbps", on); }
        }
        // Off by default: the user's choice, at the cost of ISO pictures.
        SwitchRow {
            label: "Allow ISO Frame Thinning";
            place: SettingsArea.iso-thinning ? RowPlace.middle : RowPlace.last;
            enabled: SettingsArea.governor-on;
            on <=> SettingsArea.iso-thinning;
            toggled(on) => { SettingsArea.set-flag("iso_thinning", on); }
        }
        // With thinning allowed, every ISO or chosen ones can still be kept.
        if SettingsArea.iso-thinning: SwitchRow {
            label: "Keep ISO Frame Rates";
            place: !SettingsArea.pin-iso && SettingsArea.pin-iso-sources.length > 0 ? RowPlace.middle : RowPlace.last;
            enabled: SettingsArea.governor-on;
            on <=> SettingsArea.pin-iso;
            toggled(on) => { SettingsArea.set-flag("pin:recording.iso.fps", on); }
        }
        // Or one ISO file's, while the others may be lowered.
        if SettingsArea.iso-thinning && !SettingsArea.pin-iso: VerticalLayout {
            spacing: 1px;
            for source[i] in SettingsArea.pin-iso-sources: SwitchRow {
                label: source.name;
                indent: Theme.space-4;
                place: i == SettingsArea.pin-iso-sources.length - 1 ? RowPlace.last : RowPlace.middle;
                enabled: SettingsArea.governor-on;
                on: source.on;
                toggled(on) => { SettingsArea.set-flag("pin:recording.iso.sources." + source.id + ".fps", on); }
            }
        }
    }
    // Developer mode (#47): the profile's; logs stay on this Mac.
    SetGroup {
        title: "Developer";
        hint: "Logs every engine call and debug messages, and frame timing each second while recording, in logs of their own (up to 200 MB) on this " + PlatformText.machine + ". Adds the Developer menu and the stats overlay.";
        SwitchRow {
            label: "Developer Mode";
            place: RowPlace.first;
            on <=> SettingsArea.developer-on;
            toggled(on) => { SettingsArea.set-flag("developer", on); }
        }
        SwitchRow {
            label: SettingsArea.developer-auto-off-label;
            place: RowPlace.last;
            enabled: SettingsArea.developer-on;
            on <=> SettingsArea.developer-auto-off;
            toggled(on) => { SettingsArea.set-flag("developer_auto_off", on); }
        }
    }
}
