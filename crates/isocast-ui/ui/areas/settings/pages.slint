            Centred {
                NumberField {
                    width: Theme.field-xs;
                    small: true;
                    prefix: "H";
                    value: SettingsArea.canvas-height;
                    minimum: 16;
                    maximum: 8192;
                    step: 2;
                    label: "Canvas height";
