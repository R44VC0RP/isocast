// Area D's full-window states (the web app's states.js; Paper's Welcome):
// starting or reaching isocastd, couldn't reach it, and Welcome (no setup
// yet) over the empty window. Brand moments: Hubot Sans titles, the mark,
// the idle readout.

import { Theme } from "../../theme.slint";
import { BrandMark, Icon, Icons } from "../../icons.slint";
import { Ui, ConnectionState, PlatformText } from "../../state.slint";
import { Button, ButtonVariant, ControlSize, LcdHero, Spinner } from "../../kit.slint";
import { SettingsArea } from "state.slint";

// A brand title: Hubot Sans 28/34 semibold, tracked −0.02em (Paper's
// Welcome).
component Display inherits Text {
    font-family: Theme.font-brand;
    font-size: Theme.fs-display;
    font-weight: Theme.weight-semibold;
    letter-spacing: Theme.tracking-display;
    line-height-factor: Theme.leading-display;
    color: Theme.text;
    horizontal-alignment: center;
    wrap: word-wrap;
    accessible-role: AccessibleRole.text;
}

// The line under a brand title: 13/20 `text-2`, centred (Paper's
// Welcome).
component Lead inherits Text {
    color: Theme.text-2;
    font-size: Theme.fs;
    letter-spacing: Theme.tracking;
    line-height-factor: Theme.leading-welcome;
    horizontal-alignment: center;
    wrap: word-wrap;
}

// The connecting and failed states: the whole area, the stage's colour.
export component ConnectingState inherits Rectangle {
    property <bool> failed: Ui.connection == ConnectionState.failed;
    background: Theme.surface-stage;
    TouchArea { }

    VerticalLayout {
        alignment: center;
        padding: Theme.space-8;
        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                width: min(520px, root.width - 2 * Theme.space-8);
                spacing: Theme.space-3;
                alignment: center;
                HorizontalLayout {
                    alignment: center;
                    padding-bottom: Theme.space-3;
                    BrandMark {
                        size: 56px;
                    }
                }
                Display {
                    text: root.failed ? "Isocast can’t reach its engine"
                        : Ui.connection == ConnectionState.disconnected ? "Reconnecting to the engine…"
                        : "Starting the engine…";
                }
                if !root.failed: HorizontalLayout {
                    alignment: center;
                    padding-top: Theme.space-2;
                    Spinner { }
                }
                if root.failed: Lead {
                    text: "The app talks to isocastd, which does the capturing and recording. It didn’t start or answer.";
                }
                if root.failed && Ui.connection-error != "": HorizontalLayout {
                    alignment: center;
                    padding-top: Theme.space-1;
                    Rectangle {
                        max-width: 520px;
                        preferred-width: detail.preferred-width + 2 * Theme.space-3;
                        height: detail.preferred-height + 2 * Theme.space-2;
                        background: Theme.surface-panel;
                        border-width: 1px;
                        border-color: Theme.line;
                        border-radius: Theme.r;
                        detail := Text {
                            x: Theme.space-3;
                            width: parent.width - 2 * Theme.space-3;
                            text: Ui.connection-error;
                            color: Theme.text-2;
                            font-family: Theme.font-mono;
                            font-size: Theme.fs-xs;
                            letter-spacing: Theme.tracking-xs;
                            line-height-factor: Theme.leading-xs;
                            wrap: word-wrap;
                        }
                    }
                }
                if root.failed: HorizontalLayout {
                    alignment: center;
                    padding-top: Theme.space-3;
                    Button {
                        text: "Try again";
                        variant: ButtonVariant.primary;
                        size: ControlSize.large;
                        clicked => { SettingsArea.retry(); }
                    }
                }
                if root.failed: Text {
                    text: "It keeps trying on its own, too.";
                    color: Theme.text-3;
                    font-size: Theme.fs-sm;
                    letter-spacing: Theme.tracking-sm;
                    horizontal-alignment: center;
                }
            }
        }
    }
}

// A way to start, in Welcome's row of three (Paper's Welcome): a 34px
// capsule button (the first the one yellow one) and two lines under it.
component Choice inherits VerticalLayout {
    in property <string> icon;
    in property <string> title;
    in property <string> hint;
    in property <bool> primary;
    // Its work is under way (a spinner under it).
    in property <bool> busy;
    in property <bool> enabled: true;
    callback clicked();

    width: 180px;
    spacing: 10px;
    Button {
        text: root.title;
        icon: root.icon;
        icon-size: 15px;
        variant: root.primary ? ButtonVariant.primary : ButtonVariant.secondary;
        size: ControlSize.large;
        capsule: true;
        font-weight: root.primary ? Theme.weight-semibold : Theme.weight-medium;
        enabled: root.enabled;
        // Its title is its name; the two lines under it describe it.
        accessible-name: root.title;
        accessible-description: root.hint;
        clicked => { root.clicked(); }
    }
    Text {
        text: root.hint;
        color: Theme.text-3;
        font-size: Theme.fs-xs;
        letter-spacing: Theme.tracking-xs;
        line-height-factor: Theme.leading-xs;
        horizontal-alignment: center;
        wrap: word-wrap;
        accessible-role: none;
    }
    if root.busy: HorizontalLayout {
        alignment: center;
        Spinner { }
    }
}

// Welcome: no setup yet. A sheet over the empty window (as OBS opens its
// Auto-Configuration Wizard), 120px down: the idle readout, the brand
// title and its line, and the ways to start.
export component Welcome inherits Rectangle {
    property <bool> busy: SettingsArea.welcome-busy != "";
    background: Theme.scrim;
    TouchArea { }

    card := Rectangle {
        width: min(640px, root.width - 2 * Theme.space-5);
        height: column.preferred-height + 2px;
        x: (root.width - self.width) / 2;
        y: max(Theme.space-5, min(Theme.welcome-top, root.height - self.height - Theme.space-5));
        background: Theme.surface-overlay;
        border-width: 1px;
        border-color: Theme.line-strong;
        border-radius: Theme.r-panel;
        drop-shadow-color: Theme.shadow-sheet-color;
        drop-shadow-blur: Theme.shadow-sheet-blur;
        drop-shadow-offset-y: Theme.shadow-sheet-y;
        accessible-role: groupbox;
        accessible-label: "Set up your first scene";

        column := VerticalLayout {
            // Inside the 1px edge (and as tall as the card less it: a layout
            // left to fill the card would get 2px to share out), padded
            // as Paper's border-box is.
            x: 1px;
            y: 1px;
            width: parent.width - 2px;
            height: parent.height - 2px;
            padding-top: 36px;
            padding-bottom: Theme.space-8;
            padding-left: Theme.space-8;
            padding-right: Theme.space-8;
            spacing: 0;
            HorizontalLayout {
                alignment: center;
                LcdHero {
                    lead: "00:00:00";
                    label: "REC TIME";
                }
            }
            VerticalLayout {
                padding-top: 28px;
                spacing: Theme.space-2;
                Display {
                    text: "Set up your first scene";
                }
                HorizontalLayout {
                    alignment: center;
                    Lead {
                        // Paper's 460px column, whose first line ("…all on
                        // one clock.") WebKit sets in 459.5px; Skia's is a
                        // pixel or two wider, so 10px more keeps Paper's
                        // line breaks (the lines are centred either way).
                        width: min(460px + 10px, root.width - 2 * Theme.space-8);
                        text: "Isocast records the program and every source to its own file, all on one clock. Start from this " + PlatformText.machine + ", or bring what you have.";
                    }
                }
            }
            HorizontalLayout {
                padding-top: 28px;
                spacing: Theme.space-3;
                alignment: center;
                Choice {
                    icon: Icons.monitor;
                    title: "Start with this " + PlatformText.machine;
                    hint: "Pick your screen, camera and mic; get three scenes, ready to record.";
                    primary: true;
                    enabled: !root.busy;
                    clicked => { SettingsArea.start-with-this-mac(); }
                }
                Choice {
                    icon: Icons.download;
                    title: "Import from OBS…";
                    hint: "A scene collection (.json)\nfrom OBS Studio.";
                    busy: SettingsArea.welcome-busy == "obs";
                    enabled: !root.busy;
                    clicked => { SettingsArea.import-obs(); }
                }
                Choice {
                    icon: Icons.folder;
                    title: "Open a Setup…";
                    hint: "An Isocast setup file\n(.toml or .json).";
                    busy: SettingsArea.welcome-busy == "file";
                    enabled: !root.busy;
                    clicked => { SettingsArea.open-setup-file(); }
                }
            }
        }
    }
}
