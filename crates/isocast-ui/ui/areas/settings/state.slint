// Area D: Settings (every tab), the first run, Welcome, the connecting and
// failed states, and About. src/areas/settings.rs fills this.
//
// Settings edits a draft of the live setup's name, canvas, recording,
// audio and stream (and this viewer's snapping and preview rate); every
// control shows the draft and changes it through `set-text`,
// `set-number` or `set-flag` with the field's name (settings.rs maps the
// names to the setup). Apply (or OK) sends what changed as one patch.

import { DropdownOption, NavTab } from "../../kit.slint";

// A streaming service to choose (Stream, before streaming is set up).
export struct ServiceChoice {
    id: string,
    label: string,
    hint: string,
}

// A video source the ISO files can record (Output → ISO Recording).
export struct IsoChoice {
    id: string,
    name: string,
    on: bool,
}

// An Audio Input Capture source and its device (Audio → Audio Devices).
export struct MicRow {
    id: string,
    name: string,
    value: string,
    options: [DropdownOption],
}

// Hotkeys: what a key does and its keys ("–" between two is a range).
export struct HotkeyRow {
    what: string,
    keys: [string],
}

export struct HotkeyGroup {
    title: string,
    rows: [HotkeyRow],
}

// A profile hotkey (docs/hotkeys.md): what it does, its chord (`chord`,
// "ctrl+alt+cmd+r", and as keycaps), the API's refusal of the last change
// (`error`, red) or the OS's warning (`warning`), and whether it is being
// recorded. `key` names the row for the Rust side.
export struct BindingRow {
    key: string,
    label: string,
    chord: string,
    caps: [string],
    error: string,
    warning: string,
    recording: bool,
}

export struct BindingGroup {
    title: string,
    rows: [BindingRow],
}

// Report a Bug: a file the zip holds, and its size ("4.1 KB").
export struct ReportFileRow {
    name: string,
    size: string,
}

// First run: a permission and where it stands.
export struct PermissionRow {
    id: string,
    icon: string,
    title: string,
    hint: string,
    // What to do, if it isn't allowed ("" when nothing).
    todo: string,
    // The engine restarts to pick it up (a link after `todo`).
    restart: bool,
    state: string,
    granted: bool,
    denied: bool,
    // "Open Settings" is the way to allow it.
    open-settings: bool,
}

// First run: one choice of a device column.
export struct DeviceChoice {
    value: string,
    title: string,
    meta: string,
    disabled: bool,
}

export global SettingsArea {
    // ---- The Settings dialog
    // Settings' pages, and the one showing.
    in-out property <[NavTab]> tabs;
    in-out property <string> tab: "output";
    // The page's header: its name, one line of what it is for, and its
    // glyph (by name).
    in-out property <string> page-title;
    in-out property <string> page-about;
    in-out property <string> page-icon;
    // A note at the top of Stream (why it opened: "Add your stream key
    // first."), until the stream is ready.
    in-out property <string> notice;
    // There is a live setup to change (else the page says to make one).
    in-out property <bool> has-draft;
    // The draft differs from the live setup (or the viewer's settings
    // changed): Apply is enabled.
    in-out property <bool> dirty;
    // Apply is under way.
    in-out property <bool> applying;
    callback apply();
    callback ok();
    callback cancel();
    callback tab-chosen(string);
    // A group's reset glyph: put its fields back as saved ("recording",
    // "program", "iso").
    callback revert-group(string);
    // The sheet's summary (Paper's Settings footer): the canvas ("1920×1080
    // | 30 fps"), the program's sound ("Stereo 48 kHz") and its files
    // ("H.264 · MOV"), from the draft.
    in-out property <string> summary-video;
    in-out property <string> summary-audio;
    in-out property <string> summary-codec;
    // How fast the program file fills the disk at most ("~4.3 GB/h": the
    // estimate the free-space check uses), "" when no program is recorded.
    in-out property <string> summary-rate;
    // The recording folder's disk ("212 GB free"), the summary's badge;
    // "" when the engine hasn't said.
    in-out property <string> summary-free;

    // A field of the draft changed, by its name (settings.rs: FIELDS).
    callback set-text(string, string);
    callback set-number(string, float);
    callback set-flag(string, bool);

    // ---- General
    in-out property <string> name;
    // The file the daemon keeps the live setup in ("" if it says none).
    in-out property <string> setup-file;
    in-out property <bool> snapping;
    in-out property <float> snap-distance;
    in-out property <string> preview-rate;

    // ---- Stream
    in-out property <bool> has-stream;
    in-out property <[ServiceChoice]> services;
    // Custom and Kick need a server first: which one is asking ("" for
    // none).
    in-out property <string> needs-server;
    // Streaming now (changes apply next time; it can't be turned off).
    in-out property <bool> stream-live;
    in-out property <string> service;
    in-out property <string> server;
    in-out property <string> server-placeholder;
    in-out property <string> server-hint;
    // A key is kept in the Keychain for this service.
    in-out property <bool> key-saved;
    in-out property <bool> key-busy;
    in-out property <float> video-bitrate;
    in-out property <string> rate-control;
    in-out property <string> audio-bitrate;
    in-out property <float> keyframe-interval;
    // The stream has its own size (else the canvas, scaled to fit 1080p).
    in-out property <bool> stream-custom-size;
    in-out property <float> stream-width;
    in-out property <float> stream-height;
    callback choose-service(string);
    callback server-chosen(string);
    // A server address the setup can use (rtmp:// or rtmps://, host and
    // app).
    pure callback server-valid(string) -> bool;
    callback server-back();
    callback save-key(string);
    callback clear-key();

    // ---- Output
    in-out property <string> folder;
    // The same shortened in the middle, for the field at rest.
    in property <string> folder-short;
    // Recording Quality: the stop it is exactly (-1: Custom: none of the
    // segments is chosen), and whether it can be chosen (not for ProRes).
    in-out property <int> quality-stop: 2;
    // Where a Custom quality sits among the stops (1.5: between Medium and
    // High), so → and ← go to the next stop that way.
    in-out property <float> quality-position: -1;
    in-out property <bool> quality-disabled;
    // Output's Advanced disclosure (each one's quality number) is open.
    in-out property <bool> quality-advanced;
    // The Advanced row's "Quality value" ("60"; "60 · ISO 50" when they
    // differ; "Fixed" for ProRes).
    in-out property <string> quality-value;
    in-out property <float> program-quality;
    in-out property <float> iso-quality;
    in-out property <float> keep-free;
    in-out property <bool> program-on;
    in-out property <string> program-codec;
    in-out property <string> program-container;
    in-out property <string> program-depth;
    in-out property <bool> program-shows-depth;
    in-out property <bool> iso-on;
    in-out property <[IsoChoice]> iso-sources;
    in-out property <string> iso-codec;
    in-out property <string> iso-container;
    in-out property <string> iso-depth;
    in-out property <bool> iso-shows-depth;
    in-out property <bool> iso-filtered;
    in-out property <[DropdownOption]> codecs;
    callback browse-folder();
    callback choose-quality(int);
    callback set-iso-source(string, bool);

    // ---- Audio
    in-out property <[MicRow]> mics;
    in-out property <string> monitoring-device;
    in-out property <[DropdownOption]> outputs;
    in-out property <string> pan-law;
    in-out property <[DropdownOption]> pan-laws;
    // Looking for devices again.
    in-out property <bool> looking;
    callback set-mic(string, string);
    callback refresh-devices();

    // ---- Video
    in-out property <string> canvas-size;
    in-out property <[DropdownOption]> canvas-sizes;
    in-out property <float> canvas-width;
    in-out property <float> canvas-height;
    in-out property <string> fps;
    in-out property <[DropdownOption]> fps-options;

    // ---- Hotkeys: the profile's bindings by action group (they apply at
    // once, through hotkeys_set), then Isocast's fixed keys.
    in-out property <[BindingGroup]> bindings;
    // Loading, or why the bindings can't be shown; the profile's own
    // warnings (disabled entries, Input Monitoring for media keys).
    in-out property <string> bindings-note;
    in-out property <[string]> bindings-warnings;
    // A change is on its way.
    in-out property <bool> bindings-busy;
    in-out property <[HotkeyGroup]> hotkeys;
    // Record a chord for the row, clear it, stop recording.
    callback record-binding(string);
    callback clear-binding(string);
    callback cancel-binding();

    // ---- Help > Report a Bug… (dialog "bug-report"): what happened, the
    // report's ISSUE.md (summary and triage block) and its files exactly
    // as they will be shared, then the zip once written. Nothing is sent.
    in-out property <string> report-describe;
    // ISSUE.md as it is (for screen readers), wrapped to the well's 84
    // columns, and its line count.
    in-out property <string> report-issue-text;
    in-out property <string> report-issue;
    in-out property <int> report-issue-lines;
    in-out property <[ReportFileRow]> report-files;
    in-out property <string> report-files-summary;
    in-out property <string> report-archive;
    in-out property <bool> report-busy;
    in-out property <string> report-error;
    callback report-preview();
    callback report-create();
    callback report-open-issue();
    callback report-reveal();

    // ---- Advanced
    in-out property <bool> reconnect-on;
    in-out property <float> reconnect-delay;
    in-out property <float> reconnect-retries;

    // ---- Welcome (no setup yet) and the failed state
    // Which choice is working ("obs", "file"; "" for none).
    in-out property <string> welcome-busy;
    callback start-with-this-mac();
    callback open-setup-file();
    callback import-obs();
    callback retry();

    // ---- The first run (Ui.onboarding shows it)
    in-out property <int> step;
    // A live setup exists: the first run can be closed.
    in-out property <bool> can-close;
    in-out property <bool> creating;
    // Permissions: read at least once, and asking now.
    in-out property <bool> checked;
    in-out property <bool> asking;
    in-out property <bool> any-to-ask;
    in-out property <[PermissionRow]> permissions;
    // Devices: listed at least once.
    in-out property <bool> devices-listed;
    in-out property <[DeviceChoice]> displays;
    in-out property <string> displays-empty;
    in-out property <[DeviceChoice]> cameras;
    in-out property <[DeviceChoice]> microphones;
    in-out property <string> display;
    in-out property <string> camera;
    in-out property <string> microphone;
    in-out property <bool> system-audio: true;
    // Layout.
    in-out property <string> layout: "bottom_right";
    in-out property <string> ob-canvas: "1920x1080";
    in-out property <string> ob-fps: "60";
    in-out property <string> ob-folder: "~/Movies/Isocast";
    in-out property <string> ob-name: "My setup";
    callback ob-close();
    callback ob-back();
    callback ob-next();
    callback ob-create();
    callback ob-ask();
    callback ob-check();
    callback ob-restart-engine();
    callback ob-open-settings(string);
    // A choice: the field ("display", "camera", "microphone",
    // "system_audio", "layout", "canvas", "fps", "folder", "name") and
    // its value.
    callback ob-set(string, string);
    callback ob-browse();
}
