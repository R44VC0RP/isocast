// Area D's dialogs: Settings ("settings", arg: the tab) and About Isocast
// ("about", with the About Slint notice the royalty-free licence asks
// for). Put on the window by app.slint.
//
// Settings is Paper's Settings sheet: the macOS sidebar list the sheet's
// full height (Recording: Output, Video, Audio; Broadcast: Stream;
// System: General, Hotkeys, Advanced), and beside it the page's header
// (its glyph, its name, one line of what it is for), the page's grouped
// rows, the summary of what the settings make, and Cancel, Apply, OK.

import { AboutSlint } from "std-widgets.slint";
import { Theme } from "../../theme.slint";
import { BrandMark, Icons } from "../../icons.slint";
import { Ui } from "../../state.slint";
import { Callout, CalloutKind, Dialog, DialogFooter, GroupHint, NavList, ScrollArea, SheetHeader, SheetSummary } from "../../kit.slint";
import { SettingsArea } from "state.slint";
import { SetPage } from "parts.slint";
import { AdvancedPage, AudioPage, GeneralPage, HotkeysPage, OutputPage, StreamPage, VideoPage } from "pages.slint";
import { BugReportDialog } from "report.slint";

export component SettingsDialogs inherits Rectangle {
    in property <string> version;

    if Ui.dialog == "settings": Dialog {
        title: "Settings";
        header: false;
        footer: false;
        // The page's header (20 + 40 + 16) moves the sheet.
        drag-height: 76px;
        dialog-width: 860px;
        dialog-height: 644px;
        // Return and Escape (the footer below has the buttons).
        ok-text: "OK";
        ok-enabled: !SettingsArea.applying;
        accepted => { SettingsArea.ok(); }
        cancelled => { SettingsArea.cancel(); }

        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 0;
            NavList {
                label: "Settings";
                tabs: SettingsArea.tabs;
                current <=> SettingsArea.tab;
                selected(id) => {
                    pages.scroll-to-top();
                    SettingsArea.tab-chosen(id);
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 0;
                SheetHeader {
                    inset: Theme.sheet-pad-wide;
                    title: SettingsArea.page-title;
                    subtitle: SettingsArea.page-about;
                    icon: Icons.named(SettingsArea.page-icon);
                    icon-accent: SettingsArea.page-icon == "drive" ? Icons.drive-led : "";
                }
                // A refused Apply or OK says why here: its toast would sit
                // behind the sheet.
                if SettingsArea.refused != "": HorizontalLayout {
                    padding-left: Theme.sheet-pad-wide;
                    padding-right: Theme.sheet-pad-wide;
                    padding-bottom: Theme.space-3;
                    Callout {
                        kind: CalloutKind.error;
                        title: "Couldn’t apply the change";
                        message: SettingsArea.refused;
                    }
                }
                pages := ScrollArea {
                    vertical-stretch: 1;
                    if !SettingsArea.has-draft: SetPage {
                        GroupHint {
                            text: "Set up your first scene to change its settings.";
                        }
                    }
                    if SettingsArea.has-draft && SettingsArea.tab == "general": GeneralPage { }
                    if SettingsArea.has-draft && SettingsArea.tab == "stream": StreamPage { }
                    if SettingsArea.has-draft && SettingsArea.tab == "output": OutputPage { }
                    if SettingsArea.has-draft && SettingsArea.tab == "audio": AudioPage { }
                    if SettingsArea.has-draft && SettingsArea.tab == "video": VideoPage { }
                    if SettingsArea.has-draft && SettingsArea.tab == "hotkeys": HotkeysPage { }
                    if SettingsArea.has-draft && SettingsArea.tab == "advanced": AdvancedPage { }
                }
                if SettingsArea.has-draft: SheetSummary {
                    // The rate is the program file's (none when only ISO
                    // files are recorded).
                    items: SettingsArea.summary-rate != "" ? [
                        { icon: "frame", text: SettingsArea.summary-video },
                        { icon: "volume-low", text: SettingsArea.summary-audio },
                        { icon: "codec", text: SettingsArea.summary-codec },
                        { icon: "clock", text: SettingsArea.summary-rate },
                    ] : [
                        { icon: "frame", text: SettingsArea.summary-video },
                        { icon: "volume-low", text: SettingsArea.summary-audio },
                        { icon: "codec", text: SettingsArea.summary-codec },
                    ];
                    badge-icon: "drive";
                    badge: SettingsArea.summary-free;
                }
                DialogFooter {
                    inset: Theme.sheet-pad-wide;
                    pad-top: SettingsArea.has-draft ? Theme.space-1 : Theme.space-5;
                    ok-text: "OK";
                    ok-enabled: !SettingsArea.applying;
                    cancel-text: "Cancel";
                    apply-text: "Apply";
                    apply-enabled: SettingsArea.dirty && !SettingsArea.applying;
                    ok => { SettingsArea.ok(); }
                    cancel => { SettingsArea.cancel(); }
                    apply => { SettingsArea.apply(); }
                }
            }
        }
    }

    if Ui.dialog == "bug-report": BugReportDialog { }

    if Ui.dialog == "about": Dialog {
        title: "About Isocast";
        subtitle: "Version " + root.version + " · MIT OR Apache-2.0";
        dialog-width: 460px;
        ok-text: "OK";
        cancel-text: "";
        accepted => { Ui.close-dialog(); }
        cancelled => { Ui.close-dialog(); }

        VerticalLayout {
            padding-left: Theme.sheet-pad;
            padding-right: Theme.sheet-pad;
            spacing: Theme.space-4;

            HorizontalLayout {
                spacing: Theme.space-3;
                VerticalLayout {
                    alignment: start;
                    BrandMark {
                        size: Theme.glyph;
                    }
                }
                Text {
                    horizontal-stretch: 1;
                    text: "Scenes and sources, an ISO file per source, and full control from the command line and MCP.";
                    color: Theme.text-2;
                    font-size: Theme.fs;
                    letter-spacing: Theme.tracking;
                    line-height-factor: Theme.leading;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }
            GroupHint {
                text: "The interface is built with Slint, used under its royalty-free licence:";
            }
            AboutSlint {
                height: 110px;
            }
        }
    }
}
