// The Scene Transitions dock (docs/design.md 3.21): the transition (one
// per setup, so no + or −; scenes can override it), its properties gear
// (none for Cut and Fade), and its duration in ms (disabled for Cut, and
// for a Stinger, which lasts as long as its video).

import { Theme } from "../../theme.slint";
import { Icons } from "../../icons.slint";
import { Ui } from "../../state.slint";
import { Dock, Dropdown, IconButton, NumberField, Tip } from "../../kit.slint";
import { ControlsArea } from "state.slint";

export component TransitionsDock inherits Dock {
    title: "Scene Transitions";

    // Empty until there is a setup (the web app's Welcome).
    if Ui.has-setup: VerticalLayout {
        vertical-stretch: 1;
        padding-top: Theme.space-2;
        padding-bottom: Theme.space-2;
        padding-left: Theme.pane-x;
        padding-right: Theme.pane-x;
        spacing: Theme.space-2;
        alignment: start;

        HorizontalLayout {
            spacing: Theme.space-2;
            Dropdown {
                horizontal-stretch: 1;
                min-width: 60px;
                label: "Transition";
                options: ControlsArea.transitions;
                value: ControlsArea.transition;
                enabled: Ui.has-setup;
                selected(value) => { ControlsArea.choose-transition(value); }
            }
            // A full 28px icon button beside the 28px dropdown (3.17).
            IconButton {
                icon: Icons.settings;
                label: "Transition properties";
                enabled: Ui.has-setup && ControlsArea.has-properties;
                clicked => { Ui.open-dialog("transition", ControlsArea.transition); }
            }
        }
        HorizontalLayout {
            spacing: Theme.space-2;
            Text {
                width: 64px;
                text: "Duration";
                color: ControlsArea.has-duration ? Theme.text-2 : Theme.text-disabled;
                font-size: Theme.fs-sm;
                letter-spacing: Theme.tracking-sm;
                vertical-alignment: center;
            }
            // Its tooltip says what it is for (a stinger's length is its
            // video's).
            Rectangle {
                horizontal-stretch: 1;
                min-width: 56px;
                height: Theme.control-h;
                HorizontalLayout {
                    NumberField {
                        horizontal-stretch: 1;
                        max-width: 10000px;
                        label: "Duration";
                        value: ControlsArea.duration-ms;
                        unit: "ms";
                        minimum: 0;
                        maximum: 10000;
                        step: 50;
                        enabled: ControlsArea.has-duration && Ui.has-setup;
                        changed(value) => { ControlsArea.set-duration(round(value)); }
                    }
                }
                Tooltip {
                    Tip { text: ControlsArea.duration-tooltip; }
                }
            }
        }
    }
}
