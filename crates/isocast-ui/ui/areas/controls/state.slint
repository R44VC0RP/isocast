// Area C: the Controls dock, the Scene Transitions dock, Studio Mode's
// column, the status bar, and the recording and streaming states (their
// details popovers, drop toasts). src/areas/controls.rs fills this.

import { DropdownOption, FormGroup, ToastRow } from "../../kit.slint";

// One file of the take, in the REC details.
export struct FileRow {
    name: string,
    frames: string,
    dropped: string,
    dropped-bad: bool,
    gaps: string,
    gaps-warn: bool,
}

export global ControlsArea {
    // ---- Recording and streaming
    // idle, starting, recording, stopping
    in property <string> record-state: "idle";
    // offline, connecting, live, reconnecting, failed
    in property <string> stream-state: "offline";
    in property <bool> busy-record;
    in property <bool> busy-stream;

    // ---- Pause (G.3): the take is paused (its files stay open, its time
    // stands still); how long this pause has lasted ("00:00:12"); the
    // pauses of this take, for the REC details (label "Paused at
    // 00:01:23", value "12 s" or "now").
    in property <bool> paused;
    in property <bool> busy-pause;
    in property <string> pause-time: "00:00:00";
    in property <[ToastRow]> pauses;

    // ---- The virtual camera (G.1): stopped, starting, running, stopping,
    // failed. Its output (the setup's `virtual_camera`) is chosen in its
    // popover beside the Controls dock's button.
    in property <string> vcam-state: "stopped";
    in property <bool> busy-vcam;
    // The camera extension isn't installed or approved (its last start
    // said so): the button explains how to install it, never installs.
    in property <bool> vcam-missing;
    // A release build asked macOS to activate its camera extension and is
    // waiting for the user to allow it in System Settings; the camera
    // starts by itself when they do.
    in property <bool> vcam-approval;
    // Why the last start failed, when it isn't that ("" for none).
    in property <string> vcam-error;
    // Why Start can't be used, before any start ("" when it can): Windows
    // has no camera yet; a Linux engine's v4l2loopback device is missing,
    // not writable or busy (the engine's own words).
    in property <string> vcam-unavailable;
    // The engine's other words about the camera, one per line ("" for
    // none): its Linux device is writable; Automatic Quality holds it or
    // reduces its frame rate.
    in property <string> vcam-note;
    // The engine carries the camera extension (the release app), so the
    // popover offers Remove Virtual Camera; removing: waiting for macOS.
    in property <bool> vcam-removable;
    in property <bool> vcam-removing;
    // program, preview, scene, source; the scene's or source's id; the
    // size ("" for the canvas's, else "1920x1080").
    in property <[DropdownOption]> vcam-targets;
    in property <string> vcam-target: "program";
    in property <[DropdownOption]> vcam-scenes;
    in property <string> vcam-scene;
    in property <[DropdownOption]> vcam-sources;
    in property <string> vcam-source;
    in property <[DropdownOption]> vcam-sizes;
    in property <string> vcam-size;
    // "1920×1080 at 30 fps": what it sends, or would send.
    in property <string> vcam-format;
    // "1,204 frames sent · 0 dropped" while it runs, else "".
    in property <string> vcam-counts;
    // Opens the popover from Rust when it changes (a start that found no
    // extension).
    in property <int> vcam-details-serial;

    // ---- The replay buffer (G.2): off, starting, running, stopping,
    // failed. Save Replay writes its last seconds to a file.
    in property <string> replay-state: "off";
    in property <bool> busy-replay;
    in property <bool> saving-replay;
    // "the last 30 s" (its length as set), for its words.
    in property <string> replay-length: "the last 30 s";
    // "12.4 s held · 18 MB" while it runs, else "".
    in property <string> replay-counts;

    // ---- Scene Transitions
    in property <[DropdownOption]> transitions;
    in property <string> transition: "cut";
    in property <int> duration-ms: 300;
    // Cut and Stinger have no duration of their own.
    in property <bool> has-duration;
    in property <string> duration-tooltip: "How long the transition takes";
    // Cut and Fade have no properties.
    in property <bool> has-properties;
    // Studio Mode's quick transitions ("Cut", "Fade"…) and their lengths
    // ("", "300 ms"…).
    in property <[string]> quick-transitions;
    in property <[string]> quick-details;
    // Something is in preview to take.
    in property <bool> can-take;

    // ---- Transition properties (dialog "transition"): the settings of
    // the setup's transition, or of a kind that needs them before it can
    // be chosen (a stinger's video, kept as a draft until OK).
    in property <string> dialog-title: "Properties";
    // The transition's name, the sheet's title ("Fade").
    in property <string> dialog-name;
    in property <[FormGroup]> form-groups;
    in property <bool> dialog-draft;
    // Nothing to set and no draft (Cut, Fade): just Close.
    in property <bool> dialog-empty;
    in property <bool> dialog-has-fields;

    // ---- The control bar's LCD: the take's (or the stream's) time in
    // whole seconds, the program's frame rate in two whole digits, the
    // unused leading zero apart ("0" "7.71", "" "29.93"), frames dropped
    // ("0"; `lcd-dropping` lights the cell orange) and the engine's CPU
    // ("2.4%"). Zeros while the engine isn't running (`engine-running`
    // false dims them, as an idle LCD) or the CPU isn't measured yet.
    in property <int> rec-seconds;
    in property <int> live-seconds;
    in property <string> lcd-fps-lead;
    in property <string> lcd-fps: "00.00";
    in property <string> lcd-dropped: "0";
    in property <bool> lcd-dropping;
    in property <string> lcd-cpu: "0.0%";
    in property <bool> lcd-cpu-known;
    in property <bool> engine-running;

    // ---- The status bar: the state's words after its badge ("Records to
    // ~/Movies/Isocast · 2 ISO files", "Streaming for 00:01:01 ·
    // connection stable · not recording"), and the readouts on the right
    // ("0 dropped", "6.1 Mb/s", "212 GB free"; "" leaves one out).
    in property <string> status-line;
    in property <bool> status-warn;
    in property <string> readout-dropped: "0 dropped";
    in property <bool> readout-dropped-bad;
    in property <string> readout-rate: "0.0 Mb/s";
    in property <string> readout-free;
    in property <string> rec-time: "00:00:00";
    in property <string> live-time: "00:00:00";
    in property <string> rec-tooltip: "Not recording";
    // "2.6%" or "—".
    in property <string> cpu-text: "—";
    in property <string> fps-text: "— / — FPS";
    in property <string> fps-tooltip: "The engine isn’t running";
    in property <bool> fps-lagging;
    // Frames dropped in this take ("" for none; red in the status bar).
    in property <string> dropped;
    // While streaming: dropped frames ("14 (0.1%)"), the rate sent
    // ("6.1 Mb/s"), and the connection's health: "off", "ok", "warn",
    // "bad", with a word when it isn't fine ("Reconnecting").
    in property <string> stream-dropped: "0 (0.0%)";
    in property <bool> stream-dropped-bad;
    in property <string> stream-kbps: "0 kb/s";
    in property <string> stream-health: "off";
    in property <string> stream-health-word;

    // ---- The details popovers over REC and LIVE
    in property <[FileRow]> files;
    // The stream's: label, value, and "", "bad" or "warn".
    in property <[ToastRow]> stream-rows;
    // Opens a details popover from Rust ("rec" or "live"): the status bar
    // opens it when `details-serial` changes.
    in property <string> details-which;
    in property <int> details-serial;

    callback toggle-stream();
    callback toggle-record();
    callback toggle-pause();
    callback toggle-vcam();
    callback toggle-replay();
    callback save-replay();
    // Change the camera's output: field "target", "scene", "source" or
    // "size", and its new value.
    callback set-vcam(string, string);
    // Put text on the clipboard (the install command).
    callback copy-text(string);
    // Open System Settings at Login Items & Extensions (vcam-approval).
    callback open-vcam-settings();
    // Take the camera extension out of macOS (before deleting Isocast).
    callback remove-vcam();
    // A marker with this label ("" for "Marker").
    callback marker(string);
    callback split();
    callback choose-transition(string);
    callback set-duration(int);
    // Studio Mode: put the preview on air, with quick transition `index`,
    // or the setup's transition (-1).
    callback take(int);
    // Transition properties: OK (applies a draft), Cancel (puts the
    // transition back as it was), Defaults.
    callback dialog-accept();
    callback dialog-cancel();
    callback dialog-defaults();
}
