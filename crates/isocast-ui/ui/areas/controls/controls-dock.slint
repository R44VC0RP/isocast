// The Controls dock (Paper "C. Console", Main window and Studio Mode
// boards): Start/Stop Streaming, Start/Stop Recording (with a Marker
// button beside it while recording), Studio Mode, Settings and Exit as
// full-width 28px buttons, 6px apart, 12px down and 14px in; each with its
// icon and its words from the left. Streaming and recording turn their
// button red; Studio Mode glows yellow while on; Exit is quiet. Split is
// in the take's details (the status bar's REC): with the icon and the
// words from the left, "Stop Recording" and two 28px buttons don't fit
// the dock's 172px; with Pause and Marker beside it the label is "Stop"
// unless the dock is 224px or wider (the whole words in its tooltip),
// rather than push them out or end in "Stop R…". Pause
// (G.3) sits between them while recording, a toggle lit while paused.
//
// Start/Stop Virtual Camera sits under recording, as OBS has it, with a
// gear beside it that opens its output choice (program, preview, a scene
// or a video source) and size in a popover. Seven buttons need 240px under
// the header, so they are 4px apart with 10px above and below (Paper's
// board has five, 6px apart, 12px down); in a shorter dock Exit becomes a
// square button beside Settings (Quit Isocast in the app menu does the
// same), and in the shortest (a window under 900px tall) the six rows
// left are 2px apart with 6px above and below.
//
// The replay buffer (G.2) sits between recording and the virtual camera,
// as OBS has it: a toggle named as Virtual Camera is (lit while it keeps
// the program), with Save Replay beside it, a square button with OBS's
// words in its tooltip, usable while the buffer runs.

import { Theme } from "../../theme.slint";
import { Icon, Icons } from "../../icons.slint";
import { Ui, PlatformText } from "../../state.slint";
import {
    Button, ButtonVariant, ControlSize, Dock, Dropdown, GroupHeading, GroupHint, GroupRow, IconButton, Popover,
    PopoverPlacement, RowGroup, RowPlace, Viewport, Menus,
} from "../../kit.slint";
import { ControlsArea } from "state.slint";

// A dock button: the label from the left, 10px in.
component DockButton inherits Button {
    content-alignment: LayoutAlignment.start;
    inset: 10px;
}

// A control in the middle of its 30px grouped row.
component Centred inherits VerticalLayout {
    alignment: center;
}

// The virtual camera's output: what it sends and at what size, how it is
// doing, and, when its extension isn't installed or allowed yet, what to do.
component VirtualCameraDetails inherits VerticalLayout {
    property <bool> off: ControlsArea.vcam-state == "stopped" || ControlsArea.vcam-state == "failed";
    padding: Theme.space-2;
    spacing: 0;

    if ControlsArea.vcam-unavailable != "": GroupHint {
        text: ControlsArea.vcam-unavailable;
    }

    if ControlsArea.vcam-approval && !PlatformText.engine-windows: VerticalLayout {
        spacing: 0;
        GroupHeading { title: "Allow in System Settings"; }
        Rectangle {
            preferred-height: allow.preferred-height;
            min-height: allow.preferred-height;
            allow := Text {
                x: 0;
                y: 0;
                width: parent.width;
                text: "macOS asks you once to allow Isocast Virtual Camera. In System Settings › General › Login Items & Extensions › Camera Extensions, turn on Isocast Virtual Camera. It starts as soon as you do.";
                color: Theme.text-2;
                font-size: Theme.fs-sm;
                letter-spacing: Theme.tracking-sm;
                line-height-factor: Theme.leading-sm;
                wrap: word-wrap;
            }
        }
        HorizontalLayout {
            padding-top: Theme.space-2;
            padding-bottom: Theme.space-2;
            alignment: start;
            Button {
                size: ControlSize.small;
                text: "Open System Settings";
                icon: Icons.settings;
                clicked => { ControlsArea.open-vcam-settings(); }
            }
        }
    }

    if ControlsArea.vcam-missing && !PlatformText.engine-windows: VerticalLayout {
        spacing: 0;
        GroupHeading { title: "Not installed"; }
        // Wrapped to the popover's width (a layout sizes a wrapped Text's
        // height for one line otherwise).
        Rectangle {
            preferred-height: why.preferred-height;
            min-height: why.preferred-height;
            why := Text {
                x: 0;
                y: 0;
                width: parent.width;
                text: "Isocast Virtual Camera is a camera extension that macOS asks you to approve once. Isocast never installs it by itself: run this in Terminal, in the Isocast folder, then approve it in System Settings.";
                color: Theme.text-2;
                font-size: Theme.fs-sm;
                letter-spacing: Theme.tracking-sm;
                line-height-factor: Theme.leading-sm;
                wrap: word-wrap;
            }
        }
        HorizontalLayout {
            padding-top: Theme.space-2;
            padding-bottom: Theme.space-2;
            spacing: Theme.space-1;
            Rectangle {
                horizontal-stretch: 1;
                height: Theme.control-h-sm;
                border-radius: Theme.r-compact;
                background: Theme.control;
                Text {
                    x: Theme.space-2;
                    width: parent.width - 2 * Theme.space-2;
                    text: "scripts/vcam-install.sh";
                    color: Theme.text;
                    font-family: Theme.font-mono;
                    font-weight: Theme.weight-light;
                    font-size: Theme.fs-xs;
                    letter-spacing: Theme.tracking-mono;
                    vertical-alignment: center;
                    overflow: elide;
                    accessible-role: AccessibleRole.text;
                    accessible-label: "Install command: " + self.text;
                }
            }
            Button {
                horizontal-stretch: 0;
                size: ControlSize.small;
                text: "Copy";
                icon: Icons.copy;
                accessible-name: "Copy the install command";
                clicked => { ControlsArea.copy-text("scripts/vcam-install.sh"); }
            }
        }
    }

    GroupHeading { title: "Output"; }
    RowGroup {
        GroupRow {
            label: "Show";
            place: RowPlace.first;
            enabled: root.off;
            Centred {
                Dropdown {
                    width: Theme.field-s;
                    on-control: true;
                    enabled: root.off;
                    options: ControlsArea.vcam-targets;
                    value: ControlsArea.vcam-target;
                    label: "Virtual camera shows";
                    selected(value) => { ControlsArea.set-vcam("target", value); }
                }
            }
        }
        if ControlsArea.vcam-target == "scene": GroupRow {
            label: "Scene";
            enabled: root.off;
            Centred {
                Dropdown {
                    width: Theme.field-s;
                    on-control: true;
                    enabled: root.off;
                    options: ControlsArea.vcam-scenes;
                    value: ControlsArea.vcam-scene;
                    placeholder: "Choose a scene";
                    label: "Virtual camera scene";
                    selected(value) => { ControlsArea.set-vcam("scene", value); }
                }
            }
        }
        if ControlsArea.vcam-target == "source": GroupRow {
            label: "Source";
            enabled: root.off;
            Centred {
                Dropdown {
                    width: Theme.field-s;
                    on-control: true;
                    enabled: root.off;
                    options: ControlsArea.vcam-sources;
                    value: ControlsArea.vcam-source;
                    placeholder: "Choose a source";
                    label: "Virtual camera source";
                    selected(value) => { ControlsArea.set-vcam("source", value); }
                }
            }
        }
        GroupRow {
            label: "Size";
            place: RowPlace.last;
            enabled: root.off;
            Centred {
                Dropdown {
                    width: Theme.field-s;
                    on-control: true;
                    enabled: root.off;
                    options: ControlsArea.vcam-sizes;
                    value: ControlsArea.vcam-size;
                    label: "Virtual camera size";
                    selected(value) => { ControlsArea.set-vcam("size", value); }
                }
            }
        }
    }
    GroupHint {
        text: (ControlsArea.vcam-counts != "" ? ControlsArea.vcam-format + " · " + ControlsArea.vcam-counts : ControlsArea.vcam-format + ", the canvas’s frame rate")
            + (root.off ? "" : ". Stop the camera to change its output.")
            + (ControlsArea.vcam-note != "" ? "\n" + ControlsArea.vcam-note : "")
            + (ControlsArea.vcam-error != "" ? "\n" + ControlsArea.vcam-error : "");
    }

    // Deleting Isocast leaves its camera in macOS: take it out first (#69).
    if ControlsArea.vcam-removable && !PlatformText.engine-windows: VerticalLayout {
        spacing: 0;
        GroupHeading { title: "Remove"; }
        Rectangle {
            preferred-height: remove.preferred-height;
            min-height: remove.preferred-height;
            remove := Text {
                x: 0;
                y: 0;
                width: parent.width;
                text: "Before you delete Isocast, remove its camera from macOS. macOS asks for an administrator password. Starting the camera again installs it again.";
                color: Theme.text-2;
                font-size: Theme.fs-sm;
                letter-spacing: Theme.tracking-sm;
                line-height-factor: Theme.leading-sm;
                wrap: word-wrap;
            }
        }
        HorizontalLayout {
            padding-top: Theme.space-2;
            padding-bottom: Theme.space-2;
            alignment: start;
            Button {
                size: ControlSize.small;
                text: ControlsArea.vcam-removing ? "Removing…" : "Remove Virtual Camera…";
                enabled: !ControlsArea.busy-vcam;
                accessible-name: "Remove Virtual Camera from macOS";
                clicked => { ControlsArea.remove-vcam(); }
            }
        }
    }
}

export component ControlsDock inherits Dock {
    property <bool> streaming: ControlsArea.stream-state == "live" || ControlsArea.stream-state == "connecting" || ControlsArea.stream-state == "reconnecting";
    property <bool> recording: ControlsArea.record-state == "recording";
    property <bool> room-for-words: Ui.controls-width >= 224px && Viewport.width >= Ui.scenes-width + Ui.sources-width + Ui.transitions-width + Ui.controls-width + 232px;
    property <bool> vcam-on: ControlsArea.vcam-state == "running" || ControlsArea.vcam-state == "starting";
    property <bool> replay-on: ControlsArea.replay-state == "running" || ControlsArea.replay-state == "starting";
    property <int> vcam-serial: ControlsArea.vcam-details-serial;
    // The dock row's height as app.slint's Workspace sets it (read from
    // the window, not this dock's layout, so it can't loop).
    property <length> row-height: Ui.docks-height > 0 ? Ui.docks-height : round(min(320px, max(224px, Viewport.height * 4 / 15)) / 1px) * 1px;
    // Exit beside Settings below this; the rows closer together below 240px.
    property <bool> exit-beside: root.row-height < 272px;
    property <bool> tight: root.row-height < 240px;
    // A dock squeezed below the width "Replay Buffer" and "Virtual Camera"
    // need beside their square buttons (a window about 1000px wide or
    // less): they say "Replay" and "Virtual Cam" instead of eliding, with
    // the whole words as their tooltip and for screen readers (#108). Read
    // from the layout settings and the window, as `room-for-words` is (this
    // dock's own width would loop through its buttons' labels).
    property <bool> short-words: Ui.controls-width < 200px || Viewport.width < Ui.scenes-width + Ui.sources-width + Ui.transitions-width + Ui.controls-width + 232px;
    changed vcam-serial => { vcam-details.show(); }

    title: "Controls";

    VerticalLayout {
        vertical-stretch: 1;
        padding-top: root.tight ? 6px : 10px;
        padding-bottom: root.tight ? 6px : 10px;
        padding-left: Theme.pane-x;
        padding-right: Theme.pane-x;
        spacing: root.tight ? 2px : Theme.space-1;
        alignment: start;

        DockButton {
            text: ControlsArea.stream-state == "connecting" ? "Connecting…" : ControlsArea.stream-state == "reconnecting" ? "Reconnecting…" : root.streaming ? "Stop Streaming" : "Start Streaming";
            icon: Icons.broadcast;
            variant: ControlsArea.stream-state == "reconnecting" ? ButtonVariant.live-warn : root.streaming ? ButtonVariant.live : ButtonVariant.secondary;
            enabled: Ui.has-setup && !ControlsArea.busy-stream;
            clicked => { ControlsArea.toggle-stream(); }
        }
        HorizontalLayout {
            spacing: Theme.space-1;
            DockButton {
                horizontal-stretch: 1;
                shrinks: true;
                // Its whole words for screen readers and as a tooltip
                // when they are shortened.
                tooltip: root.recording ? "Stop Recording" : "";
                accessible-name: root.recording ? "Stop Recording" : "";
                // Beside Pause and Marker the whole words need the dock
                // 224px wide (its width as set, when the window has room for
                // every dock at theirs: read from the layout settings, not
                // this dock, which would loop); else it says "Stop", red
                // with its light, rather than "Stop R…".
                text: ControlsArea.record-state == "starting" ? "Starting…" : ControlsArea.record-state == "stopping" ? "Finishing…" : root.recording ? (root.room-for-words ? "Stop Recording" : "Stop") : "Start Recording";
                // Recording: the button is red, so its light goes bone.
                dot: root.recording || ControlsArea.record-state == "starting" ? Theme.bone : Theme.danger;
                variant: root.recording || ControlsArea.record-state == "starting" ? ButtonVariant.live : ButtonVariant.secondary;
                enabled: Ui.has-setup && !ControlsArea.busy-record;
                clicked => { ControlsArea.toggle-record(); }
            }
            if root.recording: Button {
                width: Theme.control-h;
                inset: 0px;
                icon: ControlsArea.paused ? Icons.play : Icons.pause;
                checked: ControlsArea.paused;
                toggle: true;
                accessible-name: ControlsArea.paused ? "Resume Recording" : "Pause Recording";
                tooltip: ControlsArea.paused ? "Resume Recording (" + ControlsArea.pause-time + " paused)" : "Pause Recording: the take and its files stay open";
                enabled: !ControlsArea.busy-pause && !ControlsArea.busy-record;
                clicked => { ControlsArea.toggle-pause(); }
            }
            if root.recording: Button {
                width: Theme.control-h;
                inset: 0px;
                icon: Icons.flag;
                accessible-name: "Marker";
                tooltip: "Add a marker at this moment";
                clicked => { ControlsArea.marker(""); }
            }
        }
        HorizontalLayout {
            spacing: Theme.space-1;
            DockButton {
                horizontal-stretch: 1;
                shrinks: true;
                tooltip: root.replay-on ? "Stop Replay Buffer" : "Start Replay Buffer: keep " + ControlsArea.replay-length + " of the program in memory";
                accessible-name: root.replay-on ? "Stop Replay Buffer" : "Start Replay Buffer";
                text: ControlsArea.replay-state == "starting" ? "Starting…" : ControlsArea.replay-state == "stopping" ? "Stopping…" : root.short-words ? "Replay" : "Replay Buffer";
                icon: Icons.history;
                checked: root.replay-on;
                toggle: true;
                enabled: Ui.has-setup && !ControlsArea.busy-replay;
                clicked => { ControlsArea.toggle-replay(); }
            }
            Button {
                width: Theme.control-h;
                inset: 0px;
                icon: Icons.download;
                accessible-name: "Save Replay";
                tooltip: ControlsArea.replay-state == "running"
                    ? "Save Replay: " + ControlsArea.replay-length + " to the recordings folder" + (ControlsArea.replay-counts != "" ? " (" + ControlsArea.replay-counts + ")" : "")
                    : "Save Replay: start the replay buffer first";
                enabled: ControlsArea.replay-state == "running" && !ControlsArea.saving-replay;
                clicked => { ControlsArea.save-replay(); }
            }
        }
        HorizontalLayout {
            spacing: Theme.space-1;
            DockButton {
                horizontal-stretch: 1;
                shrinks: true;
                // OBS's words don't fit beside the gear in a 172px dock, so
                // it is a toggle named as Studio Mode is (lit while on);
                // screen readers and the tooltip get OBS's words.
                tooltip: ControlsArea.vcam-unavailable != "" && !root.vcam-on ? ControlsArea.vcam-unavailable : ControlsArea.vcam-missing ? "Isocast Virtual Camera isn’t installed: see how to install it" : ControlsArea.vcam-approval ? "Allow Isocast Virtual Camera in System Settings, then it starts" : root.vcam-on ? "Stop Virtual Camera" : "Start Virtual Camera";
                accessible-name: ControlsArea.vcam-unavailable != "" && !root.vcam-on ? "Virtual Camera (" + ControlsArea.vcam-unavailable + ")" : ControlsArea.vcam-missing ? "Virtual Camera (not installed)" : ControlsArea.vcam-approval ? "Virtual Camera (waiting for approval)" : root.vcam-on ? "Stop Virtual Camera" : "Start Virtual Camera";
                text: ControlsArea.vcam-state == "starting" ? "Starting…" : ControlsArea.vcam-state == "stopping" ? "Stopping…" : root.short-words ? "Virtual Cam" : "Virtual Camera";
                // The short words take the end padding too (172px dock).
                inset-end: root.short-words ? 4px : 10px;
                icon: Icons.camera;
                checked: root.vcam-on;
                toggle: true;
                // Stop stays usable whatever the engine says now.
                enabled: Ui.has-setup && !ControlsArea.busy-vcam && (ControlsArea.vcam-unavailable == "" || root.vcam-on);
                clicked => {
                    if ControlsArea.vcam-missing && !root.vcam-on {
                        vcam-details.show();
                    } else {
                        ControlsArea.toggle-vcam();
                    }
                }
            }
            vcam-gear := Button {
                width: Theme.control-h;
                inset: 0px;
                icon: ControlsArea.vcam-missing || ControlsArea.vcam-approval || ControlsArea.vcam-unavailable != "" ? Icons.warning : Icons.settings;
                accessible-name: "Virtual Camera Settings";
                tooltip: ControlsArea.vcam-unavailable != "" ? ControlsArea.vcam-unavailable : ControlsArea.vcam-missing ? "Isocast Virtual Camera isn’t installed" : ControlsArea.vcam-approval ? "Allow Isocast Virtual Camera in System Settings" : "What the virtual camera shows, and its size";
                menu-open: vcam-details.open;
                enabled: Ui.has-setup;
                clicked => { vcam-details.show(); }
                vcam-details := Popover {
                    placement: PopoverPlacement.above-right;
                    panel-width: 300px;
                    VirtualCameraDetails { }
                }
            }
        }
        DockButton {
            text: "Studio Mode";
            icon: Icons.columns;
            checked: Ui.studio;
            toggle: true;
            enabled: Ui.has-setup;
            clicked => { Ui.set-studio(!Ui.studio); }
        }
        // In a short dock (a 768px screen) Exit sits beside Settings as a
        // square button, so it is always there, as in OBS (QA-3 5).
        HorizontalLayout {
            spacing: Theme.space-1;
            DockButton {
                horizontal-stretch: 1;
                shrinks: true;
                text: "Settings";
                icon: Icons.settings;
                clicked => { Ui.open-dialog("settings", ""); }
            }
            if root.exit-beside: Button {
                width: Theme.control-h;
                inset: 0px;
                icon: Icons.log-out;
                variant: ButtonVariant.quiet;
                accessible-name: "Exit";
                tooltip: PlatformText.windows ? "Exit (Alt+F4)" : "Exit (⌘Q)";
                clicked => { Ui.quit(); }
            }
        }
        if !root.exit-beside: DockButton {
            text: "Exit";
            icon: Icons.log-out;
            variant: ButtonVariant.quiet;
            clicked => { Ui.quit(); }
        }
    }
}
