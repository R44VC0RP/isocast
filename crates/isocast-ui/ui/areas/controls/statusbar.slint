// The status bar (docs/design.md 3.20), as in OBS: while streaming, the
// stream's dropped frames, its rate and the connection's health; then the
// LIVE and REC timers, the engine's CPU use and its frame rate. LIVE and
// REC open their details (the web app's statusbar.js): the stream's
// numbers, and each file of the take with a marker label, Mark and Split.

import { Theme } from "../../theme.slint";
import { Icon, Icons } from "../../icons.slint";
import { Ui, ConnectionState } from "../../state.slint";
import { Button, Dot, Popover, PopoverPlacement, TextField, Tip, Toasts } from "../../kit.slint";
import { ControlsArea } from "state.slint";

// An item: 6px in, its parts 6px apart; a clickable one goes `hover` and
// `text` under the pointer (`warn` colours it amber).
component StatusItem inherits Rectangle {
    in property <bool> clickable;
    in property <bool> warn;
    in property <string> tooltip;
    // What screen readers say: its words ("REC 00:01:02"); the tooltip is
    // its description.
    in property <string> label;
    // A button (with `accessible-role: button` where it is used): only
    // then is it disabled while it can't be clicked.
    in property <bool> button;
    // The colour of its words: `text-2`, `text` when on or hovered.
    out property <color> ink: root.warn ? Theme.warning : root.clickable && ta.has-hover ? Theme.text : Theme.text-2;
    callback clicked();
    horizontal-stretch: 0;
    min-width: row.preferred-width;
    background: root.clickable && ta.has-hover ? Theme.hover : transparent;
    // Clickable ones say `accessible-role: button` where they're used.
    accessible-role: AccessibleRole.text;
    accessible-label: root.label;
    accessible-description: root.tooltip;
    accessible-enabled: !root.button || root.clickable;
    accessible-action-default => {
        if root.clickable {
            root.clicked();
        }
    }
    ta := TouchArea {
        enabled: root.clickable;
        clicked => { root.clicked(); }
    }
    row := HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 6px;
        @children
    }
    if root.tooltip != "": Tooltip {
        Tip { text: root.tooltip; }
    }
}

component Meta inherits Text {
    font-size: Theme.fs-xs;
    letter-spacing: Theme.tracking-xs;
    vertical-alignment: center;
    accessible-role: none;
}

// The small heading of a details popover ("Files", "Stream").
component DetailsHeading inherits Rectangle {
    in property <string> text;
    height: 26px;
    Text {
        x: Theme.space-2;
        y: Theme.space-2;
        text: root.text;
        color: Theme.text-3;
        font-size: Theme.fs-xs;
        letter-spacing: Theme.tracking-xs;
        font-weight: Theme.weight-semibold;
    }
}

// While streaming: where to, and how it is keeping up.
component StreamDetails inherits VerticalLayout {
    spacing: 0;
    DetailsHeading { text: "Stream"; }
    VerticalLayout {
        padding-left: Theme.space-2;
        padding-right: Theme.space-2;
        padding-bottom: Theme.space-2;
        for r in ControlsArea.stream-rows: HorizontalLayout {
            min-height: 24px;
            spacing: Theme.space-2;
            Text {
                width: 96px;
                text: r.label;
                color: Theme.text-2;
                font-size: Theme.fs-sm;
                letter-spacing: Theme.tracking-sm;
                vertical-alignment: center;
            }
            Text {
                horizontal-stretch: 1;
                text: r.value;
                color: r.tone == "bad" ? Theme.danger-text : r.tone == "warn" ? Theme.warning : Theme.text;
                font-size: Theme.fs-sm;
                letter-spacing: Theme.tracking-sm;
                line-height-factor: Theme.leading-sm;
                horizontal-alignment: right;
                vertical-alignment: center;
                wrap: word-wrap;
            }
        }
    }
}

// While recording: each file's counters, then a marker label, Mark and
// Split.
component RecordingDetails inherits VerticalLayout {
    spacing: 0;
    DetailsHeading { text: "Files"; }
    VerticalLayout {
        padding-left: Theme.space-2;
        padding-right: Theme.space-2;
        spacing: 2px;
        for f in ControlsArea.files: HorizontalLayout {
            height: 24px;
            spacing: Theme.space-2;
            accessible-role: AccessibleRole.text;
            accessible-label: f.name + ": " + f.frames + ", " + f.dropped + ", " + f.gaps;
            Text {
                horizontal-stretch: 1;
                text: f.name;
                color: Theme.text;
                font-size: Theme.fs-sm;
                letter-spacing: Theme.tracking-sm;
                vertical-alignment: center;
                overflow: elide;
                accessible-role: none;
            }
            Text {
                width: 92px;
                text: f.frames;
                color: Theme.text-2;
                font-size: Theme.fs-sm;
                letter-spacing: Theme.tracking-sm;
                horizontal-alignment: right;
                vertical-alignment: center;
                accessible-role: none;
            }
            Text {
                width: 84px;
                text: f.dropped;
                color: f.dropped-bad ? Theme.danger-text : Theme.text-2;
                font-size: Theme.fs-sm;
                letter-spacing: Theme.tracking-sm;
                horizontal-alignment: right;
                vertical-alignment: center;
                accessible-role: none;
            }
            Rectangle {
                width: 64px;
                Text {
                    width: 100%;
                    text: f.gaps;
                    color: f.gaps-warn ? Theme.warning : Theme.text-2;
                    font-size: Theme.fs-sm;
                    letter-spacing: Theme.tracking-sm;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    accessible-role: none;
                }
                Tooltip {
                    Tip { text: "Times audio was missing and filled with silence"; }
                }
            }
        }
    }
    // The separator: 1px, 4px above and below.
    VerticalLayout {
        padding-top: Theme.space-1;
        padding-bottom: Theme.space-1;
        Rectangle {
            height: 1px;
            background: Theme.line;
        }
    }
    HorizontalLayout {
        padding-top: Theme.space-1;
        padding-bottom: Theme.space-1;
        padding-left: Theme.space-2;
        padding-right: Theme.space-2;
        spacing: Theme.space-2;
        label := TextField {
            horizontal-stretch: 1;
            placeholder: "Marker label";
            label: "Marker label";
            submits: false;
            accepted(text) => { root.mark(); }
        }
        Button {
            text: "Mark";
            icon: Icons.flag;
            clicked => { root.mark(); }
        }
        Button {
            text: "Split";
            icon: Icons.scissors;
            tooltip: "End these files at the next whole second and carry on in new ones";
            clicked => { ControlsArea.split(); }
        }
    }

    function mark() {
        ControlsArea.marker(label.text);
        label.text = "";
    }
}

export component StatusBar inherits Rectangle {
    property <bool> recording: ControlsArea.record-state == "recording" || ControlsArea.record-state == "stopping";
    property <bool> starting: ControlsArea.record-state == "starting";
    // LIVE runs its timer while live or reconnecting; the stream's items
    // show from the moment it starts connecting.
    property <bool> streaming: ControlsArea.stream-state == "live" || ControlsArea.stream-state == "reconnecting";
    property <bool> stream-on: root.streaming || ControlsArea.stream-state == "connecting";

    // The drops toast's Details opens one of them.
    property <int> details-serial: ControlsArea.details-serial;
    changed details-serial => {
        if ControlsArea.details-which == "rec" && root.recording {
            rec-details.show();
        } else if ControlsArea.details-which == "live" && root.stream-on {
            live-details.show();
        }
    }

    // The details close when what they tell of stops (the web app's
    // return null), and keep the drops toast away while open.
    changed recording => {
        if !self.recording {
            rec-details.close();
        }
    }
    changed stream-on => {
        if !self.stream-on {
            live-details.close();
        }
    }
    property <bool> details-open: live-details.open || rec-details.open;
    changed details-open => { Toasts.hide-key(self.details-open ? "drops" : ""); }

    height: Theme.statusbar;
    background: Theme.surface-chrome;
    accessible-role: groupbox;
    accessible-label: "Status";

    Rectangle {
        y: 0;
        height: 1px;
        background: Theme.line;
    }

    row := HorizontalLayout {
        y: 1px;
        height: parent.height - 1px;
        padding-left: 6px;
        padding-right: 6px;
        spacing: 4px;

        // The left: where the window stands with isocastd when it isn't
        // simply connected.
        Meta {
            horizontal-stretch: 1;
            text: Ui.connection == ConnectionState.connected ? "" : Ui.connection-error;
            color: Theme.text-2;
            overflow: elide;
        }

        if root.stream-on: dropped-item := StatusItem {
            accessible-role: button;
            button: true;
            label: "Dropped Frames " + ControlsArea.stream-dropped;
            clickable: true;
            tooltip: "Stream frames that couldn’t be sent (the program and recordings keep them)";
            clicked => { live-details.show(); }
            Meta {
                text: "Dropped Frames";
                color: dropped-item.ink;
            }
            Meta {
                text: ControlsArea.stream-dropped;
                color: ControlsArea.stream-dropped-bad ? Theme.danger-text : dropped-item.ink;
            }
        }
        if root.stream-on: kbps-item := StatusItem {
            accessible-role: button;
            button: true;
            label: ControlsArea.stream-kbps;
            clickable: true;
            tooltip: "Sent over the last second";
            clicked => { live-details.show(); }
            Meta {
                text: ControlsArea.stream-kbps;
                color: kbps-item.ink;
            }
        }
        // A square light (not a dot, so it never reads as REC), and a word
        // when the connection isn't fine.
        if root.stream-on: health-item := StatusItem {
            label: "Connection: " + (ControlsArea.stream-health-word != "" ? ControlsArea.stream-health-word : ControlsArea.stream-state);
            warn: ControlsArea.stream-health == "warn";
            tooltip: "Connection: " + (ControlsArea.stream-health-word != "" ? ControlsArea.stream-health-word : ControlsArea.stream-state);
            VerticalLayout {
                alignment: center;
                Dot {
                    square: true;
                    dot-color: ControlsArea.stream-health == "ok" ? Theme.onair-text : ControlsArea.stream-health == "warn" ? Theme.warning : ControlsArea.stream-health == "bad" ? Theme.danger : Theme.text-3;
                }
            }
            if ControlsArea.stream-health-word != "": Meta {
                text: ControlsArea.stream-health-word;
                color: ControlsArea.stream-health == "bad" ? Theme.danger-text : health-item.ink;
            }
        }

        live-item := StatusItem {
            accessible-role: button;
            button: true;
            label: "LIVE " + ControlsArea.live-time;
            clickable: root.stream-on;
            tooltip: root.stream-on ? "Streaming: click for details" : "Not streaming";
            clicked => { live-details.show(); }
            VerticalLayout {
                alignment: center;
                Icon {
                    path: Icons.live;
                    size: Theme.icon-sm;
                    color: root.stream-on ? Theme.danger-text : Theme.text-3;
                }
            }
            Meta {
                text: "LIVE";
                color: root.stream-on ? Theme.text : live-item.ink;
            }
            Meta {
                text: ControlsArea.live-time;
                color: root.stream-on ? Theme.text : live-item.ink;
            }
        }

        rec-item := StatusItem {
            accessible-role: button;
            button: true;
            label: "REC " + ControlsArea.rec-time + (ControlsArea.dropped != "" ? ", " + ControlsArea.dropped + " dropped" : "");
            clickable: root.recording;
            tooltip: ControlsArea.rec-tooltip;
            clicked => { rec-details.show(); }
            VerticalLayout {
                alignment: center;
                Dot {
                    dot-color: root.recording || root.starting ? Theme.danger : Theme.text-3;
                    pulse: root.starting;
                }
            }
            Meta {
                text: "REC";
                color: root.recording ? Theme.text : rec-item.ink;
            }
            Meta {
                text: ControlsArea.rec-time;
                color: root.recording ? Theme.text : rec-item.ink;
            }
            if ControlsArea.dropped != "": Meta {
                text: ControlsArea.dropped + " dropped";
                color: Theme.danger-text;
            }
        }

        cpu-item := StatusItem {
            label: "CPU: " + ControlsArea.cpu-text;
            tooltip: "The engine’s share of this Mac’s processor (all cores)";
            Meta {
                text: "CPU:";
                color: cpu-item.ink;
            }
            Meta {
                text: ControlsArea.cpu-text;
                color: cpu-item.ink;
            }
        }

        fps-item := StatusItem {
            label: ControlsArea.fps-text;
            warn: ControlsArea.fps-lagging;
            tooltip: ControlsArea.fps-tooltip;
            Meta {
                text: ControlsArea.fps-text;
                color: fps-item.ink;
            }
        }
    }

    // The details popovers, anchored to their items (a popover can't sit
    // in a layout).
    Rectangle {
        x: row.x + live-item.x;
        y: row.y;
        width: live-item.width;
        height: row.height;
        live-details := Popover {
            placement: PopoverPlacement.above-right;
            panel-width: 420px;
            StreamDetails { }
        }
    }
    Rectangle {
        x: row.x + rec-item.x;
        y: row.y;
        width: rec-item.width;
        height: row.height;
        rec-details := Popover {
            placement: PopoverPlacement.above-right;
            panel-width: 420px;
            RecordingDetails { }
        }
    }
}
