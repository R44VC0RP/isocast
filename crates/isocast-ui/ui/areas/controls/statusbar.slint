// The status bar (Paper "C. Console", Main window and Studio Mode boards):
// 28px of `surface-chrome` under a black line, 14px in. On the left a
// state badge (READY, REC, LIVE; IDLE with no setup) and what is happening ("Records to
// ~/Movies/Isocast · 2 ISO files", "Streaming for 00:01:01 · connection
// stable · not recording"); on the right Martian Mono readouts split by
// short rules: frames dropped, the data rate, the recording disk's free
// space. The times, frame rate and CPU are the control bar's LCD. The
// badge and the readouts open the details (the web app's statusbar.js):
// the stream's numbers, and each file of the take with a marker label,
// Mark and Split.

import { Theme } from "../../theme.slint";
import { Icons } from "../../icons.slint";
import { Ui, ConnectionState } from "../../state.slint";
import { Badge, BadgeTone, Button, Popover, PopoverPlacement, Rule, Tag, TextField, Tip, Toasts } from "../../kit.slint";
import { ControlsArea } from "state.slint";

// A part of the bar that can open its details: `hover` and `text` under
// the pointer while it can.
component StatusItem inherits Rectangle {
    in property <bool> clickable;
    in property <string> tooltip;
    // What screen readers say: its words; the tooltip is its description.
    in property <string> label;
    out property <bool> hovered: root.clickable && ta.has-hover;
    callback clicked();
    horizontal-stretch: 0;
    min-width: row.min-width;
    preferred-width: row.preferred-width;
    border-radius: Theme.r-mini;
    background: root.hovered ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-description: root.tooltip;
    accessible-enabled: root.clickable;
    accessible-action-default => {
        if root.clickable {
            root.clicked();
        }
    }
    ta := TouchArea {
        enabled: root.clickable;
        clicked => { root.clicked(); }
    }
    row := HorizontalLayout {
        @children
    }
    if root.tooltip != "": Tooltip {
        Tip { text: root.tooltip; }
    }
}

// The bar's words: 11px `text-3` (Mona Sans, or Martian Mono Light for a
// readout).
component Meta inherits Text {
    color: Theme.text-3;
    font-size: Theme.fs-xs;
    letter-spacing: Theme.tracking-xs;
    vertical-alignment: center;
    accessible-role: none;
}

component Readout inherits Meta {
    font-family: Theme.font-mono;
    font-weight: Theme.weight-light;
    letter-spacing: Theme.tracking-mono;
}

// The small heading of a details popover ("FILES", "STREAM"): Hubot caps,
// as the LCD labels its cells.
component DetailsHeading inherits Rectangle {
    in property <string> text;
    height: 28px;
    Tag {
        x: Theme.space-2;
        y: Theme.space-2;
        height: Theme.lh-micro;
        text: root.text;
    }
}

// A number in the details: Martian Mono Light, as every live number.
component Figure inherits Text {
    color: Theme.text-2;
    font-family: Theme.font-mono;
    font-size: Theme.fs-xs;
    font-weight: Theme.weight-light;
    horizontal-alignment: right;
    vertical-alignment: center;
    accessible-role: none;
}

// While streaming: where to, and how it is keeping up.
component StreamDetails inherits VerticalLayout {
    spacing: 0;
    DetailsHeading { text: "STREAM"; }
    VerticalLayout {
        padding-left: Theme.space-2;
        padding-right: Theme.space-2;
        padding-bottom: Theme.space-2;
        for r in ControlsArea.stream-rows: HorizontalLayout {
            min-height: 24px;
            spacing: Theme.space-2;
            Text {
                width: 96px;
                text: r.label;
                color: Theme.text-2;
                font-size: Theme.fs-sm;
                letter-spacing: Theme.tracking-sm;
                vertical-alignment: center;
            }
            Text {
                horizontal-stretch: 1;
                text: r.value;
                color: r.tone == "bad" ? Theme.danger-text : r.tone == "warn" ? Theme.warning : Theme.text;
                font-size: Theme.fs-sm;
                letter-spacing: Theme.tracking-sm;
                line-height-factor: Theme.leading-sm;
                horizontal-alignment: right;
                vertical-alignment: center;
                wrap: word-wrap;
            }
        }
    }
}

// While recording: each file's counters, then a marker label, Mark and
// Split.
component RecordingDetails inherits VerticalLayout {
    spacing: 0;
    DetailsHeading { text: "FILES"; }
    VerticalLayout {
        padding-left: Theme.space-2;
        padding-right: Theme.space-2;
        spacing: 2px;
        for f in ControlsArea.files: HorizontalLayout {
            height: 24px;
            spacing: Theme.space-2;
            accessible-role: AccessibleRole.text;
            accessible-label: f.name + ": " + f.frames + ", " + f.dropped + ", " + f.gaps;
            Text {
                horizontal-stretch: 1;
                min-width: 0px;
                text: f.name;
                color: Theme.text;
                font-size: Theme.fs-sm;
                letter-spacing: Theme.tracking-sm;
                vertical-alignment: center;
                overflow: elide;
                accessible-role: none;
            }
            Figure {
                width: 112px;
                text: f.frames;
            }
            Figure {
                width: 92px;
                text: f.dropped;
                color: f.dropped-bad ? Theme.danger-text : Theme.text-2;
            }
            Rectangle {
                width: 56px;
                Figure {
                    width: 100%;
                    text: f.gaps;
                    color: f.gaps-warn ? Theme.warning : Theme.text-2;
                }
                Tooltip {
                    Tip { text: "Times audio was missing and filled with silence"; }
                }
            }
        }
    }
    // The take's pauses.
    if ControlsArea.pauses.length > 0: DetailsHeading { text: "PAUSES"; }
    if ControlsArea.pauses.length > 0: VerticalLayout {
        padding-left: Theme.space-2;
        padding-right: Theme.space-2;
        spacing: 2px;
        for p in ControlsArea.pauses: HorizontalLayout {
            height: 24px;
            spacing: Theme.space-2;
            accessible-role: AccessibleRole.text;
            accessible-label: p.label + ": " + p.value;
            Text {
                horizontal-stretch: 1;
                min-width: 0px;
                text: p.label;
                color: Theme.text;
                font-size: Theme.fs-sm;
                letter-spacing: Theme.tracking-sm;
                vertical-alignment: center;
                overflow: elide;
                accessible-role: none;
            }
            Figure {
                width: 92px;
                text: p.value;
                color: p.tone == "warn" ? Theme.warning : Theme.text-2;
            }
        }
    }
    // The separator: 1px, 4px above and below.
    VerticalLayout {
        padding-top: Theme.space-1;
        padding-bottom: Theme.space-1;
        Rectangle {
            height: 1px;
            background: Theme.line;
        }
    }
    HorizontalLayout {
        padding-top: Theme.space-1;
        padding-bottom: Theme.space-1;
        padding-left: Theme.space-2;
        padding-right: Theme.space-2;
        spacing: Theme.space-2;
        // The field takes what Mark and Split leave (its own preferred
        // width would squeeze their words).
        label := TextField {
            horizontal-stretch: 1;
            preferred-width: Theme.field-s;
            placeholder: "Marker label";
            label: "Marker label";
            submits: false;
            accepted(text) => { root.mark(); }
        }
        Button {
            text: "Mark";
            icon: Icons.flag;
            clicked => { root.mark(); }
        }
        Button {
            text: "Split";
            icon: Icons.scissors;
            tooltip: "End these files at the next whole second and carry on in new ones";
            clicked => { ControlsArea.split(); }
        }
    }

    function mark() {
        ControlsArea.marker(label.text);
        label.text = "";
    }
}

export component StatusBar inherits Rectangle {
    property <bool> recording: ControlsArea.record-state == "recording" || ControlsArea.record-state == "stopping";
    // The stream's details are there from the moment it starts connecting.
    property <bool> stream-on: ControlsArea.stream-state == "live" || ControlsArea.stream-state == "reconnecting" || ControlsArea.stream-state == "connecting";
    property <bool> streaming: ControlsArea.stream-state == "live" || ControlsArea.stream-state == "reconnecting";

    // The drops toast's Details opens one of them.
    property <int> details-serial: ControlsArea.details-serial;
    changed details-serial => {
        if ControlsArea.details-which == "rec" && root.recording {
            rec-details.show();
        } else if ControlsArea.details-which == "live" && root.stream-on {
            live-details.show();
        }
    }

    // The details close when what they tell of stops (the web app's
    // return null), and keep the drops toast away while open.
    changed recording => {
        if !self.recording {
            rec-details.close();
        }
    }
    changed stream-on => {
        if !self.stream-on {
            live-details.close();
        }
    }
    property <bool> details-open: live-details.open || rec-details.open;
    changed details-open => { Toasts.hide-key(self.details-open ? "drops" : ""); }

    // The details the readouts open: the take's while recording, else the
    // stream's.
    function show-details() {
        if root.recording {
            rec-details.show();
        } else if root.stream-on {
            live-details.show();
        }
    }

    height: Theme.statusbar;
    background: Theme.surface-chrome;
    accessible-role: groupbox;
    accessible-label: "Status";

    Rectangle {
        y: 0;
        height: 1px;
        background: Theme.frame-line;
    }

    row := HorizontalLayout {
        y: 1px;
        height: parent.height - 1px;
        padding-left: Theme.pane-x;
        padding-right: Theme.pane-x;
        spacing: Theme.line-gap;

        // LIVE (while streaming) and REC (while recording), else READY
        // (IDLE before there is a setup: Paper's Welcome board).
        if root.streaming: live-item := StatusItem {
            label: "LIVE " + ControlsArea.live-time;
            clickable: true;
            tooltip: "Streaming: click for details";
            clicked => { live-details.show(); }
            VerticalLayout {
                alignment: center;
                Badge {
                    text: "LIVE";
                    // Orange while it reconnects, as the button and the
                    // line beside it are.
                    tone: ControlsArea.stream-state == "reconnecting" ? BadgeTone.warning : BadgeTone.live;
                    dot: true;
                    status: true;
                }
            }
        }
        if root.recording || ControlsArea.record-state == "starting": rec-item := StatusItem {
            label: "REC " + ControlsArea.rec-time;
            clickable: root.recording;
            tooltip: ControlsArea.rec-tooltip;
            clicked => { rec-details.show(); }
            VerticalLayout {
                alignment: center;
                Badge {
                    text: "REC";
                    tone: BadgeTone.rec;
                    dot: true;
                    status: true;
                }
            }
        }
        if !root.streaming && !root.recording && ControlsArea.record-state != "starting" && Ui.connection == ConnectionState.connected: VerticalLayout {
            alignment: center;
            Badge {
                text: Ui.has-setup ? "READY" : "IDLE";
                dot: true;
                status: true;
            }
        }
        Meta {
            horizontal-stretch: 1;
            min-width: 0px;
            text: ControlsArea.status-line;
            color: Ui.connection != ConnectionState.connected ? Theme.text-2 : ControlsArea.status-warn ? Theme.warning : Theme.text-3;
            overflow: elide;
            accessible-role: AccessibleRole.text;
            accessible-label: self.text;
        }

        // The readouts.
        HorizontalLayout {
            horizontal-stretch: 0;
            spacing: Theme.space-4;
            dropped-item := StatusItem {
                label: ControlsArea.readout-dropped;
                clickable: root.recording || root.stream-on;
                tooltip: root.recording ? "Frames dropped in this take: click for each file" : root.stream-on ? "Stream frames that couldn’t be sent (the program and recordings keep them)" : "";
                clicked => { root.show-details(); }
                Readout {
                    text: ControlsArea.readout-dropped;
                    color: ControlsArea.readout-dropped-bad ? Theme.danger-text : dropped-item.hovered ? Theme.text : Theme.text-3;
                }
            }
            Rule { }
            rate-item := StatusItem {
                label: ControlsArea.readout-rate;
                clickable: root.stream-on;
                tooltip: root.stream-on ? "Sent over the last second" : root.recording ? "Written to the disk over the last seconds" : "";
                clicked => { live-details.show(); }
                Readout {
                    text: ControlsArea.readout-rate;
                    color: rate-item.hovered ? Theme.text : Theme.text-3;
                }
            }
            if ControlsArea.readout-free != "": Rule { }
            if ControlsArea.readout-free != "": Readout {
                text: ControlsArea.readout-free;
                accessible-role: AccessibleRole.text;
                accessible-label: self.text;
            }
        }
    }

    // The details popovers, anchored to the bar's ends (a popover can't
    // sit in a layout).
    Rectangle {
        x: Theme.pane-x;
        y: row.y;
        width: 1px;
        height: row.height;
        live-details := Popover {
            placement: PopoverPlacement.above-left;
            panel-width: 420px;
            StreamDetails { }
        }
    }
    Rectangle {
        x: parent.width - Theme.pane-x - 1px;
        y: row.y;
        width: 1px;
        height: row.height;
        rec-details := Popover {
            placement: PopoverPlacement.above-right;
            panel-width: 420px;
            RecordingDetails { }
        }
    }
}
