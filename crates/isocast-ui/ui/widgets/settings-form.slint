// A form drawn from the setup schema (the web app's fields.js), shared by
// Properties, Filters and Transition Properties, as Console's grouped rows
// (Paper's Properties sheet): one 30px `control` row per setting, 1px
// apart, the first and last with 6px corners; its label on the left, its
// control on the right (22px controls: a stepper for numbers, a switch,
// a dropdown or a text field in the 400px column, the Files list). An
// object's own settings follow its switch, their labels 16px further in;
// a setting's caption (what a camera sends now) sits under its control.
// The control is chosen by the field's kind (see FormField), with
// dropdowns where the choices are known (devices, apps, a camera's
// formats), and files chosen or typed. Every change goes to
// `SettingsForms` with the form's id and the row's key; src/form/ builds
// the rows and routes the changes to the view that shows the form.

import { Theme } from "../theme.slint";
import { Icon, Icons } from "../icons.slint";
import { Button, ButtonVariant, ControlSize, IconButton } from "buttons.slint";
import { ColorField, NumberField, TextArea, TextField } from "fields.slint";
import { Dropdown, DropdownOption } from "dropdown.slint";
import { Switch } from "choices.slint";
import { GroupRow, RowPlace } from "forms.slint";

// One setting in a form drawn from the setup schema.
// `kind` says which control it takes: number, text, textarea, path (a
// file, typed or chosen), files (a list of files), switch, color, choice
// (a dropdown), object (a switch for settings of its own, shown under it
// when on), add (an optional setting that is off: "+ Add"), json.
export struct FormField {
    // Its name, or "outer.inner" inside an object's settings.
    key: string,
    label: string,
    kind: string,
    text: string,
    // A path with its middle left out ("/Volumes/…/slides/brb.jpg"), shown
    // in place of `text` while the field isn't being typed in and the
    // whole path doesn't fit (#108).
    rest-text: string,
    number: float,
    // A number left out (it shows `placeholder`, like "Auto").
    empty: bool,
    on: bool,
    unit: string,
    // Right after the number in its own face ("×" of a speed), which then
    // shows every decimal of its step ("1.00×").
    suffix: string,
    step: float,
    minimum: float,
    maximum: float,
    placeholder: string,
    options: [DropdownOption],
    value: string,
    mono: bool,
    swatch: color,
    // A files field's files (their names), and the folder each is in
    // ("~/Movies/Isocast").
    files: [string],
    file-dirs: [string],
    // Ends in ✕ (an optional setting that is set), or in a button that
    // looks for devices again; `lane` keeps that place empty otherwise, so
    // the form's fields share one right edge.
    removable: bool,
    refresh: bool,
    refreshing: bool,
    lane: bool,
    // A caption under it (what a camera sends now), amber when it warns.
    hint: string,
    hint-warn: bool,
    // A second, typed value beside a choice (part of a window's title, a
    // custom shape).
    extra: bool,
    extra-text: string,
    extra-placeholder: string,
    // The field's description, for its tooltip.
    tooltip: string,
}

// A setting and, for an object that is on, its own settings.
export struct FormGroup {
    field: FormField,
    children: [FormField],
}

// Where every form's controls report (`form`: the form's id, "props",
// "filter" or "transition"; `key`: the setting).
export global SettingsForms {
    callback text(string, string, string);
    // While scrubbed (`live`), then once more when let go.
    callback number(string, string, float, bool);
    callback switch(string, string, bool);
    callback choose(string, string, string);
    callback extra(string, string, string);
    callback remove(string, string);
    callback add(string, string);
    callback browse(string, string);
    callback remove-file(string, string, int);
    callback refresh(string);
    // A colour field's swatch: the system colour panel, with its colour.
    callback pick-color(string, string, string);
}

// A list of files (a media source's playlist; Paper's Properties sheet,
// Files): an inset box (`field-border`, 5px corners, 2px in) of 24px rows
// (8px in: a 12px `text-3` reel glyph, the name in 12px `text`, its folder
// in 10px Martian Mono Light `text-3`, a 20px ✕), then "Add Files…" (22px
// on `control-active`, a 10px +), 6px under it.
component FilesField inherits VerticalLayout {
    in property <FormField> f;
    in property <string> form;
    spacing: 6px;
    alignment: start;

    if root.f.files.length > 0: Rectangle {
        height: min(4 * 24px, root.f.files.length * 24px) + 6px;
        background: Theme.surface-inset;
        border-width: 1px;
        border-color: Theme.field-border;
        border-radius: Theme.r-compact;
        clip: true;
        accessible-role: list;
        accessible-label: root.f.label;
        Flickable {
            x: 3px;
            y: 3px;
            width: parent.width - 6px;
            height: parent.height - 6px;
            content-height: root.f.files.length * 24px;
            interactive: false;
            for file[i] in root.f.files: Rectangle {
                y: i * 24px;
                height: 24px;
                border-radius: Theme.r-mini;
                accessible-role: list-item;
                accessible-label: file;
                accessible-description: i < root.f.file-dirs.length ? root.f.file-dirs[i] : "";
                accessible-item-index: i;
                accessible-item-count: root.f.files.length;
                HorizontalLayout {
                    padding-left: Theme.space-2;
                    padding-right: 2px;
                    spacing: Theme.space-2;
                    VerticalLayout {
                        alignment: center;
                        Icon {
                            path: root.f.options.length > 0 ? Icons.app-audio : Icons.reel;
                            size: Theme.icon-xs;
                            stroke-width: 1.125px;
                            color: Theme.text-3;
                        }
                    }
                    Text {
                        text: file;
                        color: Theme.text;
                        font-size: Theme.fs-sm;
                        letter-spacing: Theme.tracking-sm;
                        vertical-alignment: center;
                        overflow: elide;
                        accessible-role: none;
                    }
                    Text {
                        horizontal-stretch: 1;
                        min-width: 0px;
                        text: i < root.f.file-dirs.length ? root.f.file-dirs[i] : "";
                        color: Theme.text-3;
                        font-family: Theme.font-mono;
                        font-weight: Theme.weight-light;
                        font-size: Theme.fs-micro;
                        letter-spacing: Theme.tracking-mono;
                        vertical-alignment: center;
                        overflow: elide;
                        accessible-role: none;
                    }
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 20px;
                            height: 20px;
                            border-radius: Theme.r-mini;
                            background: remove-ta.has-hover ? Theme.control-hover : transparent;
                            accessible-role: button;
                            accessible-label: "Remove " + file;
                            accessible-action-default => { SettingsForms.remove-file(root.form, root.f.key, i); }
                            Icon {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                path: Icons.x;
                                size: Theme.icon-xs;
                                color: remove-ta.has-hover ? Theme.text : Theme.text-2;
                            }
                            remove-ta := TouchArea {
                                clicked => { SettingsForms.remove-file(root.form, root.f.key, i); }
                            }
                        }
                    }
                }
            }
        }
    }
    // Apps to add from (a system audio source's apps to leave out).
    if root.f.options.length > 0: HorizontalLayout {
        alignment: start;
        Dropdown {
            width: root.width;
            on-control: true;
            show-detail: true;
            options: root.f.options;
            value: root.f.value;
            label: root.f.label;
            selected(v) => { SettingsForms.choose(root.form, root.f.key, v); }
        }
    }
    if root.f.options.length == 0: HorizontalLayout {
        alignment: start;
        Button {
            text: "Add Files…";
            // Paper's: a 12-unit plus at 10px, stroked 1.6, in `text`.
            icon: Icons.plus-12;
            icon-box: 12;
            icon-stroke: 1.6;
            icon-color: Theme.text;
            icon-size: 10px;
            icon-gap: 6px;
            inset-end: Theme.space-3;
            size: ControlSize.small;
            on-control: true;
            clicked => { SettingsForms.browse(root.form, root.f.key); }
        }
    }
}

// A control centred in its row (a layout puts a shorter item at the top).
component Centred inherits VerticalLayout {
    alignment: center;
}

// One setting's row: its label, its control on the right, then a ✕ or a
// look-again button (or the room for one, so the form's controls share
// one right edge). A caption under the control makes the row taller.
export component FieldRow inherits GroupRow {
    in property <FormField> f;
    in property <string> form;
    property <bool> on-off: root.f.kind == "switch" || root.f.kind == "object";
    property <bool> has-tail: root.f.removable || root.f.refresh || (root.f.lane && root.f.kind != "path");
    // The wide controls' column: Paper's 400px, less where the sheet is
    // narrower (the label keeps its 156px).
    property <length> wide: max(Theme.field-s, min(Theme.field-wide, root.width - Theme.space-3 - root.indent - Theme.label-col - root.trailing-pad - (root.has-tail ? Theme.icon-button-xs + Theme.space-1 : 0px)));

    label: root.f.label;
    tall: root.f.kind == "files" || root.f.kind == "textarea" || root.f.hint != "";
    trailing-pad: root.on-off && !root.has-tail ? Theme.space-2 : Theme.space-1;

    VerticalLayout {
        alignment: root.tall ? LayoutAlignment.start : LayoutAlignment.center;
        spacing: Theme.space-1;
        HorizontalLayout {
            alignment: end;
            spacing: Theme.space-1;
            if root.f.kind == "number": Centred {
                NumberField {
                    width: Theme.field-xs;
                    small: true;
                    stepper: true;
                    stepper-fill: Theme.control-hover;
                    value: root.f.number;
                    empty: root.f.empty;
                    placeholder: root.f.placeholder;
                    unit: root.f.unit;
                    suffix: root.f.suffix;
                    fixed: root.f.suffix != "";
                    step: root.f.step;
                    minimum: root.f.minimum;
                    maximum: root.f.maximum;
                    label: root.f.label;
                    scrubbing(v) => { SettingsForms.number(root.form, root.f.key, v, true); }
                    changed(v) => { SettingsForms.number(root.form, root.f.key, v, false); }
                }
            }
            if root.f.kind == "text": Centred {
                TextField {
                    width: root.wide;
                    small: true;
                    text: root.f.text;
                    placeholder: root.f.placeholder;
                    mono: root.f.mono;
                    label: root.f.label;
                    committed(text) => { SettingsForms.text(root.form, root.f.key, text); }
                }
            }
            if root.f.kind == "textarea": TextArea {
                width: root.wide;
                text: root.f.text;
                placeholder: root.f.placeholder;
                mono: root.f.mono;
                label: root.f.label;
                committed(text) => { SettingsForms.text(root.form, root.f.key, text); }
            }
            if root.f.kind == "path": HorizontalLayout {
                width: root.wide;
                spacing: Theme.space-1;
                Centred {
                    horizontal-stretch: 1;
                    TextField {
                        small: true;
                        mono: true;
                        icon: Icons.folder;
                        text: root.f.text;
                        rest-text: root.f.rest-text;
                        placeholder: root.f.placeholder;
                        label: root.f.label;
                        committed(text) => { SettingsForms.text(root.form, root.f.key, text); }
                    }
                }
                Centred {
                    Button {
                        text: "Browse…";
                        size: ControlSize.small;
                        on-control: true;
                        accessible-name: "Choose a file for " + root.f.label;
                        clicked => { SettingsForms.browse(root.form, root.f.key); }
                    }
                }
            }
            if root.f.kind == "files": FilesField {
                width: root.wide;
                f: root.f;
                form: root.form;
            }
            if root.on-off: Centred {
                Switch {
                    on: root.f.on;
                    label: root.f.label;
                    tooltip: root.f.tooltip;
                    toggled(on) => { SettingsForms.switch(root.form, root.f.key, on); }
                }
            }
            if root.f.kind == "color": Centred {
                ColorField {
                    width: Theme.field-s;
                    small: true;
                    value: root.f.text;
                    swatch: root.f.swatch;
                    label: root.f.label;
                    changed(text) => { SettingsForms.text(root.form, root.f.key, text); }
                    pick => { SettingsForms.pick-color(root.form, root.f.key, root.f.text); }
                }
            }
            if root.f.kind == "choice": Centred {
                Dropdown {
                    width: root.f.extra ? (root.wide - Theme.space-1) / 2 : root.wide;
                    on-control: true;
                    show-detail: true;
                    options: root.f.options;
                    value: root.f.value;
                    label: root.f.label;
                    tooltip: root.f.tooltip;
                    placeholder: root.f.placeholder;
                    selected(v) => { SettingsForms.choose(root.form, root.f.key, v); }
                }
            }
            if root.f.kind == "choice" && root.f.extra: Centred {
                TextField {
                    width: (root.wide - Theme.space-1) / 2;
                    small: true;
                    text: root.f.extra-text;
                    placeholder: root.f.extra-placeholder;
                    label: root.f.extra-placeholder;
                    committed(text) => { SettingsForms.extra(root.form, root.f.key, text); }
                }
            }
            if root.f.kind == "add": Centred {
                Button {
                    text: "Add";
                    icon: Icons.plus;
                    icon-size: 10px;
                    icon-gap: 6px;
                    inset-end: Theme.space-3;
                    size: ControlSize.small;
                    on-control: true;
                    tooltip: root.f.tooltip;
                    accessible-name: "Add " + root.f.label;
                    clicked => { SettingsForms.add(root.form, root.f.key); }
                }
            }
            if root.f.kind == "json": Text {
                width: root.wide;
                text: root.f.text;
                color: Theme.text-3;
                font-family: Theme.font-mono;
                font-weight: Theme.weight-light;
                font-size: Theme.fs-xs;
                letter-spacing: Theme.tracking-mono;
                horizontal-alignment: right;
                vertical-alignment: center;
                overflow: elide;
            }
            if root.f.removable: Centred {
                IconButton {
                    compact: true;
                    icon: Icons.x;
                    icon-size: Theme.icon-xs;
                    label: "Remove " + root.f.label;
                    clicked => { SettingsForms.remove(root.form, root.f.key); }
                }
            }
            if root.f.refresh: Centred {
                IconButton {
                    compact: true;
                    icon: Icons.refresh;
                    icon-size: Theme.icon-xs;
                    label: "Look for devices again";
                    spinning: root.f.refreshing;
                    enabled: !root.f.refreshing;
                    clicked => { SettingsForms.refresh(root.form); }
                }
            }
            if root.f.lane && !root.f.removable && !root.f.refresh && root.f.kind != "path": Rectangle {
                width: Theme.icon-button-xs;
            }
        }
        // The caption, under the control: 11px, `text-2` with figures (a
        // live reading), amber when it warns. As wide as the controls'
        // column: unwrapped, a long one took the label's room ("…").
        if root.f.hint != "": Text {
            width: root.wide;
            text: root.f.hint;
            color: root.f.hint-warn ? Theme.warning : Theme.text-2;
            font-size: Theme.fs-xs;
            letter-spacing: Theme.tracking-xs;
            line-height-factor: Theme.leading-xs;
            horizontal-alignment: right;
            wrap: word-wrap;
            accessible-role: AccessibleRole.text;
            accessible-label: root.f.hint;
        }
    }
}

// The whole form: one group of rows, an object's settings after its
// switch.
export component SettingsForm inherits VerticalLayout {
    in property <[FormGroup]> groups;
    in property <string> form;

    spacing: 1px;
    alignment: start;

    for group[gi] in root.groups: VerticalLayout {
        property <bool> first: gi == 0;
        property <bool> last-group: gi == root.groups.length - 1;
        spacing: 1px;
        FieldRow {
            f: group.field;
            form: root.form;
            place: parent.first && parent.last-group && group.children.length == 0 ? RowPlace.only
                : parent.first ? RowPlace.first
                : parent.last-group && group.children.length == 0 ? RowPlace.last
                : RowPlace.middle;
        }
        for child[ci] in group.children: FieldRow {
            f: child;
            form: root.form;
            indent: Theme.space-4;
            place: parent.last-group && ci == group.children.length - 1 ? RowPlace.last : RowPlace.middle;
        }
    }
}
