// The sidebar list (Tower's macOS source list; Paper's Settings sheet): a
// 200px `surface-panel` column with a `line` edge on its right, 14px above
// and below and 8px in; pages are 30px rows (6px corners, 10px in, a 16px
// icon 10px from the label) 2px apart, grouped under 11px semibold
// `text-3` headings 14px apart. The chosen page is `selected` (the
// yellow-tinted black) with a yellow icon and a medium `text` label; the
// rest are `text-2`. ↑ ↓ move between pages.
//
//     NavList {
//         tabs: [
//             { id: "output", label: "Output", icon: "disk", group: "Recording" },
//             { id: "video", label: "Video", icon: "display", group: "Recording" },
//             { id: "stream", label: "Stream", icon: "live", group: "Broadcast" },
//         ];
//         current: "output";
//         selected(id) => { … }
//     }

import { Theme, Motion } from "../theme.slint";
import { Icon, Icons } from "../icons.slint";
import { FocusRing, ShownState } from "focus.slint";

export struct NavTab {
    id: string,
    label: string,
    // Its icon, by name (`Icons.named`).
    icon: string,
    // The heading of the group it starts or belongs to ("" for none): a
    // heading shows where the group changes from the page before.
    group: string,
}

export component NavList inherits Rectangle {
    in property <[NavTab]> tabs;
    in-out property <string> current;
    in property <string> label;
    // Draw a state regardless of the keyboard (the kit gallery): `focus`
    // rings the chosen page.
    in property <ShownState> shown: ShownState.live;
    callback selected(string);

    forward-focus: fs;
    property <bool> keyboard;
    property <int> index: -1;

    function choose(id: string) {
        if id != root.current {
            root.current = id;
            root.selected(id);
        }
    }

    function go(by: int) {
        if root.tabs.length > 0 {
            root.keyboard = true;
            root.choose(root.tabs[max(0, min(root.tabs.length - 1, root.index + by))].id);
        }
    }

    width: Theme.sidebar-w;
    background: Theme.surface-panel;
    accessible-role: tab-list;
    accessible-label: root.label;

    fs := FocusScope {
        focus-on-click: false;
        focus-gained(reason) => { root.keyboard = reason == FocusReason.tab-navigation; }
        focus-lost => { root.keyboard = false; }
        key-pressed(event) => {
            if event.text == Key.UpArrow {
                root.go(-1);
                return accept;
            }
            if event.text == Key.DownArrow {
                root.go(1);
                return accept;
            }
            reject
        }

        VerticalLayout {
            padding-top: 14px;
            padding-bottom: 14px;
            padding-left: Theme.space-2;
            padding-right: Theme.space-2 + 1px;
            spacing: 2px;
            alignment: start;
            for tab[i] in root.tabs: VerticalLayout {
                property <bool> starts-group: tab.group != "" && (i == 0 || root.tabs[i - 1].group != tab.group);
                spacing: 2px;
                // 14px between groups: 10 here and the layouts' 2 + 2.
                if starts-group && i > 0: Rectangle {
                    height: 10px;
                }
                if starts-group: Rectangle {
                    height: 22px;
                    accessible-role: none;
                    Text {
                        x: 10px;
                        width: parent.width - 10px;
                        text: tab.group;
                        color: Theme.text-3;
                        font-size: Theme.fs-xs;
                        font-weight: Theme.weight-semibold;
                        letter-spacing: Theme.tracking-xs;
                        vertical-alignment: center;
                        overflow: elide;
                        accessible-role: none;
                    }
                }
                tab-row := Rectangle {
                    property <bool> on: tab.id == root.current;
                    changed on => {
                        if self.on {
                            root.index = i;
                        }
                    }
                    init => {
                        if self.on {
                            root.index = i;
                        }
                    }
                    height: Theme.nav-row;
                    border-radius: Theme.r;
                    background: self.on ? Theme.selected : tab-ta.has-hover ? Theme.hover : transparent;
                    animate background { duration: Theme.fast; easing: Motion.ease; }
                    accessible-role: AccessibleRole.tab;
                    accessible-label: tab.label;
                    accessible-item-selectable: true;
                    accessible-item-selected: self.on;
                    accessible-item-index: i;
                    accessible-item-count: root.tabs.length;
                    accessible-action-default => { root.choose(tab.id); }

                    tab-ta := TouchArea {
                        clicked => { root.choose(tab.id); }
                    }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 10px;
                        if tab.icon != "": VerticalLayout {
                            alignment: center;
                            Icon {
                                path: Icons.named(tab.icon);
                                color: tab-row.on ? Theme.accent-text : tab-ta.has-hover ? Theme.text : Theme.text-2;
                            }
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: tab.label;
                            color: tab-row.on || tab-ta.has-hover ? Theme.text : Theme.text-2;
                            font-size: Theme.fs;
                            font-weight: tab-row.on ? Theme.weight-medium : Theme.weight-regular;
                            letter-spacing: Theme.tracking;
                            vertical-alignment: center;
                            overflow: elide;
                            accessible-role: none;
                        }
                    }
                    FocusRing {
                        inset: true;
                        radius: Theme.r;
                        shown: tab-row.on && ((fs.has-focus && root.keyboard) || root.shown == ShownState.focus);
                    }
                }
            }
        }
    }

    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: Theme.line;
    }
}
