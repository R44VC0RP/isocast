// Forms. Two kinds:
//
// The label column (Form, FormRow, FormSection, SubForm, Hint): labels
// right-aligned in 156px, 12px from the value; hints under their control,
// 168px in.
//
// Console's inspector (Final Cut's bands, Paper's sheets and docks):
// RowGroup with GroupRows (30px `control` rows 1px apart, the first and
// last with 6px corners, the label left in 12px `text-2`, its control on
// the right), titled by a GroupHeading (with an optional reset), captioned
// by a GroupHint; Band rows in docks (30px on `hover`, 14px in); an
// Inspector panel of bands; a QuickList (Studio Mode's transitions).

import { Theme, Motion } from "../theme.slint";
import { Icon, Icons } from "../icons.slint";
import { FocusRing, ShownState } from "focus.slint";
import { Tip } from "tooltip.slint";
import { IconButton } from "buttons.slint";

// A form's body: 16px top and bottom, 20px sides, rows 8px apart.
export component Form inherits VerticalLayout {
    padding-top: Theme.space-4;
    padding-bottom: Theme.space-4;
    padding-left: Theme.space-5;
    padding-right: Theme.space-5;
    spacing: Theme.space-2;
    alignment: start;
}

// A caption under a control: 12/16 in `text-3`, indented to the value
// column by default.
export component Hint inherits Rectangle {
    in property <string> text;
    in property <length> indent: Theme.hint-indent;
    in property <bool> live;
    in property <bool> warn;
    height: label.preferred-height;
    label := Text {
        x: root.indent;
        width: parent.width - root.indent;
        text: root.text;
        color: root.warn ? Theme.warning : root.live ? Theme.text-2 : Theme.text-3;
        font-size: Theme.fs-sm;
        letter-spacing: Theme.tracking-sm;
        line-height-factor: Theme.leading-sm;
        wrap: word-wrap;
    }
}

// One row: its label, then its controls (children, 8px apart) filling the
// value column, then an optional hint under them.
export component FormRow inherits VerticalLayout {
    in property <string> label;
    in property <string> hint;
    // The hint in `text-2` with figures (a live reading, like "Receiving
    // 1920×1080 at 60 fps"), or amber when it warns.
    in property <bool> hint-live;
    in property <bool> hint-warn;
    in property <length> label-width: Theme.label-col;
    // The label in the middle of a taller row (Crop beside its two lines),
    // not beside the first line.
    in property <bool> label-centered;
    // Dim the whole row (a locked form).
    in property <bool> enabled: true;

    spacing: Theme.space-1;
    alignment: start;

    HorizontalLayout {
        spacing: Theme.label-gap;
        opacity: root.enabled ? 1 : Theme.disabled-opacity;
        // One line sits in the middle of a 28px row; a long label wraps.
        // (The row's height is at least 28px from here: a `min-height` on
        // the row itself would replace its controls' own minimum, and a
        // short window would squeeze two lines of fields into one.)
        VerticalLayout {
            width: root.label-width;
            min-height: max(Theme.control-h, label-text.preferred-height + 6px);
            padding-top: root.label-centered ? 0px : 6px;
            alignment: root.label-centered ? LayoutAlignment.center : LayoutAlignment.start;
            label-text := Text {
                horizontal-alignment: right;
                text: root.label;
                color: Theme.text-2;
                font-size: Theme.fs-sm;
                letter-spacing: Theme.tracking-sm;
                line-height-factor: Theme.leading-sm;
                wrap: word-wrap;
                accessible-role: none;
            }
        }
        HorizontalLayout {
            spacing: Theme.space-2;
            alignment: stretch;
            @children
        }
    }
    if root.hint != "": Hint {
        text: root.hint;
        indent: root.label-width + Theme.label-gap;
        live: root.hint-live;
        warn: root.hint-warn;
    }
}

// A section title ("Appearance", "Recording"): 12px semibold in `text`,
// as a sheet's section headings (Paper's settings sheet), 8px above it.
export component FormSection inherits VerticalLayout {
    in property <string> title;
    padding-top: Theme.space-2;
    Text {
        text: root.title;
        color: Theme.text;
        font-size: Theme.fs-sm;
        letter-spacing: Theme.tracking-sm;
        font-weight: Theme.weight-semibold;
        vertical-alignment: center;
    }
}

// A 1px line between groups of rows, 8px above and below.
export component FormSeparator inherits VerticalLayout {
    padding-top: Theme.space-2;
    padding-bottom: Theme.space-2;
    Rectangle {
        height: 1px;
        background: Theme.line;
    }
}

// Settings that belong to the choice above them: 180px in, a hairline on
// their left, a narrower label column (120px).
export component SubForm inherits HorizontalLayout {
    padding-left: Theme.hint-indent;
    padding-top: Theme.space-2;
    Rectangle {
        width: 1px;
        background: Theme.line;
    }
    VerticalLayout {
        padding-left: Theme.space-3;
        spacing: Theme.space-2;
        horizontal-stretch: 1;
        @children
    }
}

export enum CalloutKind { error, info }

// A full-width band at the top of a form: an error (red tint) or a note
// (copper tint), with a title and a message.
export component Callout inherits Rectangle {
    in property <CalloutKind> kind: CalloutKind.error;
    in property <string> title;
    in property <string> message;
    background: root.kind == CalloutKind.error ? Theme.danger-soft : Theme.accent-soft;
    accessible-role: AccessibleRole.text;
    accessible-label: root.title;
    accessible-description: root.message;

    HorizontalLayout {
        padding-top: Theme.space-3;
        padding-bottom: Theme.space-3;
        padding-left: Theme.space-5;
        padding-right: Theme.space-5;
        spacing: Theme.space-3;
        VerticalLayout {
            alignment: start;
            Icon {
                path: root.kind == CalloutKind.error ? Icons.alert : Icons.info;
                color: root.kind == CalloutKind.error ? Theme.danger-text : Theme.accent-text;
            }
        }
        VerticalLayout {
            spacing: 2px;
            horizontal-stretch: 1;
            if root.title != "": Text {
                text: root.title;
                color: Theme.text;
                font-size: Theme.fs-sm;
                letter-spacing: Theme.tracking-sm;
                line-height-factor: Theme.leading-sm;
                font-weight: Theme.weight-semibold;
                wrap: word-wrap;
            }
            if root.message != "": Text {
                text: root.message;
                color: Theme.text-2;
                font-size: Theme.fs-sm;
                letter-spacing: Theme.tracking-sm;
                line-height-factor: Theme.leading-sm;
                wrap: word-wrap;
            }
        }
    }
}

// ---- Console's inspector: grouped rows, bands, the inspector panel.

// Where a GroupRow sits in its group: its corners follow (6px on the
// group's outer corners only).
export enum RowPlace { only, first, middle, last }

// Rows of one group, 1px apart (the sheet behind shows between them). 20px
// in from a sheet's edges is the caller's.
export component RowGroup inherits VerticalLayout {
    spacing: 1px;
    alignment: start;
}

// One grouped row (Paper's sheets: "Keep free", "Recording Quality"): 30px
// on `control`, its label 12px `text-2` 12px in, its controls (children)
// on the right `trailing-pad` from the edge (4px; 8px beside a switch).
// A `tall` row (a file list) grows with its controls, 4px above and 6px
// below them, its label on the first line. A `clickable` row is a button
// (a choice that leads on, like a streaming service): `control-hover`
// under the pointer, Space or Return when focused. `indent` moves the
// label in (an object's own settings under its switch).
export component GroupRow inherits Rectangle {
    in property <string> label;
    in property <RowPlace> place: RowPlace.middle;
    in property <length> trailing-pad: Theme.space-1;
    in property <bool> tall;
    in property <bool> enabled: true;
    in property <bool> clickable;
    in property <length> indent;
    // What screen readers hear about a clickable row, besides its label.
    in property <string> description;
    // A 12px `text-3` glyph before the label, 4px from it, the row 8px in
    // (Paper's "› Advanced" disclosure row); with `expandable`, a
    // clickable row says whether what it shows is `expanded`.
    in property <string> lead-icon;
    in property <bool> expandable;
    in property <bool> expanded;
    callback clicked();
    property <length> top-r: root.place == RowPlace.first || root.place == RowPlace.only ? Theme.r : 0px;
    property <length> bottom-r: root.place == RowPlace.last || root.place == RowPlace.only ? Theme.r : 0px;

    min-height: root.tall ? row.min-height : Theme.row;
    preferred-height: root.tall ? row.preferred-height : Theme.row;
    max-height: root.tall ? 100000px : Theme.row;
    background: Theme.control;
    border-top-left-radius: root.top-r;
    border-top-right-radius: root.top-r;
    border-bottom-left-radius: root.bottom-r;
    border-bottom-right-radius: root.bottom-r;
    accessible-role: none;

    // A clickable row: its hover fill, the pointer and the keyboard.
    if root.clickable: Rectangle {
        property <bool> keyboard;
        border-top-left-radius: root.top-r;
        border-top-right-radius: root.top-r;
        border-bottom-left-radius: root.bottom-r;
        border-bottom-right-radius: root.bottom-r;
        background: hit.has-hover && root.enabled ? Theme.control-hover : transparent;
        animate background { duration: Theme.fast; easing: Motion.ease; }
        accessible-role: button;
        accessible-label: root.label;
        accessible-description: root.description;
        accessible-enabled: root.enabled;
        accessible-expandable: root.expandable;
        accessible-expanded: root.expanded;
        accessible-action-default => {
            if root.enabled {
                root.clicked();
            }
        }
        accessible-action-expand => {
            if root.enabled && root.expandable {
                root.clicked();
            }
        }
        hit := TouchArea {
            enabled: root.enabled;
            clicked => { root.clicked(); }
        }
        keys := FocusScope {
            enabled: root.enabled;
            focus-on-click: false;
            focus-gained(reason) => { parent.keyboard = reason == FocusReason.tab-navigation; }
            focus-lost => { parent.keyboard = false; }
            key-pressed(event) => {
                if event.text == " " || event.text == "\n" {
                    root.clicked();
                    return accept;
                }
                reject
            }
        }
        FocusRing {
            inset: true;
            radius: max(root.top-r, root.bottom-r);
            shown: keys.has-focus && parent.keyboard;
        }
    }

    row := HorizontalLayout {
        padding-left: (root.lead-icon != "" ? Theme.space-2 : Theme.space-3) + root.indent;
        padding-right: root.trailing-pad;
        padding-top: root.tall ? Theme.space-1 : 0px;
        padding-bottom: root.tall ? 6px : 0px;
        spacing: Theme.space-3;
        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: Theme.space-1;
            if root.lead-icon != "": VerticalLayout {
                alignment: root.tall ? LayoutAlignment.start : LayoutAlignment.center;
                padding-top: root.tall ? 7px : 0px;
                Icon {
                    path: root.lead-icon;
                    size: Theme.icon-xs;
                    color: Theme.text-3;
                }
            }
            VerticalLayout {
                alignment: root.tall ? LayoutAlignment.start : LayoutAlignment.center;
                padding-top: root.tall ? 5px : 0px;
                horizontal-stretch: 1;
                Text {
                    text: root.label;
                    color: root.enabled ? Theme.text-2 : Theme.text-disabled;
                    font-size: Theme.fs-sm;
                    letter-spacing: Theme.tracking-sm;
                    height: Theme.lh-sm;
                    vertical-alignment: center;
                    overflow: elide;
                    accessible-role: none;
                }
            }
        }
        HorizontalLayout {
            alignment: end;
            spacing: Theme.space-1;
            @children
        }
    }
}

// A group's heading (32px): its title 12px semibold `text`, 2px in, and a
// reset glyph on the right (14px `text-3`, 4px in) when `resettable`.
export component GroupHeading inherits Rectangle {
    in property <string> title;
    in property <bool> resettable;
    // What screen readers and the tooltip call the reset.
    in property <string> reset-label: "Reset to defaults";
    callback reset();

    height: Theme.header;
    accessible-role: none;

    Text {
        x: 2px;
        width: parent.width - 2px - Theme.icon-button-xs - 4px;
        text: root.title;
        color: Theme.text;
        font-size: Theme.fs-sm;
        font-weight: Theme.weight-semibold;
        letter-spacing: Theme.tracking-sm;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: AccessibleRole.text;
    }
    // The kit's icon button (a Tab stop, Space and Return press it).
    if root.resettable: IconButton {
        x: parent.width - 4px - (self.width + Theme.icon-sm) / 2;
        y: (parent.height - self.height) / 2;
        compact: true;
        icon: Icons.reset;
        rest-color: Theme.text-3;
        label: root.reset-label;
        clicked => { root.reset(); }
    }
}

// The caption under a group: 11px `text-3`, 6px below it, 12px in.
export component GroupHint inherits Rectangle {
    in property <string> text;
    min-height: label.preferred-height + 6px;
    preferred-height: label.preferred-height + 6px;
    accessible-role: none;
    label := Text {
        x: Theme.space-3;
        y: 6px;
        width: parent.width - 2 * Theme.space-3;
        text: root.text;
        color: Theme.text-3;
        font-size: Theme.fs-xs;
        letter-spacing: Theme.tracking-xs;
        line-height-factor: Theme.leading-xs;
        wrap: word-wrap;
    }
}

// A band (Final Cut's inspector; the Transitions dock): 30px on `hover`,
// its label 12px `text-2` (`text-disabled` when not `enabled`) 14px in,
// its control (children) on the right, `trailing-pad` in (6px beside a
// popup or stepper, 10px beside a slider or switch).
export component Band inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    // Nothing to set yet (no setup): the whole band at 40%, label and
    // field as they are (Paper's Welcome board).
    in property <bool> dimmed;
    in property <length> trailing-pad: 6px;

    height: Theme.row;
    background: Theme.hover;
    opacity: root.dimmed ? Theme.disabled-opacity : 1;
    accessible-role: none;

    HorizontalLayout {
        padding-left: Theme.pane-x;
        padding-right: root.trailing-pad;
        spacing: Theme.space-3;
        // The label keeps its whole width: in a narrow band the field
        // gives way (down to its own minimum) before the words do.
        Text {
            min-width: self.preferred-width;
            horizontal-stretch: 1;
            text: root.label;
            color: root.enabled ? Theme.text-2 : Theme.text-disabled;
            font-size: Theme.fs-sm;
            letter-spacing: Theme.tracking-sm;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: none;
        }
        HorizontalLayout {
            alignment: end;
            spacing: Theme.space-3;
            @children
        }
    }
}

// The inspector panel (Final Cut's): `surface-panel` with a `line` edge; a
// 32px `surface-header` title band (12px semibold `text`, 14px in) with a
// reset button on its right; then its Bands, 1px apart.
export component Inspector inherits Rectangle {
    in property <string> title;
    in property <bool> resettable;
    in property <string> reset-label: "Reset";
    callback reset();

    background: Theme.surface-panel;
    border-width: 1px;
    border-color: Theme.line;
    min-height: column.min-height;
    preferred-height: column.preferred-height;
    accessible-role: groupbox;
    accessible-label: root.title;

    column := VerticalLayout {
        padding: 1px;
        spacing: 1px;
        Rectangle {
            height: Theme.header;
            background: Theme.surface-header;
            Text {
                x: Theme.pane-x;
                width: parent.width - Theme.pane-x - 10px - Theme.icon-button-xs;
                text: root.title;
                color: Theme.text;
                font-size: Theme.fs-sm;
                font-weight: Theme.weight-semibold;
                letter-spacing: Theme.tracking-sm;
                vertical-alignment: center;
                overflow: elide;
                accessible-role: AccessibleRole.text;
            }
            if root.resettable: Rectangle {
                x: parent.width - 10px - self.width;
                y: (parent.height - self.height) / 2;
                width: Theme.icon-button-xs;
                height: Theme.icon-button-xs;
                border-radius: Theme.r;
                background: inspector-reset.has-hover ? Theme.control-hover : transparent;
                accessible-role: button;
                accessible-label: root.reset-label;
                accessible-action-default => { root.reset(); }
                Icon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    path: Icons.reset;
                    size: 13px;
                    color: inspector-reset.has-hover ? Theme.text : Theme.text-3;
                }
                inspector-reset := TouchArea {
                    clicked => { root.reset(); }
                }
            }
        }
        @children
    }
}

// A short list of choices in a rounded box (Studio Mode's quick
// transitions): `surface-panel`, a `line-strong` edge, 8px corners; its
// QuickRows 28px, split by hairlines. One Tab stop: ↑ ↓ Home End move
// through its `count` rows (the `current` one wears the ring), Space or
// Return chooses it (`activated`). Disabled (`enabled` false) it fades
// and leaves the Tab order.
export component QuickList inherits Rectangle {
    in property <string> label;
    in property <int> count;
    in property <bool> enabled: true;
    in-out property <int> current;
    // The row with the keyboard: its rows show their ring for this.
    out property <bool> keyboard-focus: fs.has-focus && root.keyboard;
    callback activated(int);

    forward-focus: fs;
    property <bool> keyboard;

    background: Theme.surface-panel;
    border-width: 1px;
    border-color: Theme.line-strong;
    border-radius: Theme.r-menu;
    clip: true;
    opacity: root.enabled ? 1 : Theme.disabled-opacity;
    min-height: rows.min-height;
    preferred-height: rows.preferred-height;
    accessible-role: list;
    accessible-label: root.label;
    accessible-enabled: root.enabled;

    fs := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        focus-gained(reason) => { root.keyboard = reason == FocusReason.tab-navigation; }
        focus-lost => { root.keyboard = false; }
        key-pressed(event) => {
            if event.modifiers.meta || event.modifiers.control || event.modifiers.alt || root.count == 0 {
                return reject;
            }
            root.keyboard = true;
            if event.text == Key.UpArrow {
                root.current = max(0, root.current - 1);
                return accept;
            }
            if event.text == Key.DownArrow {
                root.current = min(root.count - 1, root.current + 1);
                return accept;
            }
            if event.text == Key.Home {
                root.current = 0;
                return accept;
            }
            if event.text == Key.End {
                root.current = root.count - 1;
                return accept;
            }
            if event.text == " " || event.text == "\n" {
                root.activated(max(0, min(root.count - 1, root.current)));
                return accept;
            }
            reject
        }
    }

    rows := VerticalLayout {
        padding: 1px;
        spacing: 0;
        @children
    }
}

// One row of a QuickList: its name (12px medium `text`, 10px in) and a
// detail on the right (10px Martian Mono Light `text-3`: "300 ms"); a
// hairline under it unless `last`; `hover` under the pointer, `selected`
// when chosen.
export component QuickRow inherits Rectangle {
    in property <string> text;
    in property <string> detail;
    in property <bool> last;
    in property <bool> selected;
    in property <int> index;
    in property <int> count;
    // Chosen by the keyboard in its QuickList: the ring inside the row.
    in property <bool> focus-shown;
    in property <bool> enabled: true;
    // Draw a state regardless of the pointer (the kit gallery).
    in property <ShownState> shown: ShownState.live;
    callback clicked();

    height: Theme.control-h;
    background: root.selected ? Theme.selected : (quick-ta.has-hover && root.enabled) || root.shown == ShownState.hover ? Theme.hover : transparent;
    accessible-role: list-item;
    accessible-label: root.text;
    accessible-item-selectable: true;
    accessible-item-selected: root.selected;
    accessible-item-index: root.index;
    accessible-item-count: root.count;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    quick-ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        height: parent.height - (root.last ? 0px : 1px);
        Text {
            horizontal-stretch: 1;
            text: root.text;
            color: Theme.text;
            font-size: Theme.fs-sm;
            font-weight: Theme.weight-medium;
            letter-spacing: Theme.tracking-sm;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: none;
        }
        if root.detail != "": Text {
            text: root.detail;
            color: Theme.text-3;
            font-family: Theme.font-mono;
            font-size: Theme.fs-micro;
            font-weight: Theme.weight-light;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
    if !root.last: Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.line;
    }
    FocusRing {
        inset: true;
        radius: 0px;
        shown: root.focus-shown || root.shown == ShownState.focus;
    }
}
