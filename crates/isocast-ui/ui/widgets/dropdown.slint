// A dropdown (Paper "Components" › Fields › Dropdown): a `control` field
// with the chosen option and a ⌃⌄ cap, and a list (the menu's panel) that
// keyboard and pointer both drive. `small` is the 22px one of rows and
// bands; `on-control` is the one on a grey grouped row (Paper's Settings
// sheet, Encoder): `control-active` with a 16px `control-hover` cap.
// Options carry a `detail`, shown dim after the label in the list (and in
// the field with `show-detail`): two devices with the same name are told
// apart by it (src/kit.rs `disambiguate` fills it in for duplicates).

import { Theme, Motion } from "../theme.slint";
import { Icon, Icons, SvgPath } from "../icons.slint";
import { MenuPanel } from "menus.slint";
import { FocusRing, ShownState } from "focus.slint";
import { Tip } from "tooltip.slint";

export struct DropdownOption {
    value: string,
    label: string,
    // Dim text after the label (a device's model, "2 of 2", a hint).
    detail: string,
    disabled: bool,
}

export component Dropdown inherits Rectangle {
    in property <[DropdownOption]> options;
    // The chosen option's value ("" for none).
    in-out property <string> value;
    in property <string> placeholder: "None";
    // What screen readers call it (the form label beside it).
    in property <string> label;
    in property <bool> enabled: true;
    // How far a disabled field fades (1 inside something that fades
    // whole, as a dimmed Band).
    in property <float> disabled-opacity: Theme.disabled-opacity;
    in property <bool> small;
    // On a `control` row (a sheet's grouped rows): `control-active`, 5px
    // corners, 3px in on the right, a 16×16 `control-hover` cap with 4px
    // corners (it implies `small`'s 22px height).
    in property <bool> on-control;
    // Show the chosen option's detail in the field too.
    in property <bool> show-detail;
    in property <string> tooltip;
    // Draw a state regardless of the pointer (the kit gallery).
    in property <ShownState> shown: ShownState.live;
    out property <bool> open: popup.is-open;
    out property <bool> has-focus: fs.has-focus;
    // The value chosen (only when it changes).
    callback selected(string);

    public function show-list() {
        if root.enabled && root.options.length > 0 {
            root.highlighted = max(0, root.current);
            popup.show();
        }
    }


    forward-focus: fs;
    property <bool> keyboard;
    property <int> highlighted: -1;
    // The chosen option's index, found by the options themselves.
    property <int> current: -1;
    property <int> rows: min(root.options.length, 14);
    property <bool> detail-shown: root.show-detail && root.current >= 0 && root.options[root.current].detail != "";

    function choose(index: int) {
        if index >= 0 && index < root.options.length && !root.options[index].disabled {
            popup.close();
            if root.options[index].value != root.value {
                root.value = root.options[index].value;
                root.selected(root.value);
            }
        }
    }

    function move-highlight(by: int) {
        root.highlighted = max(0, min(root.options.length - 1, root.highlighted + by));
    }

    height: root.small || root.on-control ? Theme.control-h-sm : Theme.control-h;
    min-width: 80px;
    preferred-width: Theme.field-m;
    accessible-role: combobox;
    accessible-label: root.label;
    accessible-value: root.current >= 0 ? root.options[root.current].label : root.placeholder;
    accessible-enabled: root.enabled;
    accessible-expandable: true;
    accessible-expanded: popup.is-open;
    accessible-action-default => { root.show-list(); }
    accessible-action-expand => { root.show-list(); }

    // Each option checks whether it is the chosen one.
    for option[i] in root.options: Rectangle {
        property <bool> chosen: option.value == root.value;
        width: 0;
        height: 0;
        visible: false;
        init => {
            if self.chosen {
                root.current = i;
            }
        }
        changed chosen => {
            if self.chosen {
                root.current = i;
            } else if root.current == i {
                root.current = -1;
            }
        }
    }

    // The field: a `control` fill (no edge), the chosen label, its detail
    // dim after it, and the ⌃⌄ cap on the right (16×18 on
    // `control-active`, 4px corners; 14×16 and 3px `small`).
    field := Rectangle {
        border-radius: root.small || root.on-control ? Theme.r-compact : Theme.r;
        background: root.on-control
            ? (popup.is-open || ta.pressed || root.shown == ShownState.pressed || ((ta.has-hover || root.shown == ShownState.hover) && root.enabled) ? Theme.field-border-hover : Theme.control-active)
            : popup.is-open || ta.pressed || root.shown == ShownState.pressed ? Theme.control-active : (ta.has-hover || root.shown == ShownState.hover) && root.enabled ? Theme.control-hover : Theme.control;
        opacity: root.enabled ? 1 : root.disabled-opacity;
        animate background { duration: Theme.fast; easing: Motion.ease; }

        HorizontalLayout {
            padding-left: 10px;
            padding-right: root.on-control ? 3px : root.small ? 4px : 6px;
            spacing: Theme.space-2;
            // The label takes the room, or its detail does when shown
            // (Paper: label, detail, cap 8px apart).
            Text {
                horizontal-stretch: root.detail-shown ? 0 : 1;
                text: root.current >= 0 ? root.options[root.current].label : root.placeholder;
                color: root.current >= 0 ? Theme.text : Theme.text-3;
                font-size: Theme.fs-sm;
                letter-spacing: Theme.tracking-sm;
                vertical-alignment: center;
                overflow: elide;
                accessible-role: none;
            }
            if root.detail-shown: Text {
                horizontal-stretch: 1;
                text: root.options[root.current].detail;
                color: Theme.text-3;
                font-size: Theme.fs-sm;
                letter-spacing: Theme.tracking-sm;
                vertical-alignment: center;
                overflow: elide;
                accessible-role: none;
            }
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: root.small && !root.on-control ? 14px : 16px;
                    height: root.on-control ? 16px : root.small ? 16px : 18px;
                    border-radius: root.small && !root.on-control ? Theme.r-cap : Theme.r-mini;
                    background: root.on-control ? Theme.control-hover : Theme.control-active;
                    SvgPath {
                        width: root.small && !root.on-control ? 8px : 10px;
                        height: root.small && !root.on-control ? 10px : 12px;
                        box-width: 10;
                        box-height: 12;
                        commands: "M2.5 4.5 5 2l2.5 2.5M2.5 7.5 5 10l2.5-2.5";
                        stroke: Theme.text;
                        // 1.5 units, at the small one's 0.8 scale.
                        stroke-width: root.small && !root.on-control ? 1.2px : 1.5px;
                        stroke-line-cap: round;
                        stroke-line-join: round;
                        fill: transparent;
                    }
                }
            }
        }

        FocusRing {
            shown: (fs.has-focus && root.keyboard) || root.shown == ShownState.focus;
            radius: field.border-radius;
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.show-list(); }
    }

    fs := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        focus-gained(reason) => { root.keyboard = reason == FocusReason.tab-navigation; }
        focus-lost => { root.keyboard = false; }
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" || event.text == Key.DownArrow || event.text == Key.UpArrow {
                root.show-list();
                return accept;
            }
            reject
        }
    }

    if root.tooltip != "": Tooltip {
        Tip { text: root.tooltip; }
    }

    // The widest choice (label and detail), so the list is as wide as it
    // needs (up to 420px) and choices like "ProRes 422 HQ" and "ProRes
    // 422 LT" can be told apart in a narrow form.
    Rectangle {
        width: 0;
        height: 0;
        clip: true;
        opacity: 0;
        accessible-role: none;
        widest := VerticalLayout {
            for option in root.options: HorizontalLayout {
                spacing: Theme.space-2;
                Text {
                    text: option.label;
                    font-size: Theme.fs;
                    letter-spacing: Theme.tracking;
                    accessible-role: none;
                }
                if option.detail != "": Text {
                    text: option.detail;
                    font-size: Theme.fs-sm;
                    letter-spacing: Theme.tracking-sm;
                    accessible-role: none;
                }
            }
        }
    }

    popup := PopupWindow {
        x: 0;
        y: root.height + 2px;
        // The row's check, paddings and gaps around the widest choice.
        width: max(root.width, 160px, min(420px, widest.preferred-width + Theme.icon + 3 * Theme.space-2 + Theme.space-3 + 2 * Theme.space-1 + 4px));
        height: root.rows * Theme.menu-item + 2 * Theme.space-1 + 2px;
        close-policy: close-on-click-outside;

        MenuPanel {
            accessible-role: list;
            accessible-label: root.label;

            list-keys := FocusScope {
                init => { self.focus(); }
                key-pressed(event) => {
                    if event.text == Key.DownArrow {
                        root.move-highlight(1);
                        if (root.highlighted + 1) * Theme.menu-item > -flick.content-y + flick.height {
                            flick.content-y = flick.height - (root.highlighted + 1) * Theme.menu-item;
                        }
                        return accept;
                    }
                    if event.text == Key.UpArrow {
                        root.move-highlight(-1);
                        if root.highlighted * Theme.menu-item < -flick.content-y {
                            flick.content-y = -root.highlighted * Theme.menu-item;
                        }
                        return accept;
                    }
                    if event.text == Key.Home {
                        root.highlighted = 0;
                        flick.content-y = 0;
                        return accept;
                    }
                    if event.text == Key.End {
                        root.highlighted = root.options.length - 1;
                        flick.content-y = min(0px, flick.height - root.options.length * Theme.menu-item);
                        return accept;
                    }
                    if event.text == "\n" || event.text == " " {
                        root.choose(root.highlighted);
                        return accept;
                    }
                    if event.text == Key.Escape || event.text == Key.Tab {
                        popup.close();
                        return accept;
                    }
                    reject
                }

                flick := Flickable {
                    x: Theme.space-1;
                    y: Theme.space-1;
                    width: parent.width - 2 * Theme.space-1;
                    height: parent.height - 2 * Theme.space-1;
                    content-height: root.options.length * Theme.menu-item;

                    for option[i] in root.options: Rectangle {
                        y: i * Theme.menu-item;
                        height: Theme.menu-item;
                        border-radius: Theme.r-compact;
                        background: i == root.highlighted && !option.disabled ? Theme.overlay-hover : transparent;
                        accessible-role: list-item;
                        accessible-label: option.detail != "" ? option.label + ", " + option.detail : option.label;
                        accessible-item-selectable: true;
                        accessible-item-selected: option.value == root.value;
                        accessible-item-index: i;
                        accessible-item-count: root.options.length;
                        accessible-enabled: !option.disabled;
                        accessible-action-default => { root.choose(i); }

                        HorizontalLayout {
                            padding-left: Theme.space-2;
                            padding-right: Theme.space-3;
                            spacing: Theme.space-2;
                            Rectangle {
                                width: Theme.icon;
                                if option.value == root.value: Icon {
                                    y: (parent.height - self.height) / 2;
                                    path: Icons.check;
                                    color: Theme.accent-text;
                                }
                            }
                            Text {
                                text: option.label;
                                color: option.disabled ? Theme.text-disabled : Theme.text;
                                font-size: Theme.fs;
                                letter-spacing: Theme.tracking;
                                vertical-alignment: center;
                                overflow: elide;
                                accessible-role: none;
                            }
                            if option.detail != "": Text {
                                text: option.detail;
                                color: option.disabled ? Theme.text-disabled : i == root.highlighted ? Theme.text-2 : Theme.text-3;
                                font-size: Theme.fs-sm;
                                letter-spacing: Theme.tracking-sm;
                                vertical-alignment: center;
                                overflow: elide;
                                accessible-role: none;
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                            }
                        }

                        TouchArea {
                            enabled: !option.disabled;
                            changed has-hover => {
                                if self.has-hover {
                                    root.highlighted = i;
                                }
                            }
                            clicked => { root.choose(i); }
                        }
                    }
                }
            }
        }
    }
}
