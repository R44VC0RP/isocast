// Toasts (Paper "Components" › Toasts): messages that stack at the top
// right, newest first, 360px wide: `surface-overlay`, a `line-strong` edge,
// 8px corners, the floating shadow, 12px in; a 16px status icon, a 13px
// semibold title, a 12px `text-2` message, quiet 22px actions and a 24px
// round ✕. They fade after a few seconds (errors and warnings 8 s), held
// while the pointer is over one (the app's src/toasts.rs keeps the list and
// the timers). A toast can carry an action ("Undo", "Details") and a small
// table of rows (dropped frames per file). A notice has a second action
// ("Don't show again"): both sit in a footer, the main one last, and it
// stays until dismissed.

import { Theme, Motion } from "../theme.slint";
import { Icon, Icons } from "../icons.slint";
import { Button, ButtonVariant, ControlSize, IconButton } from "buttons.slint";

export enum ToastKind { info, success, warning, error }

export struct ToastRow {
    label: string,
    value: string,
    // "", "bad" (red) or "warn" (amber) for the value.
    tone: string,
}

export struct ToastData {
    id: int,
    kind: ToastKind,
    title: string,
    message: string,
    // An action button's label, or "".
    action: string,
    rows: [ToastRow],
    // A second action's label, or "": a notice with a choice ("Don't
    // show again"), which stays until dismissed.
    action2: string,
}

export global Toasts {
    // Newest first.
    in-out property <[ToastData]> items;
    callback dismiss(int);
    callback action(int);
    callback action2(int);
    // The pointer went over toast `id` (true) or left it.
    callback hover(int, bool);
    // An open dialog shows them beside or under its sheet, so the
    // window's own stack (behind the dialog) stays hidden.
    in-out property <bool> shown-in-dialog;
    // Keep the toasts with this key out of sight ("" for none): the drops
    // toast while the REC or LIVE details show the same.
    callback hide-key(string);
}

export component Toast inherits Rectangle {
    in property <ToastData> toast;

    property <bool> shown;
    init => { root.shown = true; }
    // A title alone sits in the middle of the 24px line of its buttons;
    // with a message or rows, everything hangs from the top.
    property <bool> one-line: root.toast.message == "" && root.toast.rows.length == 0;

    width: Theme.toast-w;
    // The 1px edge, then 12px in (Paper's border-box).
    height: row.preferred-height + 2px;
    background: Theme.surface-overlay;
    border-width: 1px;
    border-color: Theme.line-strong;
    border-radius: Theme.r-menu;
    drop-shadow-color: Theme.shadow-color;
    drop-shadow-blur: Theme.shadow-blur;
    drop-shadow-offset-y: Theme.shadow-y;
    opacity: root.shown ? 1 : 0;
    animate opacity { duration: Theme.med; easing: Motion.ease; }
    accessible-role: AccessibleRole.text;
    accessible-label: root.toast.title;
    accessible-description: root.toast.message;

    // Over the toast (its buttons are inside): it stays while hovered.
    TouchArea {
        changed has-hover => { Toasts.hover(root.toast.id, self.has-hover); }

        row := VerticalLayout {
            x: 1px;
            y: 1px;
            width: parent.width - 2px;
            height: parent.height - 2px;
            padding: Theme.space-3;
            spacing: Theme.space-2;

            HorizontalLayout {
                spacing: Theme.space-2;

                VerticalLayout {
                    padding-top: root.one-line ? (Theme.icon-button-sm - Theme.icon) / 2 : (Theme.lh - Theme.icon) / 2;
                    alignment: start;
                    Icon {
                        path: root.toast.kind == ToastKind.error ? Icons.alert : root.toast.kind == ToastKind.warning ? Icons.warning : root.toast.kind == ToastKind.success ? Icons.check : Icons.info;
                        color: root.toast.kind == ToastKind.error ? Theme.danger-text : root.toast.kind == ToastKind.warning ? Theme.warning : root.toast.kind == ToastKind.success ? Theme.onair-text : Theme.text-2;
                    }
                }
                // The title, its message and the rows 2px apart (Paper).
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 2px;
                    alignment: start;
                    padding-top: root.one-line ? (Theme.icon-button-sm - Theme.lh) / 2 : 0px;
                    Text {
                        min-height: Theme.lh;
                        vertical-alignment: center;
                        text: root.toast.title;
                        color: Theme.text;
                        font-size: Theme.fs;
                        letter-spacing: Theme.tracking;
                        line-height-factor: Theme.leading;
                        font-weight: Theme.weight-semibold;
                        wrap: word-wrap;
                    }
                    if root.toast.message != "": Text {
                        min-height: Theme.lh-sm;
                        vertical-alignment: center;
                        text: root.toast.message;
                        color: Theme.text-2;
                        font-size: Theme.fs-sm;
                        letter-spacing: Theme.tracking-sm;
                        line-height-factor: Theme.leading-sm;
                        wrap: word-wrap;
                    }
                    if root.toast.rows.length > 0: VerticalLayout {
                        padding-top: Theme.space-1;
                        spacing: 0;
                        for r in root.toast.rows: HorizontalLayout {
                            spacing: Theme.space-3;
                            Text {
                                horizontal-stretch: 1;
                                height: Theme.lh-sm;
                                vertical-alignment: center;
                                text: r.label;
                                color: Theme.text-2;
                                font-size: Theme.fs-sm;
                                letter-spacing: Theme.tracking-sm;
                                overflow: elide;
                            }
                            Text {
                                height: Theme.lh-sm;
                                vertical-alignment: center;
                                text: r.value;
                                color: r.tone == "bad" ? Theme.danger-text : r.tone == "warn" ? Theme.warning : Theme.text-2;
                                font-size: Theme.fs-sm;
                                letter-spacing: Theme.tracking-sm;
                                horizontal-alignment: right;
                            }
                        }
                    }
                }
                // The action (22px) and the ✕ (24px) on a 24px line at the top,
                // 8px apart.
                VerticalLayout {
                    horizontal-stretch: 0;
                    alignment: start;
                    Rectangle {
                        width: actions.preferred-width;
                        height: Theme.icon-button-sm;
                        actions := HorizontalLayout {
                            x: 0;
                            y: 0;
                            width: self.preferred-width;
                            height: Theme.icon-button-sm;
                            spacing: Theme.space-2;
                            if root.toast.action != "" && root.toast.action2 == "": VerticalLayout {
                                alignment: center;
                                Button {
                                    text: root.toast.action;
                                    variant: ButtonVariant.quiet;
                                    size: ControlSize.small;
                                    inset: Theme.space-2;
                                    clicked => { Toasts.action(root.toast.id); }
                                }
                            }
                            IconButton {
                                small: true;
                                icon: Icons.x;
                                label: "Dismiss";
                                show-tooltip: false;
                                clicked => { Toasts.dismiss(root.toast.id); }
                            }
                        }
                    }
                }
            }
            // A notice's two actions in a footer, the main one last.
            if root.toast.action2 != "": HorizontalLayout {
                spacing: Theme.space-2;
                alignment: end;
                Button {
                    text: root.toast.action2;
                    variant: ButtonVariant.quiet;
                    size: ControlSize.small;
                    clicked => { Toasts.action2(root.toast.id); }
                }
                if root.toast.action != "": Button {
                    text: root.toast.action;
                    variant: ButtonVariant.secondary;
                    size: ControlSize.small;
                    clicked => { Toasts.action(root.toast.id); }
                }
            }
        }
    }
}

// The stack, top right with a 12px margin, 8px apart. Put it last in the
// window (and in a modal, which keeps it clear of the sheet).
export component ToastStack inherits Rectangle {
    in property <length> area-width;
    x: root.area-width - Theme.toast-w - Theme.space-3;
    y: Theme.space-3;
    width: Theme.toast-w;
    height: stack.preferred-height;
    accessible-role: none;

    stack := VerticalLayout {
        spacing: Theme.space-2;
        for toast in Toasts.items: Toast {
            toast: toast;
        }
    }
}
