// Keyboard focus (Paper "Components": `0 0 0 1px surface-panel, 0 0 0 3px
// focus-ring`): a pale-yellow ring 2px wide after a 1px gap, outside the
// control; or a 2px ring inside it for things as wide as their pane (rows,
// tabs, segments). Only keyboard focus shows a ring (Tab, or arrows moving
// between rows), never a click: widgets track that in a `keyboard`
// property set from `FocusScope.focus-gained`'s reason.

import { Theme } from "../theme.slint";

// A state to draw whatever the pointer and focus do: the kit gallery
// (`--state kit`) shows every control at rest, hovered, pressed and with
// keyboard focus side by side, as Paper's Components board does. The app
// leaves it `live`. Interactive kit components take it as `shown`.
export enum ShownState {
    // As the pointer and keyboard make it.
    live,
    hover,
    pressed,
    // Keyboard focus (a field: editing).
    focus,
}

// Put it last inside the control, so it draws on top. Hidden unless
// `shown`.
export component FocusRing inherits Rectangle {
    in property <bool> shown;
    in property <bool> inset;
    // The control's own corner radius (the ring follows it outside).
    in property <length> radius: Theme.r;
    // What shows in the 1px gap: the surface the control sits on.
    in property <color> gap: Theme.surface-panel;

    x: 0;
    y: 0;
    width: 100%;
    height: 100%;
    visible: root.shown;
    accessible-role: none;

    if root.inset: Rectangle {
        border-width: Theme.focus-width;
        border-color: Theme.focus-ring;
        border-radius: root.radius;
    }
    if !root.inset: Rectangle {
        x: -Theme.focus-gap;
        y: -Theme.focus-gap;
        width: parent.width + 2 * Theme.focus-gap;
        height: parent.height + 2 * Theme.focus-gap;
        border-width: Theme.focus-gap;
        border-color: root.gap;
        border-radius: root.radius + Theme.focus-gap;
    }
    if !root.inset: Rectangle {
        x: -Theme.focus-gap - Theme.focus-width;
        y: -Theme.focus-gap - Theme.focus-width;
        width: parent.width + 2 * (Theme.focus-gap + Theme.focus-width);
        height: parent.height + 2 * (Theme.focus-gap + Theme.focus-width);
        border-width: Theme.focus-width;
        border-color: Theme.focus-ring;
        border-radius: root.radius + Theme.focus-gap + Theme.focus-width;
    }
}
