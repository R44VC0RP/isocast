Name:           isocast
Version:        0.0.10
Release:        1%{?dist}
Summary:        Screen and camera recorder with per-source recording
License:        MIT OR Apache-2.0
URL:            https://github.com/anomalyco/isocast
Source0:        %{name}-%{version}.tar.gz

BuildRequires:  cargo rust gcc gcc-c++ make cmake nasm clang clang-devel perl-core
BuildRequires:  pkgconf-pkg-config openssl-devel fontconfig-devel freetype-devel
BuildRequires:  libxkbcommon-devel wayland-devel libX11-devel libXcursor-devel
BuildRequires:  libXrandr-devel libXi-devel libglvnd-devel pipewire-devel
BuildRequires:  gstreamer1-devel gstreamer1-plugins-base-devel webkitgtk6.0-devel gtk4-devel
# ELF dependencies are generated by RPM. These also cover runtime-loaded
# graphics libraries, media plugins and the browser helper's private display.
Requires:       pipewire-libs >= 1.0.5
Requires:       vulkan-loader libglvnd-egl libwayland-client libwayland-cursor libwayland-egl libX11 libXcursor libXrandr libXi
Requires:       libxkbcommon libxkbcommon-x11 gstreamer1-plugins-base gtk4 webkitgtk6.0
Recommends:     mesa-vulkan-drivers gstreamer1-plugins-good gstreamer1-plugin-libav
Recommends:     xdg-desktop-portal pipewire openh264 >= 2.6

%description
Isocast records a scene and its individual sources with one engine controlled
by a desktop app, CLI or MCP. H.264 software encoding needs real OpenH264
from fedora-cisco-openh264; Fedora's noopenh264 stub cannot encode.

%prep
%autosetup

%build
# The generated Slint module is large. Fedora's default -Ccodegen-units=1
# and full type debug info exhaust hosted builders; keep line tables and
# leave the rest of Fedora's hardening and package-note flags intact.
export RUSTFLAGS="${RUSTFLAGS:-} -Ccodegen-units=16 -Cdebuginfo=line-tables-only"
cargo build --locked --release -p isocast-media -p isocast-cli -p isocast-daemon -p isocast-ui -p isocast-browser

%install
install -Dm755 -t %{buildroot}%{_bindir} "${CARGO_TARGET_DIR:-target}"/release/isocast{,d,-ui,-browser,-media}
install -Dm644 -t %{buildroot}%{_datadir}/applications packaging/linux/dev.isocast.Isocast.desktop
mkdir -p %{buildroot}%{_datadir}/icons
cp -r packaging/linux/icons/hicolor %{buildroot}%{_datadir}/icons/

%files
%license LICENSE-MIT LICENSE-APACHE
%doc THIRD_PARTY_NOTICES packaging/linux/CISCO_H264_LICENSE.txt
%{_bindir}/isocast
%{_bindir}/isocastd
%{_bindir}/isocast-ui
%{_bindir}/isocast-browser
%{_bindir}/isocast-media
%{_datadir}/applications/dev.isocast.Isocast.desktop
%{_datadir}/icons/hicolor/*/apps/dev.isocast.Isocast.*
