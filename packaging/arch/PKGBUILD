# Git build, compatible with alerque's AUR isocast-git package.
pkgname=isocast-git
pkgver=0.0.10
pkgrel=1
pkgdesc='Screen and camera recorder that records every source as its own file'
arch=(x86_64)
url='https://github.com/anomalyco/isocast'
license=('MIT OR Apache-2.0')
provides=("isocast=$pkgver")
conflicts=(isocast)
depends=(alsa-lib fontconfig freetype2 gtk4 webkitgtk-6.0 openssl
         gstreamer gst-plugins-base gst-plugins-good gst-libav
         'openh264>=2.6' 'libopenh264.so=8-64' vulkan-icd-loader vulkan-driver
         libglvnd wayland libx11 libxcursor libxrandr libxi libxkbcommon libxkbcommon-x11)
makedepends=(cargo clang cmake git nasm ninja 'libpipewire>=1.0.5')
optdepends=('xdg-desktop-portal: interactive screen selection' 'libpipewire>=1.0.5: PipeWire capture and sound playback' 'pipewire: desktop audio and video capture')
options=(!lto !debug)
source=("git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd isocast
  local tag
  if tag=$(git describe --long --tags --abbrev=7 --match 'v[0-9]*'); then
    sed -E 's/^v//; s/-([0-9]+)-g/.r\1.g/' <<< "$tag"
  else
    # A snapshot without tags (e.g. CI).
    printf '%s.r%s.g%s' "$(sed -n '/^\[workspace.package\]/,/^\[/s/^version = "\(.*\)"/\1/p' Cargo.toml)" \
      "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
  fi
}

prepare() {
  cd isocast
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/^host: //p')"
}

build() {
  cd isocast
  cargo build --frozen --release -p isocast-media -p isocast-cli -p isocast-daemon -p isocast-ui -p isocast-browser
}

package() {
  cd isocast
  install -Dm755 -t "$pkgdir/usr/bin" "${CARGO_TARGET_DIR:-target}"/release/isocast{,d,-ui,-browser,-media}
  install -Dm644 -t "$pkgdir/usr/share/applications" packaging/linux/dev.isocast.Isocast.desktop
  mkdir -p "$pkgdir/usr/share/icons"
  cp -r packaging/linux/icons/hicolor "$pkgdir/usr/share/icons/"
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE-{APACHE,MIT}
  install -Dm644 -t "$pkgdir/usr/share/doc/isocast" THIRD_PARTY_NOTICES packaging/linux/CISCO_H264_LICENSE.txt
}
