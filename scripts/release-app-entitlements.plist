<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- macOS attributes camera and microphone access by the bundled engine
         (Contents/Helpers/Isocast Engine.app) to Isocast.app, so the app must
         carry these too; without them the hardened runtime denies the engine
         silently, with no prompt. The UI itself opens no devices. -->
    <key>com.apple.security.device.camera</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
