+// Only an exact `<LocalAppData>\Isocast-Update-<uuid>` path is ever a
+// cleanup candidate.
+bool IsStagingDirectory(const UpdateRoot& root, const std::wstring& dir)
+{
+    const std::wstring& prefix = root.prefix;
+    bool valid = dir.compare(0, prefix.size(), prefix) == 0 && dir.size() == prefix.size() + 36;
+    for (size_t i = 0; valid && i < 36; ++i)
+    {
+        const wchar_t c = dir[prefix.size() + i];
+        valid = (i == 8 || i == 13 || i == 18 || i == 23) ? c == L'-' :
+            ((c >= L'0' && c <= L'9') || (c >= L'a' && c <= L'f') || (c >= L'A' && c <= L'F'));
+    }
+    return valid;
+}
+
+// Re-check the private staging lease, delete only the fixed payload name
+// through its own handle, then remove the directory only if it is empty. An
+// active download or running installer holds its files without delete
+// sharing, so it is skipped. Throws for unsafe directories: never targets.
+bool RemoveStagingDirectory(const UpdateRoot& root, const std::wstring& dir)
+{
+    {
+        CheckedDirectory directory(dir, root.security, false, true);
+        // Open the fixed payload without following a final link. Mark that
+        // same file for deletion while both directory leases hold.
+        HANDLE file = CreateFileW((dir + L"\\Isocast-update.exe").c_str(),
+            DELETE | FILE_READ_ATTRIBUTES, FILE_SHARE_READ, NULL, OPEN_EXISTING,
+            FILE_FLAG_OPEN_REPARSE_POINT, NULL);
+        if (file != INVALID_HANDLE_VALUE)
+        {
+            BY_HANDLE_FILE_INFORMATION info;
+            if (GetFileInformationByHandle(file, &info) &&
+                !(info.dwFileAttributes & (FILE_ATTRIBUTE_REPARSE_POINT | FILE_ATTRIBUTE_DIRECTORY)))
+            {
+                FILE_DISPOSITION_INFO disposition = { TRUE };
+                SetFileInformationByHandle(file, FileDispositionInfo, &disposition, sizeof(disposition));
+            }
+            CloseHandle(file);
+        }
+    }
+    // Release only the child lease for empty-directory removal. The checked
+    // LocalAppData parent remains pinned and excludes other users' writers.
+    return RemoveDirectoryW(dir.c_str()) != 0;
+}
