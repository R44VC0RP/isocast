+// A remote name is advisory, never a filesystem path. Keep an intentionally
+// small ASCII .exe vocabulary; reject Windows path/stream/device aliases,
+// encoded names and ambiguous trailing characters before opening anything.
+bool SafeRemoteFilename(const std::wstring& name)
+{
+    if (name.size() < 5 || name.size() > 128 || name[0] == L'.' ||
+        name.find(L"..") != std::wstring::npos)
+        return false;
+    std::wstring lower;
+    for (wchar_t c : name)
+    {
+        if (!((c >= L'a' && c <= L'z') || (c >= L'A' && c <= L'Z') ||
+              (c >= L'0' && c <= L'9') || c == L'.' || c == L'-' || c == L'_'))
+            return false;
+        lower += (c >= L'A' && c <= L'Z') ? c + (L'a' - L'A') : c;
+    }
+    if (lower.substr(lower.size() - 4) != L".exe")
+        return false;
+    const std::wstring stem = lower.substr(0, lower.find(L'.'));
+    if (stem == L"con" || stem == L"prn" || stem == L"aux" || stem == L"nul")
+        return false;
+    if (stem.size() == 4 && (stem.substr(0, 3) == L"com" || stem.substr(0, 3) == L"lpt") &&
+        stem[3] >= L'1' && stem[3] <= L'9')
+        return false;
+    return true;
+}
