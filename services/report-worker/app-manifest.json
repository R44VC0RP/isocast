{
  "name": "Isocast Bug Reports",
  "url": "https://github.com/anomalyco/isocast",
  "description": "Files bug reports sent from the Isocast app as issues on anomalyco/isocast.",
  "public": false,
  "hook_attributes": {
    "url": "https://github.com/anomalyco/isocast",
    "active": false
  },
  "redirect_url": "http://127.0.0.1:3999/callback",
  "default_permissions": {
    "issues": "write",
    "metadata": "read"
  },
  "default_events": []
}
